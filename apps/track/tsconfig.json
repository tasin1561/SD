{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@skydrop/ui": ["../../packages/ui/src/index.ts"],
      "@skydrop/ui/tokens": ["../../packages/ui/src/tokens/index.ts"],
      "@skydrop/ui/status": ["../../packages/ui/src/status/index.ts"],
      "@skydrop/ui/components": ["../../packages/ui/src/components/index.ts"]
    },
    "allowJs": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".turbo"]
}
