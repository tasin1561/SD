# =============================================================================
# Skydrop API — environment variables
# Copy to .env and fill in the values. Never commit .env.
# =============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Interface to bind. Loopback by default — Caddy and the Next proxies are
# the only callers and they run on the same host. Set 0.0.0.0 only if the
# API is containerised and must answer from outside its namespace.
BIND_HOST=127.0.0.1
LOG_LEVEL=info

# --- Datastores -------------------------------------------------------------
# Match the docker-compose defaults for local dev.
DATABASE_URL=postgresql://skydrop:skydrop@127.0.0.1:5432/skydrop?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- Auth -------------------------------------------------------------------
# 256-bit secret. Generate with: openssl rand -base64 64
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars

# --- Email (Resend) ---------------------------------------------------------
# Leave blank in dev to log emails to stdout instead of sending.
RESEND_API_KEY=

# --- Frontend URLs (used in email links + CORS) -----------------------------
SELLER_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
# Module 11: base URL of the customer-facing tracking page (the
# future apps/track SSR). Customer notification templates render
# {{ tracking_url }} as `${PUBLIC_TRACKING_URL}/${awb}`.
PUBLIC_TRACKING_URL=https://track.skydrop.online

# --- Support contact (used as a variable in transactional emails) ----------
# Defaults to support@skydrop.online if unset.
SUPPORT_EMAIL=support@skydrop.online

# --- Cookies ----------------------------------------------------------------
# Leave undefined for __Host- prefix cookies (recommended). Set only if you
# need a non-Host cookie scope (e.g., shared subdomain auth).
# COOKIE_DOMAIN=

# --- DigitalOcean Spaces (object storage for catalog images + CSV) ----------
# In local dev / tests, set DEV_MOCK_SPACES=true to skip real DO creds:
# files go to /tmp/skydrop-spaces-mock/ and presigned URLs are stubbed.
DEV_MOCK_SPACES=true
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=skydrop-storage
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_CDN_URL=https://skydrop-storage.sgp1.cdn.digitaloceanspaces.com

# --- Catalog limits ---------------------------------------------------------
IMAGE_MAX_SIZE_BYTES=10485760
CSV_MAX_ROWS=1000
CSV_PRESIGN_TTL_SECONDS=900
