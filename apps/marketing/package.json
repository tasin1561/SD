{
  "name": "@skydrop/marketing",
  "version": "0.0.0",
  "private": true,
  "description": "Skydrop public marketing site — skydrop.online — Bangladeshi sellers shipping into India.",
  "scripts": {
    "dev": "MARKETING_DEV_ROUTES=1 next dev -p 3006",
    "build": "next build",
    "postbuild": "node scripts/critical-css.mjs && node scripts/check-theme.mjs && node scripts/check-micro-size.mjs && node scripts/check-bundle.mjs",
    "build:preview": "MARKETING_DEV_ROUTES=1 NEXT_PUBLIC_PLACEHOLDER_RIBBON=1 next build",
    "start": "node ../../scripts/serve-static.mjs out 3006",
    "serve": "node ../../scripts/serve-static.mjs out 3006",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "clean": "rm -rf .next out .turbo dist *.tsbuildinfo",
    "check:micro": "node scripts/check-micro-size.mjs"
  },
  "dependencies": {
    "@skydrop/ui": "workspace:*",
    "clsx": "^2.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/bundle-analyzer": "^15.5.25",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
