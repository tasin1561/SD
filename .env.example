# ============================================================
# Skydrop — Example environment file
# ============================================================
# Copy to `.env` for local dev. NEVER commit .env (it's in .gitignore).
# Production overrides live in DigitalOcean Project env + 1Password backup.

# ----- Runtime -----
NODE_ENV=development

# ----- Database -----
# Local Docker Postgres (see docker/docker-compose.yml). User/pass/db are all `skydrop`.
DATABASE_URL=postgresql://skydrop:skydrop@localhost:5432/skydrop?schema=public

# ----- Redis / BullMQ -----
# Local Docker Redis. No auth, no persistence.
REDIS_URL=redis://localhost:6379

# ============================================================
# Below: placeholders for variables we'll need as modules land.
# Uncomment + fill as each module is built. Production values
# come from the DigitalOcean Project env, never from this file.
# ============================================================

# ----- Auth (Phase 1A — auth module) -----
# JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
# JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# ----- DigitalOcean Spaces (S3-compatible) -----
# SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
# SPACES_REGION=sgp1
# SPACES_BUCKET=skydrop-storage
# SPACES_ACCESS_KEY=
# SPACES_SECRET_KEY=

# ----- Email (provider TBD — Resend or Postmark) -----
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@skydrop.global

# ----- SMS (Twilio) -----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ----- Delhivery -----
# DELHIVERY_API_BASE=https://track.delhivery.com
# DELHIVERY_API_TOKEN=
# DELHIVERY_WEBHOOK_SECRET=

# ----- Monitoring -----
# SENTRY_DSN=

# ----- App URLs (emails, invitation + reset links, CORS) -----
# These are the names the API actually reads — see
# apps/api/src/config/env.schema.ts. The five commented-out names that
# used to sit here (MARKETING_URL / SELLER_URL / ADMIN_URL / TRACK_URL /
# API_URL) were read by nothing, and all five real names were absent, so
# a fresh clone that followed this file could not boot. That matters
# beyond the inconvenience: this file is the only written record of which
# variable carries which console, and it is the mechanism by which a
# retired hostname finds its way back into production.
#
# SELLER_APP_URL and ADMIN_APP_URL are REQUIRED and have no default — the
# API refuses to start without them, so they are live here rather than
# commented.
SELLER_APP_URL=http://localhost:3003
ADMIN_APP_URL=http://localhost:3002
# The rest default to their production hosts when unset. Uncomment to
# point invitation, reset and verification links at a local console.
# RESELLER_APP_URL=http://localhost:3005
# ASSOCIATE_APP_URL=http://localhost:3007
# PUBLIC_TRACKING_URL=http://localhost:3004
#
# Production (CON-1, 2026-10-13 — the OLD console names still serve, so
# nothing here needs them):
#   SELLER_APP_URL=https://client.skydrop.global
#   ADMIN_APP_URL=https://admin.skydrop.global
#   RESELLER_APP_URL=https://member.skydrop.global
#   ASSOCIATE_APP_URL=https://associate.skydrop.global
#   PUBLIC_TRACKING_URL=https://track.skydrop.global
