# ============================================================
# Skydrop — .gitignore
# ============================================================

# ----- Dependencies -----
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ----- pnpm -----
.pnpm-store/
.pnpm-debug.log*

# ----- Build outputs -----
dist/
build/
out/
.next/
.turbo/
.vercel/
.nest/
*.tsbuildinfo
next-env.d.ts

# ----- Environment / secrets ----- (CRITICAL — never commit)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
*.pem
*.key
*.crt
secrets/

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Runtime data -----
pids/
*.pid
*.seed
*.pid.lock

# ----- Test coverage -----
coverage/
.nyc_output/
*.lcov

# ----- Playwright (M13 CP1.7) -----
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ----- IDE / editor -----
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- OS -----
.DS_Store
Desktop.ini
$RECYCLE.BIN/

# ----- Database -----
*.sqlite
*.sqlite3
*.db
prisma/migrations/dev.db*

# ----- Uploads / generated -----
uploads/
public/uploads/
storybook-static/

# ----- Docker -----
.docker/
docker-compose.override.yml

# ----- Misc -----
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tgz
.npm/
.tmp/
tmp/

# ----- Claude Code -----
.claude/

# ----- Local dev artifacts -----
*.local
/test.png
/screenshots/
.playwright-artifacts/
__pycache__/

# Browser-session artifacts from the Playwright MCP server (page snapshots,
# console logs, screenshots). Written into the repo root by a live browsing
# session, unformatted, and they would fail the format gate on the next
# commit while telling nobody anything.
.playwright-mcp/
.last-deployed-sha
