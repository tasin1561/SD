{
  "name": "@skydrop/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Skydrop shared design tokens — semantic status colors + type scale + spacing + radii. Tokens ONLY; components live in apps/admin until apps/seller forces extraction (per FE-6).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/tokens.css",
    "./src/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "default": "./dist/status/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@skydrop/db": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
