{
  "name": "@skydrop/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Skydrop shared design tokens + React component primitives. Tokens (FE-6, semantic status colors + type/spacing/radii) on ./tokens and ./status subpaths. Components (Button/Card/DataTable/Form/Modal/Page/StatusBadge — extracted M13 CP1 once apps/seller forced the shape) on ./components.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/brand/*.css",
    "./src/brand/*.css",
    "./dist/app/**/*.css",
    "./src/app/**/*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "default": "./dist/status/index.js"
    },
    "./status/public-tracking": {
      "types": "./dist/status/public-tracking.d.ts",
      "default": "./dist/status/public-tracking.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./brand/scales.css": "./dist/brand/scales.css",
    "./brand/theme.css": "./dist/brand/theme.css",
    "./brand/app.css": "./dist/brand/app.css",
    "./brand/legacy.css": "./dist/brand/legacy.css",
    "./app/*": {
      "types": "./dist/app/*/index.d.ts",
      "default": "./dist/app/*/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "check:brand": "node scripts/check-brand-tokens.mjs",
    "check:contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@skydrop/db": "workspace:*",
    "clsx": "^2.1.0",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
