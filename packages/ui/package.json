{
  "name": "@skydrop/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Skydrop shared design tokens + React component primitives. Tokens (FE-6, semantic status colors + type/spacing/radii) on ./tokens and ./status subpaths. Components (Button/Card/DataTable/Form/Modal/Page/StatusBadge — extracted M13 CP1 once apps/seller forced the shape) on ./components.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/tokens.css",
    "./src/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "default": "./dist/status/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@skydrop/db": "workspace:*",
    "clsx": "^2.1.0",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
