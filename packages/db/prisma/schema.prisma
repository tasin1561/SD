  pickedBatch   StockBatch?   @relation(fields: [pickedBatchId], references: [id])
  pickedBin     WarehouseBin? @relation(fields: [pickedBinId], references: [id])
  rtoDisposedBy StaffUser?    @relation("ShipmentItemRtoDisposedBy", fields: [rtoDisposedByStaffId], references: [id])
  tickets       Ticket[]
  stockUnits    StockUnit[]

  @@index([shipmentId])
  @@index([orderItemId])
  @@index([pickedBatchId])
  @@index([pickedBinId])
  @@index([rtoDisposedByStaffId])
  @@map("shipment_items")
}

// Module 8 — warehouse dispatch manifest. A per-courier grouping of
// PACKED shipments closed on-demand by a WAREHOUSE_SUPERVISOR (WMS-6);
// closure enqueues the M9 AWB batch job. A shipment belongs to ≤1
// manifest at a time (movable between DRAFT manifests pre-close, WMS-7)
// via the nullable Shipment.manifestId. ManifestStatus lifecycle
// (Module 9): DRAFT → CLOSED → CONFIRMED → DISPATCHED, with a FAILED
// branch when the whole AWB batch fails.
model Manifest {
  id                        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  manifestNumber            String         @unique @map("manifest_number")
  courierCode               String         @map("courier_code")
  originWarehouseId         String         @map("origin_warehouse_id") @db.Uuid
  status                    ManifestStatus @default(DRAFT)
  closedByStaffId           String?        @map("closed_by_staff_id") @db.Uuid
  closedAt                  DateTime?      @map("closed_at") @db.Timestamptz
  // Module 9 — AWB batch job lifecycle. `awbJobEnqueuedAt` renamed from
  // M8's unused `awb_batch_enqueued_at` (M8 close only emitted a stub
  // audit, never wrote the column). `awbJobCompletedAt` set when the
  // per-manifest BullMQ job finishes (some shipments may still have
  // failed — see per-shipment isolation, CUR-2).
  awbJobEnqueuedAt          DateTime?      @map("awb_job_enqueued_at") @db.Timestamptz
  awbJobCompletedAt         DateTime?      @map("awb_job_completed_at") @db.Timestamptz
  // Module 9 — per-manifest dispatch handoff (CUR-4, supervisor-confirmed).
  handoffConfirmedAt        DateTime?      @map("handoff_confirmed_at") @db.Timestamptz
  handoffConfirmedByStaffId String?        @map("handoff_confirmed_by_staff_id") @db.Uuid
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  courier            Courier    @relation(fields: [courierCode], references: [code])
  originWarehouse    Warehouse  @relation(fields: [originWarehouseId], references: [id])
  closedByStaff      StaffUser? @relation("ManifestClosedBy", fields: [closedByStaffId], references: [id])
  handoffConfirmedBy StaffUser? @relation("ManifestHandoffConfirmedBy", fields: [handoffConfirmedByStaffId], references: [id])
  shipments          Shipment[]

  @@index([courierCode, status])
  @@index([originWarehouseId])
  @@index([status, createdAt])
  @@index([closedByStaffId])
  @@index([handoffConfirmedByStaffId])
  @@map("manifests")
}

model AwbLabel {
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId         String                @map("shipment_id") @db.Uuid
  version            Int                   @default(1)
  isCurrent          Boolean               @default(true) @map("is_current")
  spacesKey          String                @map("spaces_key")
  spacesBucket       String                @default("skydrop-storage") @map("spaces_bucket")
  url                String?
  fileSizeBytes      Int?                  @map("file_size_bytes")
  mimeType           String                @default("application/pdf") @map("mime_type")
  paperSize          LabelPaperSize        @default(A4) @map("paper_size")
  format             String?
  generatedAt        DateTime              @default(now()) @map("generated_at") @db.Timestamptz
  generatedByStaffId String?               @map("generated_by_staff_id") @db.Uuid
  generatedReason    LabelGenerationReason @default(INITIAL) @map("generated_reason")
  printedCount       Int                   @default(0) @map("printed_count")
  lastPrintedAt      DateTime?             @map("last_printed_at") @db.Timestamptz
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz

