model SellerNote {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId  String             @map("seller_id") @db.Uuid
  authorId  String             @map("author_id") @db.Uuid
  content   String             @db.Text
  category  SellerNoteCategory @default(GENERAL)
  isPinned  Boolean            @default(false) @map("is_pinned")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz

  seller Seller    @relation(fields: [sellerId], references: [id])
  author StaffUser @relation("SellerNoteAuthor", fields: [authorId], references: [id])

  @@index([sellerId])
  @@index([authorId])
  @@index([category])
  @@index([deletedAt])
  @@map("seller_notes")
}

model AuditLog {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id") @db.Uuid
  staffUserId String?   @map("staff_user_id") @db.Uuid
  sellerId    String?   @map("seller_id") @db.Uuid
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  changes     Json?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  staffUser StaffUser? @relation("AuditLogStaff", fields: [staffUserId], references: [id])
  seller    Seller?    @relation("AuditLogSeller", fields: [sellerId], references: [id])

  @@index([actorType, actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([staffUserId])
  @@index([sellerId])
  @@map("audit_logs")
}

// ============================================================
// Layer 2 — Addresses & Locations (5 tables)
// ============================================================

// Polymorphic — owner is one of seller / warehouse / order / return_hub.
// Service layer enforces the (ownerType, ownerId) pairing; no FK in DB.
model Address {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerType     AddressOwnerType @map("owner_type")
  ownerId       String           @map("owner_id") @db.Uuid
  label         String?
  contactName   String?          @map("contact_name")
  contactPhone  String?          @map("contact_phone")
  contactEmail  String?          @map("contact_email")
  line1         String
  line2         String?
  landmark      String?
  city          String
  stateProvince String           @map("state_province")
  postalCode    String           @map("postal_code")
  countryCode   String           @map("country_code") @db.Char(2)
  latitude      Decimal?         @db.Decimal(10, 7)
  longitude     Decimal?         @db.Decimal(10, 7)
  type          AddressType
  isDefault     Boolean          @default(false) @map("is_default")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz

  @@index([ownerType, ownerId])
  @@index([countryCode, postalCode])
  @@index([deletedAt])
  @@map("addresses")
}

model Warehouse {
  id                 String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code               String          @unique
  name               String
  status             WarehouseStatus @default(ACTIVE)
  countryCode        String          @default("IN") @map("country_code") @db.Char(2)
  timezone           String          @default("Asia/Kolkata")
  /// Can customer orders ship FROM this building? Our Bangladesh intake
  /// warehouse holds real stock that is on its way to India and is not
  /// sellable from there. Read in exactly ONE place
  /// (WarehouseResolverService) — five call sites each testing
  /// `countryCode == 'IN'` is how they come to disagree.
  fulfilsOrders      Boolean         @default(true) @map("fulfils_orders")
  /// Does this building track WHERE stock sits? Per-warehouse on purpose:
  /// a mature site can run binned while a newly-opened one does not.
  /// OFF means every putaway resolves to the warehouse's FLOOR bin —
  /// `stock_levels.bin_id` is NOT NULL, so "no bin" is not representable
  /// and the off state is one real bin rather than a null.
  binTrackingEnabled Boolean         @default(false) @map("bin_tracking_enabled")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz

  zones                  WarehouseZone[]
  bins                   WarehouseBin[]
  binLayoutSnapshots     BinLayoutSnapshot[]
  binCollapseChallenges  BinCollapseChallenge[]
  stockBatches           StockBatch[]
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  stockReservations      StockReservation[]
  stockAdjustments       StockAdjustment[]
  cycleCounts            CycleCount[]
  goodsReceipts          GoodsReceipt[]
  shipmentsAsOrigin      Shipment[]
  // R6: RTO parcels physically RECEIVED here (may differ from the
  // warehouse the shipment originally dispatched from).
  shipmentsAsRtoReceived Shipment[]             @relation("ShipmentRtoReceivedWarehouse")
  stockAlertStates       StockAlertState[]
  manifests              Manifest[]
  stockUnits             StockUnit[]
  pickupRequests         CourierPickupRequest[]

  @@index([status])
  @@map("warehouses")
}

/// The email challenge that stands between an operator and a collapse.
///
/// A collapse merges every bin in a warehouse into FLOOR. It is the one
/// action here that destroys information rather than moving goods, and
/// it cannot be undone from the bins themselves — only from the snapshot
/// taken alongside it. So it is gated the way god-mode is (typed
/// confirmation, long reason, CRITICAL audit) plus a code sent to the
/// actor's own mailbox, which is the part that survives a shoulder-surfed
/// session.
model BinCollapseChallenge {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  /// Hashed, never stored in the clear — same discipline as every other
  /// token table here.
  codeHash    String    @map("code_hash")
  reason      String    @db.Text
  attempts    Int       @default(0)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  staffUser StaffUser @relation("BinCollapseChallengeStaff", fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([expiresAt])
  @@map("bin_collapse_challenges")
}

/// A point-in-time record of where every unit sat in one warehouse.
///
/// Taken BEFORE a collapse-to-FLOOR, which is destructive: it merges
/// every bin's contents into one and the original placement is not
/// otherwise recoverable. Snapshot-first is the same visible-vs-silent
/// ordering the rest of the codebase uses — a crash mid-collapse leaves
/// a usable backup rather than a half-collapsed warehouse with no record
/// of what it was.
///
/// Also answers "what was where on 12 August" on its own.
model BinLayoutSnapshot {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  reason         String    @db.Text
  takenByStaffId String    @map("taken_by_staff_id") @db.Uuid
  /// Set when this snapshot was restored FROM. A restore is best-effort
  /// per line (stock sells and moves in the meantime), so this records
  /// that it was attempted, not that it was total.
  restoredAt     DateTime? @map("restored_at") @db.Timestamptz
  lineCount      Int       @default(0) @map("line_count")
  totalQty       Int       @default(0) @map("total_qty")
  /// Swept by the retention cron — `ops.bin_snapshot_retention_months`.
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  warehouse Warehouse               @relation(fields: [warehouseId], references: [id])
  takenBy   StaffUser               @relation("BinSnapshotTakenBy", fields: [takenByStaffId], references: [id])
  lines     BinLayoutSnapshotLine[]

  @@index([warehouseId, createdAt])
  @@index([expiresAt])
  @@map("bin_layout_snapshots")
}

/// One (seller, variant, bin, batch, qty) row as it stood. Bare scalar
/// UUIDs, not relations: a snapshot is a historical fact and must
/// survive a bin being deleted after the collapse that emptied it.
model BinLayoutSnapshotLine {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  snapshotId String   @map("snapshot_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  binId      String   @map("bin_id") @db.Uuid
  binCode    String   @map("bin_code")
  batchId    String   @map("batch_id") @db.Uuid
  qtyOnHand  Int      @map("qty_on_hand")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  snapshot BinLayoutSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("bin_layout_snapshot_lines")
}

model WarehouseZone {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  code        String
  name        String
  pickOrder   Int       @default(100) @map("pick_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  bins        WarehouseBin[]
  cycleCounts CycleCount[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([deletedAt])
  @@map("warehouse_zones")
}

model WarehouseBin {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId  String    @map("warehouse_id") @db.Uuid
  zoneId       String    @map("zone_id") @db.Uuid
  code         String
  /// Grid coordinates. `code` is composed from these deterministically
  /// (A + 01 + 03 -> "A-01-03") so the same shelf can never be entered
  /// two ways. FLOOR — the bin used when tracking is off — is the one
  /// bin with no coordinates.
  aisle        String?
  rack         String?
  shelf        String?
  type         BinType
  maxWeightKg  Decimal?  @map("max_weight_kg") @db.Decimal(10, 2)
  maxVolumeCm3 Decimal?  @map("max_volume_cm3") @db.Decimal(12, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  warehouse          Warehouse          @relation(fields: [warehouseId], references: [id])
  zone               WarehouseZone      @relation(fields: [zoneId], references: [id])
  stockLevels        StockLevel[]
  stockReservations  StockReservation[]
  movementsAsBin     StockMovement[]    @relation("StockMovementBin")
  movementsAsFromBin StockMovement[]    @relation("StockMovementFromBin")
  movementsAsToBin   StockMovement[]    @relation("StockMovementToBin")
  cycleCountItems    CycleCountItem[]
  goodsReceiptLines  GoodsReceiptLine[]
  orderItems         OrderItem[]
  shipmentItems      ShipmentItem[]
  stockUnits         StockUnit[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([zoneId])
  @@index([aisle])
  @@index([type])
  @@index([deletedAt])
  @@map("warehouse_bins")
}

// Natural PK on the pincode itself (reference data, hard overwrite, no soft delete).
model PinCode {
  pinCode        String        @id @map("pin_code") @db.VarChar(10)
  countryCode    String        @default("IN") @map("country_code") @db.Char(2)
  city           String?
  district       String?
  stateProvince  String?       @map("state_province")
  region         String?
  zone           String?
  serviceArea    ServiceArea?  @map("service_area")
  serviceability Json?
  source         PinCodeSource @default(USER_ENTERED)
  lastVerifiedAt DateTime?     @map("last_verified_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([countryCode])
  @@index([city])
  @@index([stateProvince])
  @@index([zone])
  @@index([lastVerifiedAt])
  @@map("pin_codes")
}

// ============================================================
// Layer 3 — Catalog (5 tables)
// ============================================================

model Product {
  id                      String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId                String        @map("seller_id") @db.Uuid
  name                    String
  description             String?       @db.Text
  externalRef             String?       @map("external_ref")
  defaultWeightGrams      Int?          @map("default_weight_grams")
  defaultLengthCm         Decimal?      @map("default_length_cm") @db.Decimal(6, 2)
  defaultWidthCm          Decimal?      @map("default_width_cm") @db.Decimal(6, 2)
  defaultHeightCm         Decimal?      @map("default_height_cm") @db.Decimal(6, 2)
  defaultDeclaredValueInr Decimal?      @map("default_declared_value_inr") @db.Decimal(12, 2)
  status                  ProductStatus @default(ACTIVE)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?     @map("deleted_at") @db.Timestamptz

  seller   Seller           @relation(fields: [sellerId], references: [id])
  variants ProductVariant[]

  @@unique([sellerId, externalRef])
  @@index([sellerId])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId         String         @map("product_id") @db.Uuid
  sellerId          String         @map("seller_id") @db.Uuid
  skuCode           String         @map("sku_code")
  attributes        Json?
  variantLabel      String?        @map("variant_label")
  weightGrams       Int?           @map("weight_grams")
  lengthCm          Decimal?       @map("length_cm") @db.Decimal(6, 2)
  widthCm           Decimal?       @map("width_cm") @db.Decimal(6, 2)
  heightCm          Decimal?       @map("height_cm") @db.Decimal(6, 2)
  declaredValueInr  Decimal?       @map("declared_value_inr") @db.Decimal(12, 2)
  gstRate           Decimal?       @map("gst_rate") @db.Decimal(5, 2)
  barcode           String?
  status            VariantStatus  @default(ACTIVE)
  // Module 5 — inventory: per-variant low-stock threshold. Wins over
  // sellers.defaultLowStockThreshold; null = fall back to seller default.
  lowStockThreshold Int?           @map("low_stock_threshold")
  // R4 — inventory-owned column living on a catalog table for storage
  // convenience (same sanctioned precedent as lowStockThreshold above,
  // MUST #13 clarification): which inventory MODE this SKU runs in.
  // NORMAL = today's aggregate-quantity model. STRICT = one serial per
  // physical unit, scanned at every gate. null = fall back to the
  // seller's `inventory.default_inventory_mode` setting. Written by the
  // inventory domain; read via CatalogReadService as a raw passthrough.
  inventoryMode     InventoryMode? @map("inventory_mode")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz

  product                 Product                    @relation(fields: [productId], references: [id])
  seller                  Seller                     @relation(fields: [sellerId], references: [id])
  images                  ProductImage[]
  stockBatches            StockBatch[]
  stockLevels             StockLevel[]
  stockMovements          StockMovement[]
  stockReservations       StockReservation[]
  cycleCountItems         CycleCountItem[]
  goodsReceiptLines       GoodsReceiptLine[]
  orderItems              OrderItem[]
  stockAlertStates        StockAlertState[]
  stockUnits              StockUnit[]
  freightAllocations      InboundFreightAllocation[]
  packBoxScans            PackBoxScan[]
  sellerFavouriteVariants SellerFavouriteVariant[]

  @@unique([sellerId, skuCode])
  @@index([productId])
  @@index([sellerId])
  @@index([barcode])
  @@index([status])
  @@index([deletedAt])
  @@map("product_variants")
}

/// A variant the seller has starred, so it comes to the top of a picker.
///
/// Per SELLER, not per seller-user: the catalogue belongs to the company
/// and two people packing the same orders want the same shortlist. A
/// per-person list would make "why is my picker different from yours" a
/// support question nobody can answer from the data.
model SellerFavouriteVariant {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  seller  Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// The star is on or off; there is no second star. The unique IS the
  /// idempotency — a double tap upserts rather than making two rows.
  @@unique([sellerId, variantId])
  @@index([sellerId])
  @@index([variantId])
  @@map("seller_favourite_variants")
}

model ProductImage {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId          String    @map("variant_id") @db.Uuid
  spacesKey          String    @map("spaces_key")
  spacesBucket       String    @default("skydrop-storage") @map("spaces_bucket")
  url                String
  thumbnailUrl       String?   @map("thumbnail_url")
  mimeType           String?   @map("mime_type")
  sizeBytes          Int?      @map("size_bytes")
  widthPx            Int?      @map("width_px")
  heightPx           Int?      @map("height_px")
  altText            String?   @map("alt_text")
  isPrimary          Boolean   @default(false) @map("is_primary")
  displayOrder       Int       @default(0) @map("display_order")
  uploadedBySellerId String?   @map("uploaded_by_seller_id") @db.Uuid
  uploadedByStaffId  String?   @map("uploaded_by_staff_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  uploadedBySeller Seller?        @relation("ProductImageUploadedBySeller", fields: [uploadedBySellerId], references: [id])
  uploadedByStaff  StaffUser?     @relation("ProductImageUploadedByStaff", fields: [uploadedByStaffId], references: [id])

  @@index([variantId])
  @@index([isPrimary])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("product_images")
}

model SellerCsvMapping {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId   String        @map("seller_id") @db.Uuid
  name       String
  importType CsvImportType @map("import_type")
  columnMap  Json          @map("column_map")
  isDefault  Boolean       @default(false) @map("is_default")
  lastUsedAt DateTime?     @map("last_used_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, importType])
  @@index([sellerId, isDefault])
  @@index([deletedAt])
  @@map("seller_csv_mappings")
}

model BulkProductUpload {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId           String           @map("seller_id") @db.Uuid
  mappingId          String?          @map("mapping_id") @db.Uuid
  fileName           String           @map("file_name")
  spacesKey          String           @map("spaces_key")
  fileSizeBytes      Int              @map("file_size_bytes")
  rowCount           Int?             @map("row_count")
  status             BulkUploadStatus @default(PENDING)
  errorReportKey     String?          @map("error_report_key")
  productsCreated    Int              @default(0) @map("products_created")
  productsUpdated    Int              @default(0) @map("products_updated")
  variantsCreated    Int              @default(0) @map("variants_created")
  variantsUpdated    Int              @default(0) @map("variants_updated")
  rowsFailed         Int              @default(0) @map("rows_failed")
  rowsSkipped        Int              @default(0) @map("rows_skipped")
  jobId              String?          @map("job_id")
  startedAt          DateTime?        @map("started_at") @db.Timestamptz
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz
  uploadedBySellerId String?          @map("uploaded_by_seller_id") @db.Uuid
  uploadedByStaffId  String?          @map("uploaded_by_staff_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("bulk_product_uploads")
}

// ============================================================
// Layer 4 — Inventory & WMS (10 tables: spec lists 7 but counts paired
// header/lines tables as one — we materialize 9, plus stock_alert_state
// added in Module 5 — alert state has a (seller,variant,warehouse) grain
// that does not fit stock_levels' per-bin/batch rows; see phase-1a-debt)
// ============================================================

model StockBatch {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId        String      @map("seller_id") @db.Uuid
  variantId       String      @map("variant_id") @db.Uuid
  warehouseId     String      @map("warehouse_id") @db.Uuid
  batchCode       String      @map("batch_code")
  sellerBatchRef  String?     @map("seller_batch_ref")
  manufacturedAt  DateTime?   @map("manufactured_at") @db.Timestamptz
  expiresAt       DateTime?   @map("expires_at") @db.Timestamptz
  unitCostInr     Decimal?    @map("unit_cost_inr") @db.Decimal(12, 2)
  unitCostBdt     Decimal?    @map("unit_cost_bdt") @db.Decimal(12, 2)
  status          BatchStatus @default(ACTIVE)
  initialQty      Int         @map("initial_qty")
  receivedAt      DateTime    @map("received_at") @db.Timestamptz
  receivedById    String?     @map("received_by_id") @db.Uuid
  receivingNoteId String?     @map("receiving_note_id") @db.Uuid
  /// R6b — set when this batch was created to hold RTO goods that came
  /// back to a DIFFERENT warehouse than they shipped from. Points at the
  /// batch the goods originally belonged to, so expiry/cost lineage (and
  /// the receipt → freight-bill chain via `receivingNoteId`, which is
  /// copied from the parent) survive the move. NULL for every normal
  /// goods-receipt batch.
  parentBatchId   String?     @map("parent_batch_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz

  seller            Seller             @relation(fields: [sellerId], references: [id])
  variant           ProductVariant     @relation(fields: [variantId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  receivedBy        StaffUser?         @relation("StockBatchReceivedBy", fields: [receivedById], references: [id])
  receivingNote     GoodsReceipt?      @relation(fields: [receivingNoteId], references: [id])
  parentBatch       StockBatch?        @relation("StockBatchRtoChild", fields: [parentBatchId], references: [id])
  rtoChildBatches   StockBatch[]       @relation("StockBatchRtoChild")
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  reservations      StockReservation[]
  cycleCountItems   CycleCountItem[]
  goodsReceiptLines GoodsReceiptLine[]
  orderItems        OrderItem[]
  shipmentItems     ShipmentItem[]
  stockUnits        StockUnit[]

  @@unique([sellerId, batchCode])
  @@index([sellerId, variantId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([expiresAt])
  @@index([status])
  @@index([deletedAt])
  @@index([receivedById])
  @@index([receivingNoteId])
  @@index([parentBatchId])
  @@map("stock_batches")
}

// Hard delete: zero out and prune. No deletedAt.
model StockLevel {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  binId       String   @map("bin_id") @db.Uuid
  batchId     String   @map("batch_id") @db.Uuid
  qtyOnHand   Int      @default(0) @map("qty_on_hand")
  qtyReserved Int      @default(0) @map("qty_reserved")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seller    Seller         @relation(fields: [sellerId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  bin       WarehouseBin   @relation(fields: [binId], references: [id])
  batch     StockBatch     @relation(fields: [batchId], references: [id])

  @@unique([sellerId, variantId, warehouseId, binId, batchId])
  @@index([sellerId, variantId])
  @@index([warehouseId, binId])
  @@index([variantId])
  @@index([batchId])
  @@index([qtyOnHand])
  @@map("stock_levels")
}

/// R4 — STRICT-mode per-unit serialization: one row per PHYSICAL UNIT,
/// carrying the serial the warehouse floor scans at every gate.
///
/// This is a SIDECAR, not a replacement. `stock_levels.qtyOnHand` stays
/// the authoritative availability number for BOTH modes (INV-3 is
/// untouched) — strict mode adds *enforcement* on top of the aggregate,
/// it does not introduce a second source of truth. Deliberate, because
/// making unit rows authoritative would rewrite INV-3/INV-4 and every
/// downstream availability consumer. The intended invariant for a strict
/// variant is `COUNT(units IN_STOCK at a warehouse) == qtyOnHand there`;
/// divergence is a real-world floor event, so the discrepancy report
/// SURFACES it rather than the code assuming it away.
///
/// There is intentionally NO `RESERVED` status: reservations are
/// quantity-grained (phase-1 soft claim, phase-2 bin+batch) and never
/// select individual units. A unit's first status change is at PICK,
/// when a human actually scans it.
model StockUnit {
  id                 String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId           String          @map("seller_id") @db.Uuid
  variantId          String          @map("variant_id") @db.Uuid
  /// Unique per seller (NOT globally): two sellers may legitimately
  /// receive units carrying the same supplier-printed barcode.
  serialBarcode      String          @map("serial_barcode")
  status             StockUnitStatus @default(IN_STOCK)
  /// Where the unit physically is. warehouse is required from intake;
  /// bin/batch are nullable so a unit survives a batch being retired.
  warehouseId        String          @map("warehouse_id") @db.Uuid
  binId              String?         @map("bin_id") @db.Uuid
  batchId            String?         @map("batch_id") @db.Uuid
  /// Provenance — the receipt line this unit was registered against.
  goodsReceiptLineId String?         @map("goods_receipt_line_id") @db.Uuid
  /// Set when the unit is scanned onto an outbound parcel line; kept
  /// (not cleared) through RTO so the unit's history stays traceable.
  shipmentItemId     String?         @map("shipment_item_id") @db.Uuid
  /// true ⇒ Skydrop generated + printed this serial at receiving;
  /// false ⇒ scanned off the supplier's own label.
  isSystemGenerated  Boolean         @default(true) @map("is_system_generated")
  lastScanAt         DateTime?       @map("last_scan_at") @db.Timestamptz
  lastScanByStaffId  String?         @map("last_scan_by_staff_id") @db.Uuid
  /// Why the unit left inventory permanently (WRITTEN_OFF / LOST).
  writeOffReason     String?         @map("write_off_reason")
  note               String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  seller           Seller            @relation(fields: [sellerId], references: [id])
  variant          ProductVariant    @relation(fields: [variantId], references: [id])
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  bin              WarehouseBin?     @relation(fields: [binId], references: [id])
  batch            StockBatch?       @relation(fields: [batchId], references: [id])
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])
  shipmentItem     ShipmentItem?     @relation(fields: [shipmentItemId], references: [id])
  lastScanBy       StaffUser?        @relation("StockUnitLastScanBy", fields: [lastScanByStaffId], references: [id])
  events           StockUnitEvent[]
  packBoxScans     PackBoxScan[]

  @@unique([sellerId, serialBarcode])
  @@index([sellerId, variantId, status])
  @@index([warehouseId, status])
  @@index([shipmentItemId])
  @@index([batchId])
  @@index([binId])
  @@index([goodsReceiptLineId])
  @@index([lastScanByStaffId])
  /// Drives the discrepancy report: "units sitting in a mid-lifecycle
  /// status longer than the SLA window".
  @@index([status, updatedAt])
  @@map("stock_units")
}

/// R4 — APPEND-ONLY scan log for a unit. Joins stock_movements /
/// order_events / call_attempts / audit_logs / ticket_events on the
/// never-modify-after-insert list: each row is the historical fact that
/// a specific human scanned a specific unit at a specific gate.
model StockUnitEvent {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stockUnitId String           @map("stock_unit_id") @db.Uuid
  fromStatus  StockUnitStatus? @map("from_status")
  toStatus    StockUnitStatus  @map("to_status")
  gate        String
  actorType   ActorType        @map("actor_type")
  actorId     String?          @map("actor_id") @db.Uuid
  shipmentId  String?          @map("shipment_id") @db.Uuid
  warehouseId String?          @map("warehouse_id") @db.Uuid
  note        String?          @db.Text
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id], onDelete: Cascade)

  @@index([stockUnitId, createdAt])
  @@index([toStatus])
  @@index([shipmentId])
  @@map("stock_unit_events")
}

// APPEND-ONLY LEDGER. TimescaleDB hypertable (post-migration SQL).
// Composite PK includes createdAt (partition column requirement).
// Immutable — no updatedAt, no deletedAt.
//
// orderId / orderItemId / shipmentId are soft refs in this commit; they get
// promoted to @relation in Layers 5 and 7 once those models exist.
model StockMovement {
  id              String                   @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  sellerId        String                   @map("seller_id") @db.Uuid
  variantId       String                   @map("variant_id") @db.Uuid
  warehouseId     String                   @map("warehouse_id") @db.Uuid
  binId           String?                  @map("bin_id") @db.Uuid
  batchId         String?                  @map("batch_id") @db.Uuid
  type            StockMovementType
  qtyChange       Int                      @map("qty_change")
  qtyBefore       Int                      @map("qty_before")
  qtyAfter        Int                      @map("qty_after")
  actorType       ActorType                @map("actor_type")
  actorId         String?                  @map("actor_id") @db.Uuid
  reason          String?
  reasonCode      StockMovementReasonCode? @map("reason_code")
  orderId         String?                  @map("order_id") @db.Uuid
  orderItemId     String?                  @map("order_item_id") @db.Uuid
  shipmentId      String?                  @map("shipment_id") @db.Uuid
  adjustmentId    String?                  @map("adjustment_id") @db.Uuid
  transferGroupId String?                  @map("transfer_group_id") @db.Uuid
  fromBinId       String?                  @map("from_bin_id") @db.Uuid
  toBinId         String?                  @map("to_bin_id") @db.Uuid
  metadata        Json?

  seller     Seller           @relation(fields: [sellerId], references: [id])
  variant    ProductVariant   @relation(fields: [variantId], references: [id])
  warehouse  Warehouse        @relation(fields: [warehouseId], references: [id])
  bin        WarehouseBin?    @relation("StockMovementBin", fields: [binId], references: [id])
  batch      StockBatch?      @relation(fields: [batchId], references: [id])
  fromBin    WarehouseBin?    @relation("StockMovementFromBin", fields: [fromBinId], references: [id])
  toBin      WarehouseBin?    @relation("StockMovementToBin", fields: [toBinId], references: [id])
  adjustment StockAdjustment? @relation(fields: [adjustmentId], references: [id])
  order      Order?           @relation(fields: [orderId], references: [id])
  orderItem  OrderItem?       @relation(fields: [orderItemId], references: [id])
  shipment   Shipment?        @relation(fields: [shipmentId], references: [id])

  @@id([id, createdAt])
  @@index([sellerId, variantId, createdAt])
  @@index([warehouseId, binId, createdAt])
  @@index([batchId])
  @@index([orderId])
  @@index([shipmentId])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([adjustmentId])
  @@index([orderItemId])
  @@map("stock_movements")
}

// orderId / orderItemId are forward refs (Layer 5) — kept as scalar in this
// commit and promoted to @relation in Layer 5.
model StockReservation {
  id            String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId      String                    @map("seller_id") @db.Uuid
  variantId     String                    @map("variant_id") @db.Uuid
  warehouseId   String                    @map("warehouse_id") @db.Uuid
  binId         String?                   @map("bin_id") @db.Uuid
  batchId       String?                   @map("batch_id") @db.Uuid
  qtyReserved   Int                       @map("qty_reserved")
  orderId       String                    @map("order_id") @db.Uuid
  orderItemId   String                    @map("order_item_id") @db.Uuid
  status        ReservationStatus         @default(ACTIVE)
  // R5 — WHICH of the two booking stages created this hold. Distinct
  // from the phase-1/phase-2 distinction (which is bin/batch being NULL
  // vs populated): a hold can be AT_PLACEMENT *and* still phase-1.
  // Defaults to AT_CONFIRMATION so every pre-R5 row keeps its meaning.
  bookingStage  ReservationBookingStage   @default(AT_CONFIRMATION) @map("booking_stage")
  expiresAt     DateTime?                 @map("expires_at") @db.Timestamptz
  releasedAt    DateTime?                 @map("released_at") @db.Timestamptz
  fulfilledAt   DateTime?                 @map("fulfilled_at") @db.Timestamptz
  releaseReason ReservationReleaseReason? @map("release_reason")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  seller    Seller         @relation(fields: [sellerId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  bin       WarehouseBin?  @relation(fields: [binId], references: [id])
  batch     StockBatch?    @relation(fields: [batchId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id])
  orderItem OrderItem      @relation(fields: [orderItemId], references: [id])

  @@index([sellerId, variantId, status])
  @@index([orderId])
  @@index([orderItemId])
  @@index([status, expiresAt])
  @@index([binId, batchId])
  @@index([orderId, bookingStage, status])
  @@map("stock_reservations")
}

model StockAdjustment {
  id                   String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId             String                  @map("seller_id") @db.Uuid
  warehouseId          String                  @map("warehouse_id") @db.Uuid
  type                 AdjustmentType
  reasonCode           StockMovementReasonCode @map("reason_code")
  description          String?                 @db.Text
  initiatedById        String                  @map("initiated_by_id") @db.Uuid
  initiatedAt          DateTime                @map("initiated_at") @db.Timestamptz
  status               AdjustmentStatus        @default(PENDING)
  approverThresholdInr Decimal?                @map("approver_threshold_inr") @db.Decimal(12, 2)
  approvedById         String?                 @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?               @map("approved_at") @db.Timestamptz
  rejectedReason       String?                 @map("rejected_reason") @db.Text
  photoSpacesKeys      String[]                @default([]) @map("photo_spaces_keys")
  totalValueImpactInr  Decimal?                @map("total_value_impact_inr") @db.Decimal(12, 2)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz

  seller          Seller                @relation(fields: [sellerId], references: [id])
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  initiatedBy     StaffUser             @relation("StockAdjustmentInitiatedBy", fields: [initiatedById], references: [id])
  approvedBy      StaffUser?            @relation("StockAdjustmentApprovedBy", fields: [approvedById], references: [id])
  movements       StockMovement[]
  cycleCountItems CycleCountItem[]
  lines           StockAdjustmentLine[]

  @@index([sellerId])
  @@index([warehouseId])
  @@index([status])
  @@index([type])
  @@index([initiatedAt])
  @@index([initiatedById])
  @@index([approvedById])
  @@map("stock_adjustments")
}

// Module 5 (commit 19). Persists a PENDING adjustment's INTENDED stock
// change so the executor can replay it on approval — StockAdjustment
// itself has no target columns. variant/bin/batch are bare scalar UUIDs
// (no @relation), matching the loosely-coupled-ref precedent
// (category_proposals.proposedParentId, bulk_product_uploads ids): these
// are operational targets, not graph edges. The parent link IS a relation
// (cascade with the adjustment, like goods_receipt_lines).
//
// qtyChange is signed and MUST agree with the parent type (INCREASE => >0,
// DECREASE => <0). unitCostInr is the RESOLVED cost snapshot
// (line input → batch.unitCostInr) used for totalValueImpactInr and
// historical accuracy. batchId nullable for schema flexibility; the
// executor requires it (stock_levels is always at a concrete bin+batch).
model StockAdjustmentLine {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  adjustmentId String   @map("adjustment_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  binId        String   @map("bin_id") @db.Uuid
  batchId      String?  @map("batch_id") @db.Uuid
  qtyChange    Int      @map("qty_change")
  unitCostInr  Decimal? @map("unit_cost_inr") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@index([variantId])
  @@index([binId])
  @@index([batchId])
  @@map("stock_adjustment_lines")
}

model CycleCount {
  id                       String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  warehouseId              String           @map("warehouse_id") @db.Uuid
  zoneId                   String?          @map("zone_id") @db.Uuid
  countType                CycleCountType   @map("count_type")
  countDate                DateTime         @map("count_date") @db.Date
  initiatedById            String           @map("initiated_by_id") @db.Uuid
  status                   CycleCountStatus @default(SCHEDULED)
  startedAt                DateTime?        @map("started_at") @db.Timestamptz
  completedAt              DateTime?        @map("completed_at") @db.Timestamptz
  totalBinsCounted         Int              @default(0) @map("total_bins_counted")
  totalSkusCounted         Int              @default(0) @map("total_skus_counted")
  discrepancyCount         Int              @default(0) @map("discrepancy_count")
  totalDiscrepancyValueInr Decimal          @default(0) @map("total_discrepancy_value_inr") @db.Decimal(12, 2)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime?        @map("deleted_at") @db.Timestamptz

  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  zone        WarehouseZone?   @relation(fields: [zoneId], references: [id])
  initiatedBy StaffUser        @relation("CycleCountInitiatedBy", fields: [initiatedById], references: [id])
  items       CycleCountItem[]

  @@index([warehouseId])
  @@index([zoneId])
  @@index([countType])
  @@index([status])
  @@index([countDate])
  @@index([initiatedById])
  @@map("cycle_counts")
}

model CycleCountItem {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cycleCountId String    @map("cycle_count_id") @db.Uuid
  variantId    String    @map("variant_id") @db.Uuid
  binId        String    @map("bin_id") @db.Uuid
  batchId      String?   @map("batch_id") @db.Uuid
  systemQty    Int       @map("system_qty")
  countedQty   Int       @map("counted_qty")
  countedById  String?   @map("counted_by_id") @db.Uuid
  countedAt    DateTime? @map("counted_at") @db.Timestamptz
  notes        String?   @db.Text
  adjustmentId String?   @map("adjustment_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  cycleCount CycleCount       @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  variant    ProductVariant   @relation(fields: [variantId], references: [id])
  bin        WarehouseBin     @relation(fields: [binId], references: [id])
  batch      StockBatch?      @relation(fields: [batchId], references: [id])
  countedBy  StaffUser?       @relation("CycleCountItemCountedBy", fields: [countedById], references: [id])
  adjustment StockAdjustment? @relation(fields: [adjustmentId], references: [id])

  @@index([cycleCountId])
  @@index([variantId])
  @@index([binId])
  @@index([batchId])
  @@index([adjustmentId])
  @@index([countedById])
  @@map("cycle_count_items")
}

/// A seller's stock shipment, from announcement to landed-in-India.
///
/// The seller-facing object. It owns the ROUTE, the LABELLING STATION
/// and the timeline; the counting is done by its `receipts`, which are
/// ordinary goods receipts and reuse the receiving station unchanged.
/// See docs/consignment-two-leg.md.
model Consignment {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId          String            @map("seller_id") @db.Uuid
  consignmentNumber String            @unique @map("consignment_number")
  route             ConsignmentRoute
  status            ConsignmentStatus @default(PENDING)
  labellingSite     LabellingSite     @default(NONE) @map("labelling_site")
  /// Set by the first print. While null the site may be changed freely;
  /// after it, never.
  labelsPrintedAt   DateTime?         @map("labels_printed_at") @db.Timestamptz
  expectedArrivalAt DateTime?         @map("expected_arrival_at") @db.Timestamptz
  sellerReference   String?           @map("seller_reference")
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason      String?           @map("cancel_reason") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz

  seller         Seller                 @relation(fields: [sellerId], references: [id])
  receipts       GoodsReceipt[]
  events         ConsignmentEvent[]
  freightCharges InboundFreightCharge[]

  @@index([sellerId, status])
  @@index([status])
  @@index([deletedAt])
  @@map("consignments")
}

/// APPEND-ONLY, like `order_events`. The seller watches this; there is
/// no update or delete path by construction.
model ConsignmentEvent {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  consignmentId     String               @map("consignment_id") @db.Uuid
  type              ConsignmentEventType
  description       String?              @db.Text
  data              Json?
  actorType         ActorType?           @map("actor_type")
  actorId           String?              @map("actor_id") @db.Uuid
  isVisibleToSeller Boolean              @default(true) @map("is_visible_to_seller")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  consignment Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)

  @@index([consignmentId, createdAt])
  @@index([type])
  @@map("consignment_events")
}

model GoodsReceipt {
  id                    String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId              String             @map("seller_id") @db.Uuid
  warehouseId           String             @map("warehouse_id") @db.Uuid
  /// The journey this arrival belongs to. Nullable only for receipts
  /// that predate two-leg consignments.
  consignmentId         String?            @map("consignment_id") @db.Uuid
  leg                   ConsignmentLeg?
  /// IN_FINAL legs only: when this shipment left Bangladesh. Its stock
  /// sits in the destination warehouse's TRANSIT bin from this moment
  /// until the leg is received.
  dispatchedAt          DateTime?          @map("dispatched_at") @db.Timestamptz
  dispatchedById        String?            @map("dispatched_by_id") @db.Uuid
  /// The Bangladesh stop handled this consignment and sent it on WITHOUT
  /// opening it. Not the same as a count of zero, and not a discrepancy:
  /// nobody looked, so there is no number and no difference to report.
  /// India becomes the first and only count.
  forwardedWithoutCount Boolean            @default(false) @map("forwarded_without_count")
  receiptNumber         String             @unique @map("receipt_number")
  expectedArrivalAt     DateTime?          @map("expected_arrival_at") @db.Timestamptz
  sellerReference       String?            @map("seller_reference")
  expectedSkus          Json?              @map("expected_skus")
  receivedAt            DateTime?          @map("received_at") @db.Timestamptz
  receivedById          String?            @map("received_by_id") @db.Uuid
  status                GoodsReceiptStatus @default(PENDING)
  hasDiscrepancies      Boolean            @default(false) @map("has_discrepancies")
  discrepancyNotes      String?            @map("discrepancy_notes") @db.Text
  photoSpacesKeys       String[]           @default([]) @map("photo_spaces_keys")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz

  seller        Seller                @relation(fields: [sellerId], references: [id])
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  consignment   Consignment?          @relation(fields: [consignmentId], references: [id])
  receivedBy    StaffUser?            @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  dispatchedBy  StaffUser?            @relation("GoodsReceiptDispatchedBy", fields: [dispatchedById], references: [id])
  lines         GoodsReceiptLine[]
  stockBatches  StockBatch[]
  // The freight bill for THIS arrival. One forwarder invoice per
  // shipment; a consignment accumulates as many as it has arrivals.
  //
  // Both sides are declared on purpose. A one-sided relation is how this
  // model previously grew a phantom column: `prisma format` makes a
  // dangling relation legal the only way it can, by inventing the
  // missing scalar, so `validate` passes on a schema no migration ever
  // created and every insert 500s at runtime.
  freightCharge InboundFreightCharge?

  @@index([sellerId])
  @@index([warehouseId])
  @@index([status])
  @@index([expectedArrivalAt])
  @@index([receivedById])
  @@index([consignmentId])
  @@index([dispatchedById])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  receiptId      String    @map("receipt_id") @db.Uuid
  variantId      String    @map("variant_id") @db.Uuid
  batchId        String?   @map("batch_id") @db.Uuid
  expectedQty    Int       @map("expected_qty")
  receivedQty    Int       @default(0) @map("received_qty")
  damagedQty     Int       @default(0) @map("damaged_qty")
  unitCostInr    Decimal?  @map("unit_cost_inr") @db.Decimal(12, 2)
  manufacturedAt DateTime? @map("manufactured_at") @db.Timestamptz
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  putawayBinId   String?   @map("putaway_bin_id") @db.Uuid
  /// Where the agent SAYS they put it, recorded while bin tracking is
  /// off. Deliberately NOT on `stock_levels`: with tracking off the
  /// stock genuinely is in FLOOR, and writing a location into the stock
  /// record would claim knowledge the system does not have. This is a
  /// note taken on arrival — a head start when tracking is switched on,
  /// never an authority, because stock sells and gets shuffled after.
  notedLocation  String?   @map("noted_location")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  receipt           GoodsReceipt              @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  freightAllocation InboundFreightAllocation?
  variant           ProductVariant            @relation(fields: [variantId], references: [id])
  batch             StockBatch?               @relation(fields: [batchId], references: [id])
  putawayBin        WarehouseBin?             @relation(fields: [putawayBinId], references: [id])
  stockUnits        StockUnit[]

  @@index([receiptId])
  @@index([variantId])
  @@index([batchId])
  @@index([putawayBinId])
  @@map("goods_receipt_lines")
}

/// R3 — the BD→India inbound freight bill for one consignment.
///
/// This is a DIFFERENT money flow from the outbound courier fee
/// (`order_charges` / the `ORDER_CHARGES` wallet direction): that one is
/// per-order and India-domestic, this one is per-consignment and
/// cross-border. The founder described both, and keeping them separate is
/// what makes "what did it cost to get this stock into India" answerable
/// at all.
///
/// PAY_NOW settles against the wallet immediately. PAY_LATER leaves the
/// row PENDING as a visible receivable — the seller keeps their cash now
/// and optionally carries a service charge for the privilege.
model InboundFreightCharge {
  id                   String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId             String               @map("seller_id") @db.Uuid
  /// The consignment this bill belongs to — for grouping and reporting.
  /// NOT unique: a consignment arrives in as many shipments as it takes.
  consignmentId        String               @map("consignment_id") @db.Uuid
  /// ONE BILL PER ARRIVAL, and this is the idempotency key.
  ///
  /// It was `consignmentId @unique` — one bill for the whole
  /// consignment — which assumed a consignment arrives once. It does
  /// not: `IN_FINAL` is a list precisely because 300 units can leave
  /// Dhaka as 100 now and 200 in September, and the status derivation
  /// already handles "some landed, some still in BD".
  ///
  /// Under the old key both choices lost money silently. Bill early and
  /// the split ran over the units that had landed SO FAR; the later
  /// arrivals got no allocation row, and the charge path skips a unit
  /// with no allocation (`if (!alloc) continue`), so they shipped
  /// freight-free forever — and the forwarder's invoice for that second
  /// shipment could not be entered at all. Bill late and freight is
  /// charged as a unit LEAVES, so anything that sold before the bill
  /// existed was never charged either.
  ///
  /// Per-arrival also matches the paperwork: a forwarder invoices a
  /// shipment, not a commercial arrangement spanning months.
  goodsReceiptId       String               @unique @map("goods_receipt_id") @db.Uuid
  /// The freight invoice as recorded by ops, INR canonical.
  amountInr            Decimal              @map("amount_inr") @db.Decimal(12, 2)
  /// What the FORWARDER charged US for the same shipment. `amountInr`
  /// is what we charge the seller; the gap between them is the margin
  /// on the BD→India leg, and without this column that margin is
  /// unknowable rather than merely unreported.
  ourCostInr           Decimal?             @map("our_cost_inr") @db.Decimal(12, 2)
  mode                 InboundFreightMode
  /// Snapshotted at record time (NOT re-read at settlement): the seller
  /// agreed to the rate that applied when the consignment landed.
  serviceChargePercent Decimal?             @map("service_charge_percent") @db.Decimal(5, 2)
  serviceChargeInr     Decimal?             @map("service_charge_inr") @db.Decimal(12, 2)
  /// amountInr + serviceChargeInr — what the seller actually owes.
  totalInr             Decimal              @map("total_inr") @db.Decimal(12, 2)
  /// R3 amortisation — how many physical units this bill covers, and how
  /// much of it has actually been charged so far. Freight is a per-unit
  /// LANDED COST: 100 units arrive on one bill, and the seller pays a
  /// unit's share as that unit leaves (delivered, or written off). The
  /// other 99 stay due. PAY_NOW bills are settled in full up front and
  /// are never amortised.
  totalUnits           Int                  @default(0) @map("total_units")
  unitsSettled         Int                  @default(0) @map("units_settled")
  amountSettledInr     Decimal              @default(0) @map("amount_settled_inr") @db.Decimal(12, 2)
  status               InboundFreightStatus @default(PENDING)
  settledAt            DateTime?            @map("settled_at") @db.Timestamptz
  settledByStaffId     String?              @map("settled_by_staff_id") @db.Uuid
  /// The wallet DEBIT this bill produced. Set once, at settlement — it is
  /// also the idempotency evidence that the seller was charged exactly
  /// once.
  walletEntryId        String?              @unique @map("wallet_entry_id") @db.Uuid
  note                 String?              @db.Text
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  seller       Seller                     @relation(fields: [sellerId], references: [id])
  consignment  Consignment                @relation(fields: [consignmentId], references: [id])
  goodsReceipt GoodsReceipt               @relation(fields: [goodsReceiptId], references: [id])
  allocations  InboundFreightAllocation[]
  settledBy    StaffUser?                 @relation("InboundFreightSettledBy", fields: [settledByStaffId], references: [id])
  walletEntry  SellerWalletEntry?         @relation(fields: [walletEntryId], references: [id])

  @@index([consignmentId])
  @@index([sellerId, status])
  @@index([status])
  @@index([settledByStaffId])
  @@map("inbound_freight_charges")
}

/// R3 amortisation — one row per consignment LINE, carrying that line's
/// share of the freight bill split down to a per-unit rate.
///
/// Why per line and not one flat rate for the whole consignment: freight
/// is priced by WEIGHT, so a shipment of 100 phone cases and 20 kettles
/// must not charge the case what it charges the kettle. The split is by
/// total line weight (unit weight × units), falling back to unit COUNT
/// for lines whose SKU has no weight recorded — the fallback is honest
/// rather than silently treating a missing weight as zero.
///
/// The rate is SNAPSHOTTED here at record time; it is never recomputed,
/// so a later catalog weight edit cannot retro-price goods that have
/// already landed.
model InboundFreightAllocation {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  freightChargeId    String              @map("freight_charge_id") @db.Uuid
  /// The consignment line. UNIQUE — one allocation per line, which is
  /// also what makes re-recording idempotent.
  goodsReceiptLineId String              @unique @map("goods_receipt_line_id") @db.Uuid
  variantId          String              @map("variant_id") @db.Uuid
  units              Int
  /// Effective per-unit weight, informational only since the bill stopped
  /// being split by weight.
  unitWeightGrams    Int?                @map("unit_weight_grams")
  /// How this line was priced by the forwarder. Freight is quoted either
  /// by weight or by the piece, and which one it was is part of the
  /// record: a rate of 300 means nothing without knowing whether it was
  /// per kilo or per sunglass.
  basis              InboundFreightBasis
  /// The rate as invoiced — per kg, or per piece. 4dp because a
  /// per-piece rate on a cheap item is often fractions of a rupee.
  rateInr            Decimal             @map("rate_inr") @db.Decimal(12, 4)
  /// Only for PER_KG: the chargeable weight the forwarder billed for
  /// this line. Their figure, not ours — volumetric weight and rounding
  /// up to the next half-kilo are both normal, so a weight computed from
  /// the catalogue would disagree with the invoice.
  chargeableWeightKg Decimal?            @map("chargeable_weight_kg") @db.Decimal(12, 3)
  /// rate x weight, or rate x units. Stored rather than recomputed: it
  /// is what the invoice says, and a later rounding change must not
  /// restate a bill the seller has already been charged for.
  lineTotalInr       Decimal             @map("line_total_inr") @db.Decimal(12, 2)
  /// 4dp: a bill divided across many units needs more precision than the
  /// 2dp money columns, or the rounding drift becomes visible.
  perUnitInr         Decimal             @map("per_unit_inr") @db.Decimal(12, 4)
  unitsSettled       Int                 @default(0) @map("units_settled")
  amountSettledInr   Decimal             @default(0) @map("amount_settled_inr") @db.Decimal(12, 2)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  freightCharge    InboundFreightCharge @relation(fields: [freightChargeId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine     @relation(fields: [goodsReceiptLineId], references: [id])
  variant          ProductVariant       @relation(fields: [variantId], references: [id])

  @@index([freightChargeId])
  @@index([variantId])
  @@map("inbound_freight_allocations")
}

/// D3 — a pool of AWB numbers pre-fetched from the courier.
///
/// Delhivery's bulk waybill endpoint allows only FIVE requests per five
/// minutes, and their own docs warn that a waybill used immediately after
/// being fetched "may occasionally result in errors" because numbers are
/// generated in batches of 25 behind the scenes. Fetching one per
/// shipment at manifest time would therefore be both rate-limited and
/// flaky. So we pull them in bulk ahead of time, let them settle, and
/// hand them out locally.
///
/// Verified against production 2026-07-27: the endpoint returns a bare
/// JSON string — `"38061110478262"` for one, and
/// `"38061110478273,38061110478284,38061110478295"` for several — not an
/// array.
model CourierWaybill {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierCode      String               @map("courier_code")
  /// The account that bought this number. NULL only for rows pooled
  /// before any CourierAccount existed, and claimable then only by a
  /// call that resolved no account either.
  courierAccountId String?              @map("courier_account_id") @db.Uuid
  /// The AWB itself. Globally unique — a number handed out twice would
  /// put two parcels on one tracking identity.
  awbNumber        String               @unique @map("awb_number")
  status           CourierWaybillStatus @default(AVAILABLE)
  fetchedAt        DateTime             @default(now()) @map("fetched_at") @db.Timestamptz
  /// Not claimable before this instant — honours the "let it settle"
  /// warning above.
  usableAfter      DateTime             @map("usable_after") @db.Timestamptz
  assignedAt       DateTime?            @map("assigned_at") @db.Timestamptz
  /// The shipment that consumed it (soft ref: the AWB outlives a
  /// superseded shipment, and the number can never be reused anyway).
  shipmentId       String?              @map("shipment_id") @db.Uuid
  voidedAt         DateTime?            @map("voided_at") @db.Timestamptz
  voidReason       String?              @map("void_reason")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  courierAccount CourierAccount? @relation(fields: [courierAccountId], references: [id])

  @@index([courierCode, status, usableAfter])
  @@index([courierAccountId, status, usableAfter])
  @@index([shipmentId])
  @@map("courier_waybills")
}

/// How a courier message reached us. Each channel has a different
/// trustworthiness and a different failure mode, and collapsing them
/// would lose the ability to say "the portal says X but the email said
/// Y" — which is exactly the disagreement worth surfacing.
enum CourierMessageChannel {
  /// Delhivery CCs a dedicated mailbox on ticket activity.
  EMAIL  @map("email")
  /// Delhivery One MCP, once the realm is provisioned.
  MCP    @map("mcp")
  /// Browser automation reading the portal (Phase 5).
  PORTAL @map("portal")
  /// A human pasted it in from the panel.
  MANUAL @map("manual")

  @@map("courier_message_channel")
}

/// Which way a message travelled.
enum CourierMessageDirection {
  INBOUND  @map("inbound")
  OUTBOUND @map("outbound")

  @@map("courier_message_direction")
}

enum CourierTemplateCandidateStatus {
  /// No pattern matched. The default, and the only state the system
  /// produces on its own while the model is off.
  UNMATCHED @map("unmatched")
  /// A model proposed a pattern; a human has not looked yet.
  SUGGESTED @map("suggested")
  /// Promoted into the live library.
  PROMOTED  @map("promoted")
  /// Looked at and deliberately not promoted.
  REJECTED  @map("rejected")

  @@map("courier_template_candidate_status")
}

/// A conversation with the courier about one ticket.
///
/// It HANGS OFF a Ticket rather than being its own seller-facing entity:
/// R7's ticket queue already is "someone reports a parcel problem, ops
/// works one list", and a second inbox would mean two places to look and
/// two things to keep in sync. The escalation is the COURIER-FACING half
/// of a conversation the seller already has a home for.
model CourierEscalation {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId String @unique @map("ticket_id") @db.Uuid

  /// Delhivery's own ticket id, once we know it. Null while the ticket
  /// exists only on our side — a raise can be pending, or the whole
  /// escalation can start life as an email we received first.
  externalTicketId String? @map("external_ticket_id")
  /// Their category id, NEVER a label string: labels are localised and
  /// re-worded, ids are not.
  categoryId       String? @map("category_id")
  awbNumber        String? @map("awb_number")
  courierCode      String  @default("delhivery") @map("courier_code")

  /// The classifier's latest read of where this stands. A LABEL, never
  /// an instruction: TypeScript decides what to do with it.
  state         String?
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  /// Set when a message needs a human — low classifier confidence, an
  /// unmatched template, or a state that asks something of the seller.
  needsReviewAt DateTime? @map("needs_review_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ticket   Ticket                     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messages CourierEscalationMessage[]
  outbox   CourierOutboxItem[]

  @@index([externalTicketId])
  @@index([awbNumber])
  @@index([needsReviewAt])
  @@map("courier_escalations")
}

/// One message in that conversation. APPEND-ONLY.
///
/// ── THE DEDUP KEY IS THE WHOLE DESIGN ────────────────────────────────
/// `(escalationId, bodyHash, minuteBucket)`. The minute-bucket is NOT
/// belt-and-braces: Delhivery's canned replies repeat VERBATIM across
/// days ("trying our best to deliver within 24 to 48 hours" lands again
/// tomorrow, byte-identical), so a content hash alone would treat the
/// second genuine reply as a duplicate and silently swallow it. The
/// bucket makes the key "this exact text, from this conversation, in
/// this minute" — which dedups a re-delivered webhook and a polled
/// re-read of the same message, while letting the same sentence arrive
/// again tomorrow.
model CourierEscalationMessage {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  escalationId String @map("escalation_id") @db.Uuid

  direction CourierMessageDirection
  channel   CourierMessageChannel

  /// VERBATIM. Never rewritten, never translated, never summarised —
  /// the seller is meant to feel they are reading the courier.
  body         String @db.Text
  /// sha256 of the normalised body; half the dedup key.
  bodyHash     String @map("body_hash")
  /// Epoch MINUTE of `occurredAt`; the other half. Stored rather than
  /// derived so the unique index can use it.
  minuteBucket BigInt @map("minute_bucket")

  /// When the courier sent it (their timestamp when we have one), NOT
  /// when we ingested it — same discipline as TRK-3's eventAt.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz

  /// Classifier output. A STATE LABEL and nothing else.
  templateCode String?  @map("template_code")
  state        String?
  confidence   Decimal? @db.Decimal(4, 3)
  /// True when this went to a human — unmatched, or below the gate.
  needsReview  Boolean  @default(false) @map("needs_review")

  /// Message-id / external id from the source channel, for tracing.
  sourceRef String? @map("source_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  escalation CourierEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)

  @@unique([escalationId, bodyHash, minuteBucket], map: "courier_escalation_messages_dedup")
  @@index([escalationId, occurredAt])
  @@index([needsReview])
  @@map("courier_escalation_messages")
}

/// Messages the regex library could not classify, and the corpus they
/// become.
///
/// ── WHY THIS EXISTS BEFORE THE MODEL DOES ────────────────────────────
/// With the LLM off, an unmatched message would otherwise vanish and the
/// regex library would never learn what it is missing. Every miss lands
/// here as UNMATCHED, so the corpus builds from REAL traffic before the
/// model is ever enabled — and when it is, its `suggestedRegex` lands in
/// the same queue for a human to promote. A pattern nobody reviewed is a
/// pattern that silently mislabels.
model CourierTemplateCandidate {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Normalised body — the thing a pattern would have to match.
  body      String @db.Text
  bodyHash  String @unique @map("body_hash")
  /// How many times this exact text has now been seen. The ordering
  /// signal: the most repeated miss is the most valuable pattern.
  seenCount Int    @default(1) @map("seen_count")

  status CourierTemplateCandidateStatus @default(UNMATCHED)

  /// Only ever set by a model, never applied automatically.
  suggestedRegex    String?   @map("suggested_regex")
  suggestedState    String?   @map("suggested_state")
  /// Filled by the human who promoted or rejected it.
  reviewedByStaffId String?   @map("reviewed_by_staff_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNotes       String?   @map("review_notes") @db.Text

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  @@index([status, seenCount])
  @@map("courier_template_candidates")
}

/// The regex library itself — DATA, not code.
///
/// Adding a template must not need a deploy: the corpus grows from real
/// courier traffic, and a library that ships in a TypeScript array means
/// every new canned reply waits on a release. Patterns are seeded from
/// the four verbatim templates we have and extended from
/// `courier_template_candidates` as real ones surface.
model CourierMessageTemplate {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable identifier used in logs and tests, e.g. NDR_ACK_24_48.
  code String @unique

  /// JS-flavoured regex source, matched case-insensitively against the
  /// normalised body. Stored WITHOUT delimiters.
  pattern String
  /// The state label this implies. Consumed by TypeScript; never an
  /// instruction to the system.
  state   String
  /// What ops should do about it, if anything. Also a label.
  action  String?

  /// Lower runs first. Lets a specific pattern win over a general one
  /// without depending on insertion order.
  priority Int     @default(100)
  isActive Boolean @default(true) @map("is_active")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, priority])
  @@map("courier_message_templates")
}

/// Where an outbound courier message is in its life.
///
/// `SENT_UNCONFIRMED` is the state the whole design exists to handle: we
/// dispatched something and do not know whether it landed. It is NEVER
/// blind-retried — a retry is how one comment becomes three.
enum CourierOutboxStatus {
  /// Queued, not claimed.
  PENDING          @map("pending")
  /// Claimed and being worked, by a worker or a human.
  SENDING          @map("sending")
  /// Dispatched, outcome UNKNOWN. Only a read-back may move it on.
  SENT_UNCONFIRMED @map("sent_unconfirmed")
  /// Read back from Delhivery and found present. Terminal, and the ONLY
  /// success — never set by anyone asserting they did it.
  CONFIRMED        @map("confirmed")
  /// Definitively not sent. Safe to re-enqueue as a NEW item.
  FAILED           @map("failed")

  @@map("courier_outbox_status")
}

/// How a failure should be treated, which is a different question from
/// what went wrong.
enum CourierDispatchErrorClass {
  /// The request provably never reached them — DNS failure, connection
  /// refused, 401. Nothing happened on their side, so failing over
  /// immediately is safe.
  PRE_DISPATCH @map("pre_dispatch")
  /// A timeout or a 5xx. The request MAY have been processed. This is
  /// the class that must never be retried blind — it goes to the
  /// reconciler, which reads their state before deciding.
  AMBIGUOUS    @map("ambiguous")
  /// They answered, and the answer was no. Not retryable as-is.
  REJECTED     @map("rejected")

  @@map("courier_dispatch_error_class")
}

/// What kind of write this is.
enum CourierOutboxKind {
  /// Add a comment to an existing courier ticket.
  COMMENT      @map("comment")
  /// Raise a new ticket.
  RAISE_TICKET @map("raise_ticket")

  @@map("courier_outbox_kind")
}

/// Operator intent for the write channel. Distinct from health — see
/// `CourierChannelSettings.pausedUntil`.
enum CourierWriteMode {
  /// Everything to the ops queue. The worker claims nothing.
  MANUAL     @map("manual")
  /// The worker prepares and holds for one-click approval.
  SUPERVISED @map("supervised")
  /// The worker executes unattended, except locked categories.
  AUTO       @map("auto")

  @@map("courier_write_mode")
}

/// One outbound message, and everything needed to decide what to do with
/// it after something went wrong.
///
/// ── WHY AN OUTBOX AND NOT A QUEUE JOB ────────────────────────────────
/// BullMQ retries on failure, which is correct for idempotent work and
/// catastrophic here: posting a comment is not idempotent, and a retried
/// timeout puts the same message in a customer-visible thread twice. The
/// outbox is a durable row whose STATE decides what may happen next, and
/// the queue only ever wakes something up to look at it.
model CourierOutboxItem {
  id           String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  escalationId String @map("escalation_id") @db.Uuid

  kind       CourierOutboxKind
  /// VERBATIM outbound text. Never rewritten, never translated — the
  /// seller's words reach the courier as the seller wrote them.
  body       String            @db.Text
  /// Delhivery's category ID for a RAISE_TICKET. An ID, never a label:
  /// labels are localised and re-worded, IDs are not.
  categoryId String?           @map("category_id")

  status   CourierOutboxStatus @default(PENDING)
  attempts Int                 @default(0)

  /// The mode this item was ROUTED under, stamped at claim time and not
  /// at enqueue. Flipping the mode must not leave a mis-stamped backlog
  /// that executes under yesterday's intent.
  routedMode CourierWriteMode? @map("routed_mode")

  /// Claim lease. Whoever holds it owns the item until it expires; a
  /// human and the worker can never both be acting on one message.
  claimedByStaffId String?   @map("claimed_by_staff_id") @db.Uuid
  /// 'worker' when the automated consumer holds it. Deliberately not a
  /// staff FK — the worker is not a person and must not borrow one.
  claimedByKind    String?   @map("claimed_by_kind")
  claimedAt        DateTime? @map("claimed_at") @db.Timestamptz
  claimExpiresAt   DateTime? @map("claim_expires_at") @db.Timestamptz

  /// Set the moment we dispatch, BEFORE we know the outcome. This is
  /// what makes a crash mid-post recoverable instead of invisible.
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz
  /// Set only by a READ-BACK that found the message present.
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz
  /// Their id for what we created — a ticket id for RAISE_TICKET.
  externalRef  String?   @map("external_ref")

  lastError      String?                    @map("last_error") @db.Text
  lastErrorClass CourierDispatchErrorClass? @map("last_error_class")

  /// sha256 of (escalation, kind, body). Logged instead of the payload,
  /// so an action is traceable without the text living in two places.
  requestFingerprint String @map("request_fingerprint")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  escalation CourierEscalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([escalationId])
  @@index([claimExpiresAt])
  @@map("courier_outbox_items")
}

/// The write channel's settings. One row per courier.
///
/// ── TWO VARIABLES, NOT ONE ───────────────────────────────────────────
/// `writeMode` is what the OPERATOR chose. `pausedUntil` is what the
/// SYSTEM decided about its own health. A canary failure or an open
/// circuit sets the pause; it must never overwrite the mode, or
/// recovering would silently restore a mode nobody re-chose — and an
/// operator who set MANUAL on purpose would find themselves back in AUTO
/// because a health check went green.
model CourierChannelSettings {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierCode String @unique @map("courier_code")

  writeMode      CourierWriteMode @default(MANUAL) @map("write_mode")
  /// Delhivery category IDs the worker may act on unattended. EMPTY is
  /// the shipped state and the only safe one while the taxonomy is
  /// unfetched. Claims/Finance and Protect VAS can never appear here —
  /// enforced in the service, not by hoping.
  autoCategories String[]         @default([]) @map("auto_categories")

  /// How far the PORTAL channel may go. Separate from `writeMode` so
  /// SHADOW can run under MANUAL: the ops queue keeps serving humans
  /// while the worker learns the portal against the same real items.
  portalMode CourierPortalMode @default(SHADOW) @map("portal_mode")

  /// Health, not intent. Null = not paused.
  pausedUntil DateTime? @map("paused_until") @db.Timestamptz
  pauseReason String?   @map("pause_reason") @db.Text

  updatedByStaffId String?  @map("updated_by_staff_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("courier_channel_settings")
}

/// A pending 2FA challenge for a write-mode change.
///
/// Mirrors `BinCollapseChallenge`: a six-digit code mailed to the actor,
/// stored hashed, attempt-capped and expiring. Widening the write channel
/// is the act that lets software send vans and post to a customer-visible
/// thread, so it gets the same ceremony as collapsing a warehouse.
model CourierModeChallenge {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierCode String @map("courier_code")
  staffUserId String @map("staff_user_id") @db.Uuid

  /// What they are asking for. Verified again at confirm time — a
  /// challenge is not a licence to set anything.
  requestedMode       CourierWriteMode @map("requested_mode")
  requestedCategories String[]         @default([]) @map("requested_categories")

  /// Hashed, never stored in the clear.
  codeHash   String    @map("code_hash")
  reason     String    @db.Text
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  staffUser StaffUser @relation("CourierModeChallengeStaff", fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("courier_mode_challenges")
}

/// How far the portal channel is allowed to go, independent of write_mode.
///
/// SHADOW is not a disabled state — the worker runs, logs in, navigates,
/// resolves the category, composes the action and records exactly what it
/// WOULD have done. It just never clicks the last button. That is the
/// only way to find out whether browser automation understands the portal
/// before it touches a ticket a customer can see.
enum CourierPortalMode {
  /// Prepares and logs everything, executes nothing. The default.
  SHADOW @map("shadow")
  /// Executes.
  LIVE   @map("live")

  @@map("courier_portal_mode")
}

/// Delhivery's issue-category tree, as THEY define it.
///
/// ── WHY THIS TABLE IS THE POINT OF PHASE 5 ───────────────────────────
/// The Claims/Finance and Protect VAS locks are specified to be enforced
/// by category ID, and until now that was unenforceable: we had no IDs,
/// so `assertAutoCategoriesAllowed` had to refuse ANY non-empty auto list
/// as the only honest substitute. The portal is the first channel that
/// can READ the taxonomy, which is what turns those locks from a comment
/// into a predicate.
///
/// ── IDS, NEVER LABELS ────────────────────────────────────────────────
/// `externalId` is the key on everything. Labels get re-worded and
/// localised — "Shipment not delivered (need POD)/Fake remark" is one
/// edit away from not matching a string comparison, and that edit would
/// silently unlock a category rather than fail loudly.
model CourierIssueCategory {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierCode      String  @map("courier_code")
  /// THEIR id. The only thing anything matches on.
  externalId       String  @map("external_id")
  /// THEIR label, for humans reading the console. Never matched on.
  label            String
  /// Parent's externalId, for the subcategory tree.
  parentExternalId String? @map("parent_external_id")

  /// True when this category may never be actioned unattended. Derived
  /// from the label at fetch time (see the fetcher) and then FROZEN —
  /// a later re-fetch does not clear it, because the safe direction for a
  /// lock is sticky.
  isHumanOnly Boolean @default(false) @map("is_human_only")

  /// When we last saw it in a fetch. A category that stops appearing is
  /// NOT deleted — it is left with a stale `lastSeenAt` so a disappearing
  /// category is visible rather than silently gone.
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([courierCode, externalId])
  @@index([courierCode, isHumanOnly])
  @@map("courier_issue_categories")
}

/// One portal automation run, and what it did or would have done.
///
/// Separate from `courier_outbox_items` because an outbox item is a
/// MESSAGE and this is an ATTEMPT: a single item can be shadowed a dozen
/// times before it is ever executed, and collapsing the two would lose
/// every shadow observation the moment the item was finally sent.
model CourierPortalRun {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null for a canary or a taxonomy fetch — those act on no item.
  outboxItemId String?           @map("outbox_item_id") @db.Uuid
  kind         String
  mode         CourierPortalMode
  /// SHADOW / OK / ALREADY_PRESENT / NOT_ELIGIBLE / TASK_PENDING /
  /// CHALLENGE / FAILED. A string rather than an enum because the portal
  /// will teach us outcomes we have not thought of, and a migration per
  /// discovery is friction in exactly the wrong place.
  outcome      String
  /// What it did, or in SHADOW what it would have done. Never the
  /// customer-visible body — that lives on the outbox item.
  detail       String?           @db.Text
  /// Screenshot path when a challenge or failure needs a human to look.
  artifactPath String?           @map("artifact_path")
  startedAt    DateTime          @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime?         @map("ended_at") @db.Timestamptz

  @@index([outboxItemId])
  @@index([kind, startedAt])
  @@map("courier_portal_runs")
}

/// The outcome of one NDR action we asked Delhivery to perform.
///
/// Delhivery's NDR API is ASYNCHRONOUS: the call returns a UPL id, not a
/// result, and the real answer is only available by polling. So a row
/// here is not "we got a re-attempt" — it is "we asked, and here is what
/// we know so far".
enum NdrRequestStatus {
  /// Sent, UPL id stored, outcome not yet known.
  SUBMITTED @map("submitted")
  /// The UPL poll said Delhivery accepted it.
  CONFIRMED @map("confirmed")
  /// Delhivery rejected it, OR the poll deadline passed without an
  /// answer. Those are the same thing operationally: see the model doc.
  FAILED    @map("failed")
  /// Handed to the ticket path — a human now owns it.
  ESCALATED @map("escalated")

  @@map("ndr_request_status")
}

/// One NDR action request, from submission to whether it actually worked.
///
/// ── WHY THIS TABLE EXISTS AT ALL ──────────────────────────────────────
/// Without it, "did we ask Delhivery to re-attempt this parcel?" is
/// unanswerable — the call is fire-and-forget over the wire, and the
/// only local trace would be an audit line nobody joins against. It is
/// also the input to the reconciliation job, which is the one thing that
/// can catch Delhivery accepting our calls and not acting on them.
///
/// ── UNPOLLED IS FAILED, NOT UNKNOWN ───────────────────────────────────
/// If the poll deadline passes with no answer, the row goes FAILED
/// rather than staying SUBMITTED. Treating silence as "still might work"
/// is how a parcel sits for a week: the customer is waiting either way,
/// and a re-attempt we cannot confirm has to be chased by a human. The
/// cost of being wrong is a duplicate chase; the cost of the other
/// choice is a parcel nobody is looking at.
///
/// ── `newAttemptSeen` IS THE POINT ─────────────────────────────────────
/// A CONFIRMED UPL means Delhivery ACCEPTED the request, not that a van
/// went out. Reconciliation asks the only question that matters — did a
/// new delivery attempt actually appear in tracking afterwards — and
/// that answer lives here so the trend is queryable rather than
/// recomputed.
model NdrActionRequest {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId String @map("shipment_id") @db.Uuid
  /// Denormalised: the AWB is how Delhivery identifies this, and a
  /// superseded shipment must not silently repoint the history.
  awbNumber  String @map("awb_number")
  /// 'RE-ATTEMPT' | 'PICKUP_RESCHEDULE' — Delhivery's own vocabulary,
  /// kept as their string rather than mapped into an enum of ours: it is
  /// their API's input, and a mapping layer here would only be a place
  /// for the two to disagree.
  action     String

  /// The NSL and attempt count AS READ IMMEDIATELY BEFORE SUBMITTING.
  /// Snapshotted because eligibility was judged on these exact values;
  /// re-deriving them later would be judging a past decision on present
  /// facts.
  nslCodeAtSubmit      String? @map("nsl_code_at_submit")
  attemptCountAtSubmit Int     @map("attempt_count_at_submit")

  status         NdrRequestStatus @default(SUBMITTED)
  /// Delhivery's async handle. Null only if the submit itself failed.
  uplId          String?          @map("upl_id")
  /// Verbatim courier text — never rewritten, never translated.
  courierMessage String?          @map("courier_message") @db.Text

  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  polledAt     DateTime? @map("polled_at") @db.Timestamptz
  pollAttempts Int       @default(0) @map("poll_attempts")

  /// Reconciliation output. `newAttemptSeen` null = not yet checked.
  reconciledAt   DateTime? @map("reconciled_at") @db.Timestamptz
  newAttemptSeen Boolean?  @map("new_attempt_seen")

  /// Set when this was handed to the ticket path.
  ticketId String? @map("ticket_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@index([shipmentId])
  @@index([awbNumber])
  @@map("ndr_action_requests")
}

/// D6 — a request for Delhivery to send a van to one of our warehouses.
///
/// The grain is the thing to get right: a pickup is raised against a
/// WAREHOUSE, not a waybill. Twenty parcels leaving the same building
/// need ONE request; asking per parcel would summon a fleet.
///
/// Delhivery permits only one OPEN request per pickup location per day —
/// a second is accepted "only when the existing pickup request is
/// closed". The UNIQUE below IS that rule, enforced by Postgres rather
/// than by remembering: two supervisors clicking at once cannot both
/// raise one, and a retry after a timeout cannot quietly book a second
/// van. A blind retry is exactly the failure mode the courier's docs
/// warn about, and "check the One panel" is not something a UNIQUE
/// constraint can say for us — but a 409 is.
model CourierPickupRequest {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierCode          String              @map("courier_code")
  warehouseId          String              @map("warehouse_id") @db.Uuid
  /// The registered pickup-location NAME sent to Delhivery. Snapshotted
  /// because it must match their records EXACTLY and the setting behind
  /// it can be edited later — the request should record what was
  /// actually sent, not what the setting says today.
  pickupLocationName   String              @map("pickup_location_name")
  /// Local date (Asia/Kolkata) the van is wanted. Date, not timestamp:
  /// the courier's one-per-day rule is about the calendar day.
  pickupDate           DateTime            @map("pickup_date") @db.Date
  pickupTime           String              @map("pickup_time")
  expectedPackageCount Int                 @map("expected_package_count")
  status               PickupRequestStatus @default(REQUESTED)
  /// Delhivery's own id for the request, when they returned one.
  courierPickupId      String?             @map("courier_pickup_id")
  /// Their verbatim response message — kept because a refusal usually
  /// explains itself better than any code we would map it to.
  courierMessage       String?             @map("courier_message") @db.Text
  requestedByStaffId   String?             @map("requested_by_staff_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  warehouse        Warehouse  @relation(fields: [warehouseId], references: [id])
  requestedByStaff StaffUser? @relation(fields: [requestedByStaffId], references: [id])

  /// The one-OPEN-per-warehouse-per-day rule lives in a migration-only
  /// PARTIAL unique (courier_pickup_requests_open_day_uq, WHERE status IN
  /// ('requested','failed')) — Prisma cannot express a partial unique, and
  /// an unconditional one would be wrong: Delhivery accepts a second
  /// request "only when the existing pickup request is closed", so a
  /// CLOSED morning collection must not block an afternoon van. FAILED
  /// still occupies the day on purpose (we cannot tell a lost response
  /// from a never-sent one); `releaseDay` is the audited way out.
  @@index([status])
  @@index([pickupDate])
  @@map("courier_pickup_requests")
}

enum PickupRequestStatus {
  /// Sent to the courier and accepted.
  REQUESTED @map("requested")
  /// The courier refused it, or the call failed. Kept rather than
  /// deleted so the day is not silently free to retry into.
  FAILED    @map("failed")
  /// The van came, or the operator closed it out.
  CLOSED    @map("closed")
  /// Called off before the van arrived.
  CANCELLED @map("cancelled")

  @@map("pickup_request_status")
}

enum CourierWaybillStatus {
  /// Fetched and (once usableAfter passes) ready to hand out.
  AVAILABLE @map("available")
  /// Claimed by a shipment; not yet confirmed manifested.
  ASSIGNED  @map("assigned")
  /// Confirmed on a manifested shipment.
  USED      @map("used")
  /// Rejected by the courier or otherwise unusable. Never re-issued.
  VOID      @map("void")

  @@map("courier_waybill_status")
}

/// R2c — money the COURIER paid US.
///
/// This is the missing half of the COD loop. Delhivery collects cash from
/// the customer on delivery and settles with Skydrop 5-10 days later; up
/// to now nothing in the system recorded that inbound payment, so "have we
/// actually been paid for the orders we already credited sellers for?" was
/// unanswerable. Every withdrawal is recorded here and allocated to the orders
/// it covers, which is what turns "we can't lose a rupee" from an
/// assertion into a number.
///
/// APPEND-MOSTLY: a settlement is a historical fact about a bank credit.
/// Corrections are made by recording an adjusting settlement, not by
/// editing a past one.
model CourierSettlement {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierAccountId  String   @map("courier_account_id") @db.Uuid
  /// The courier's own withdrawal/UTR reference. UNIQUE per account — the
  /// idempotency gate against recording the same bank credit twice.
  reference         String
  /// What actually landed in the bank, INR.
  amountInr         Decimal  @map("amount_inr") @db.Decimal(14, 2)
  /// Sum of this settlement's allocated lines. Kept alongside amountInr
  /// so an under- or over-allocated withdrawal is visible without a join.
  allocatedInr      Decimal  @default(0) @map("allocated_inr") @db.Decimal(14, 2)
  receivedAt        DateTime @map("received_at") @db.Timestamptz
  recordedByStaffId String?  @map("recorded_by_staff_id") @db.Uuid
  note              String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  courierAccount CourierAccount          @relation(fields: [courierAccountId], references: [id])
  recordedBy     StaffUser?              @relation("CourierSettlementRecordedBy", fields: [recordedByStaffId], references: [id])
  lines          CourierSettlementLine[]

  @@unique([courierAccountId, reference])
  @@index([courierAccountId, receivedAt])
  @@index([receivedAt])
  @@index([recordedByStaffId])
  @@map("courier_settlements")
}

/// R2c — how much of a withdrawal belongs to ONE order.
///
/// `expectedInr` is snapshotted from the order's COD amount at allocation
/// time, so `settledInr - expectedInr` is the short-payment (or overpay)
/// for that order, permanently, even if the order is later adjusted.
model CourierSettlementLine {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  settlementId String   @map("settlement_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  /// What the courier should have remitted for this order (its COD amount).
  expectedInr  Decimal  @map("expected_inr") @db.Decimal(12, 2)
  /// What this withdrawal actually attributed to it.
  settledInr   Decimal  @map("settled_inr") @db.Decimal(12, 2)
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  settlement CourierSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order      Order             @relation(fields: [orderId], references: [id])

  /// One line per order per settlement — a withdrawal cannot pay the same
  /// order twice. An order CAN legitimately appear across settlements
  /// (a part-payment then a top-up), which is why this is not unique on
  /// orderId alone.
  @@unique([settlementId, orderId])
  @@index([orderId])
  @@map("courier_settlement_lines")
}

// Module 5 — low-stock alert state, one row per
// (seller × variant × warehouse). NOT on stock_levels: availability and the
// threshold are evaluated at the (seller,variant,warehouse) grain, while
// stock_levels has one row per bin×batch and those rows are pruned at qty 0
// (state would be lost / ambiguous). Owns the INV-9 alert state machine.
model StockAlertState {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId            String    @map("seller_id") @db.Uuid
  variantId           String    @map("variant_id") @db.Uuid
  warehouseId         String    @map("warehouse_id") @db.Uuid
  wasAlertActive      Boolean   @default(false) @map("was_alert_active")
  lowStockAlertSentAt DateTime? @map("low_stock_alert_sent_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  seller    Seller         @relation(fields: [sellerId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([sellerId, variantId, warehouseId])
  @@index([sellerId, variantId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("stock_alert_state")
}

// ============================================================
// Layer 5 — Orders & Customers (6 tables)
// ============================================================

model Customer {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId              String            @map("seller_id") @db.Uuid
  phoneE164             String            @map("phone_e164")
  name                  String?
  email                 String?
  altPhoneE164          String?           @map("alt_phone_e164")
  totalOrdersCount      Int               @default(0) @map("total_orders_count")
  successfulOrdersCount Int               @default(0) @map("successful_orders_count")
  rtoCount              Int               @default(0) @map("rto_count")
  refusedCount          Int               @default(0) @map("refused_count")
  fakeOrdersCount       Int               @default(0) @map("fake_orders_count")
  riskLevel             CustomerRiskLevel @default(NONE) @map("risk_level")
  riskNotes             String?           @map("risk_notes") @db.Text
  preferredLanguage     String            @default("en") @map("preferred_language")
  firstOrderAt          DateTime?         @map("first_order_at") @db.Timestamptz
  lastOrderAt           DateTime?         @map("last_order_at") @db.Timestamptz
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz

  seller       Seller                       @relation(fields: [sellerId], references: [id])
  orders       Order[]
  addressCache OrderRecipientAddressCache[]

  // Module 6: customer identity is per-seller (sellerId, phoneE164). The
  // canonical pre-M6 design was a GLOBAL phone-keyed customer with
  // cross-seller risk aggregation; that was deliberately narrowed to
  // per-seller for Phase 1A privacy (see phase-1a-debt). Risk aggregates
  // (rtoCount, fakeOrdersCount, riskLevel) are therefore per-seller now.
  @@unique([sellerId, phoneE164])
  @@index([sellerId])
  @@index([phoneE164])
  @@index([riskLevel])
  @@index([lastOrderAt])
  @@index([deletedAt])
  @@map("customers")
}

model Order {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderNumber             String                   @unique @map("order_number")
  sellerId                String                   @map("seller_id") @db.Uuid
  customerId              String?                  @map("customer_id") @db.Uuid
  sellerOrderRef          String?                  @map("seller_order_ref")
  source                  OrderSource              @default(MANUAL)
  bulkUploadId            String?                  @map("bulk_upload_id") @db.Uuid
  recipientName           String                   @map("recipient_name")
  recipientPhoneE164      String                   @map("recipient_phone_e164")
  recipientAltPhoneE164   String?                  @map("recipient_alt_phone_e164")
  /// Set when the seller placed this KNOWING the customer already had an
  /// unpacked order. Without it there is no answer to "did they know?"
  /// the first time a duplicate delivery fee is disputed.
  duplicateAcknowledgedAt DateTime?                @map("duplicate_acknowledged_at") @db.Timestamptz
  recipientEmail          String?                  @map("recipient_email")
  recipientAddressLine1   String                   @map("recipient_address_line1")
  recipientAddressLine2   String?                  @map("recipient_address_line2")
  recipientLandmark       String?                  @map("recipient_landmark")
  recipientCity           String                   @map("recipient_city")
  recipientStateProvince  String                   @map("recipient_state_province")
  recipientPostalCode     String                   @map("recipient_postal_code")
  recipientCountryCode    String                   @default("IN") @map("recipient_country_code") @db.Char(2)
  paymentMode             PaymentMode              @map("payment_mode")
  /// What the courier collects at the door. The seller's COLLECTABLE
  /// AMOUNT — distinct from `declaredValueInr`, which is the customs
  /// figure sent to Delhivery and the e-waybill trigger above 50,000.
  codAmountInr            Decimal?                 @map("cod_amount_inr") @db.Decimal(12, 2)
  /// The three seller-supplied figures the collectable is built from.
  /// Stored rather than computed away so an order can still explain
  /// itself weeks later — a collectable with no breakdown is a number
  /// nobody can check against what the customer was told.
  advanceAmountInr        Decimal?                 @map("advance_amount_inr") @db.Decimal(12, 2)
  deliveryFeeInr          Decimal?                 @map("delivery_fee_inr") @db.Decimal(12, 2)
  discountInr             Decimal?                 @map("discount_inr") @db.Decimal(12, 2)
  declaredValueInr        Decimal                  @map("declared_value_inr") @db.Decimal(12, 2)
  totalWeightGrams        Int?                     @map("total_weight_grams")
  packageType             PackageType?             @map("package_type")
  status                  OrderStatus              @default(DRAFT)
  isUrgent                Boolean                  @default(false) @map("is_urgent")
  isHighRisk              Boolean                  @default(false) @map("is_high_risk")
  // Module 6 god mode (ORD-2): set true by OrderAdminOverrideService
  // .forceMutate() and NEVER cleared. Flags an order whose state machine
  // or edit rules were bypassed by an admin; per-field detail lives in
  // order_events, not summarised here.
  hasAdminOverride        Boolean                  @default(false) @map("has_admin_override")
  confirmedAt             DateTime?                @map("confirmed_at") @db.Timestamptz
  confirmedById           String?                  @map("confirmed_by_id") @db.Uuid
  cancellationReason      OrderCancellationReason? @map("cancellation_reason")
  cancelledAt             DateTime?                @map("cancelled_at") @db.Timestamptz
  cancelledById           String?                  @map("cancelled_by_id") @db.Uuid
  internalNotes           String?                  @map("internal_notes") @db.Text
  sellerNotes             String?                  @map("seller_notes") @db.Text
  callNotes               String?                  @map("call_notes") @db.Text
  slaDeadline             DateTime?                @map("sla_deadline") @db.Timestamptz
  expectedDeliveryAt      DateTime?                @map("expected_delivery_at") @db.Timestamptz
  placedAt                DateTime                 @default(now()) @map("placed_at") @db.Timestamptz
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz

  seller                 Seller                  @relation(fields: [sellerId], references: [id])
  customer               Customer?               @relation(fields: [customerId], references: [id])
  bulkUpload             BulkOrderUpload?        @relation(fields: [bulkUploadId], references: [id])
  confirmedBy            StaffUser?              @relation("OrderConfirmedBy", fields: [confirmedById], references: [id])
  cancelledBy            StaffUser?              @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  items                  OrderItem[]
  events                 OrderEvent[]
  reservations           StockReservation[]
  stockMovements         StockMovement[]
  // Module 7: 1:many — an order has many queue entries over its
  // lifecycle (new entry per re-attempt, locked decision #2); at most
  // one is OPEN at a time (partial unique call_queue_entries_open_order_uq).
  callQueueEntries       CallQueueEntry[]
  callAttempts           CallAttempt[]
  reattemptRequests      OrderReattemptRequest[]
  orderShipments         OrderShipment[]
  charges                OrderCharge[]
  notificationLogs       NotificationLog[]
  walletEntries          SellerWalletEntry[]     @relation("WalletEntryOrder")
  gstWithholding         GstWithholding?
  invoice                Invoice?
  pendingAccrual         PendingAccrual?
  tickets                Ticket[]
  earlyReservationReview EarlyReservationReview?
  courierSettlementLines CourierSettlementLine[]
  packBoxes              PackBox[]

  @@unique([sellerId, sellerOrderRef])
  // A seller's own list, newest first — the most-hit read in the
  // product. Without placedAt in the key, Postgres walks the GLOBAL
  // newest-first index and discards every other seller's rows to find
  // twenty: measured at 300k orders / 50 sellers it threw away 980 rows
  // per page, and that ratio grows with the number of sellers rather
  // than with the seller's own volume. 6.6ms → 0.25ms, and now flat as
  // we add sellers.
  @@index([sellerId, placedAt(sort: Desc)])
  // Same list with a status filter. Supersedes the old
  // [sellerId, status] index, which this one's prefix covers.
  @@index([sellerId, status, placedAt(sort: Desc)])
  @@index([customerId])
  @@index([recipientPhoneE164])
  @@index([recipientPostalCode])
  @@index([status, placedAt])
  @@index([placedAt])
  @@index([confirmedAt])
  @@index([deletedAt])
  @@index([bulkUploadId])
  @@index([confirmedById])
  @@index([cancelledById])
