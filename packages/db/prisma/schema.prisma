  uploadedByStaff  StaffUser? @relation("BulkUploadUploadedByStaff", fields: [uploadedByStaffId], references: [id])
  orders           Order[]

  stagedRows StagedOrderRow[]

  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([uploadedBySellerId])
  @@index([uploadedByStaffId])
  @@map("bulk_order_uploads")
}

model OrderRecipientAddressCache {
  id                       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId               String   @map("customer_id") @db.Uuid
