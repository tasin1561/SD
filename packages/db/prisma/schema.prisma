  WRITTEN_OFF        @map("written_off")
  LOST               @map("lost")
  /// Sent home with an abandoned consignment. Neither destroyed
  /// (WRITTEN_OFF) nor unaccounted for (LOST) — we know exactly where
  /// it went, and "how much did we send back" is a question worth being
  /// able to answer on its own.
  RETURNED_TO_SELLER @map("returned_to_seller")

  @@map("stock_unit_status")
}

