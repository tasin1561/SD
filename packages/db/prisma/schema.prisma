enum OrderStatus {
  DRAFT                    @map("draft")
  PENDING_CONFIRMATION     @map("pending_confirmation")
  CALL_NO_RESPONSE         @map("call_no_response")
  CALL_RESCHEDULED         @map("call_rescheduled")
  CONFIRMED                @map("confirmed")
  // Module 6: reservation failure at PENDING_CONFIRMATION → CONFIRMED
  // lands here (non-terminal; Module 7 retries → CONFIRMED or → CANCELLED).
  OUT_OF_STOCK             @map("out_of_stock")
  CANCELLED                @map("cancelled")
  // Module 6: admin-initiated cancel (sane admin cancel + god-mode).
  // Seller/customer cancels use CANCELLED + cancellationReason.
  CANCELLED_BY_ADMIN       @map("cancelled_by_admin")
  REJECTED                 @map("rejected")
  // Module 7 (call center): terminal rejections from the call workflow.
  // REJECTED_BY_CUSTOMER = CUSTOMER_DECLINED / WRONG_NUMBER outcomes;
  // REJECTED_NDR = attempt cap reached (no further queue entry). Both
  // pre-reservation → no stock release. See ORD-1 matrix + CC-2 mapping.
  REJECTED_BY_CUSTOMER     @map("rejected_by_customer")
  REJECTED_NDR             @map("rejected_ndr")
  /// R5b — the call cap was reached on an order whose seller asked to be
  /// consulted (`inventory.early_reservation_ndr_action = MANUAL_REVIEW`).
  /// A PAUSE, not a terminal: the seller either asks for more attempts
  /// (→ PENDING_CONFIRMATION, which re-queues via CC-6) or gives up
  /// (→ REJECTED_NDR). A TTL sweep rejects it if they never answer, so
  /// stock is never held indefinitely by an unanswered question.
  ///
  /// This exists instead of un-terminaling REJECTED_NDR: an order that
  /// says "rejected" and is then un-rejected corrupts NDR reporting and
  /// lies about its own history while the seller is still deciding.
  AWAITING_SELLER_DECISION @map("awaiting_seller_decision")
  PENDING_PICK             @map("pending_pick")
  PICKED                   @map("picked")
  PACKED                   @map("packed")
  PACK_FAILED              @map("pack_failed")
  PENDING_DISPATCH         @map("pending_dispatch")
  DISPATCHED               @map("dispatched")
  IN_TRANSIT               @map("in_transit")
  OUT_FOR_DELIVERY         @map("out_for_delivery")
  DELIVERED                @map("delivered")
  DELIVERY_FAILED          @map("delivery_failed")
  RTO_INITIATED            @map("rto_initiated")
  RTO_IN_TRANSIT           @map("rto_in_transit")
  RTO_RECEIVED             @map("rto_received")
  RTO_RESTOCKED            @map("rto_restocked")
  RTO_DAMAGED              @map("rto_damaged")
  LOST_IN_TRANSIT          @map("lost_in_transit")
  PENDING_MANUAL_PLACEMENT @map("pending_manual_placement")

  @@map("order_status")
}

