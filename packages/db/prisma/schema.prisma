// ============================================================================
// Phase 1B — Wallet + ledger (M21)
// ============================================================================
//
// W-1 (append-only): seller_wallet_entries is the books of record. No UPDATE,
// no DELETE path. A correction is a NEW entry with direction = ADJUSTMENT_*
// + linkedEntryId pointing at the original.
//
// W-3 (balance computed): SellerWalletBalance is a CACHE; the authoritative
// balance is SUM(credits) - SUM(debits) per (sellerId, currency). The cache
// is recomputed post-commit after every WalletService.applyEntry() (mirrors
// INV-5 for stock).
//
// W-4 (per-currency wallets): Each seller has independent wallets per
// Currency. Cross-border remittance writes a paired (REMITTANCE_OUT debit
// on INR, REMITTANCE_FX credit on BDT) so both ledgers conserve.

/// R3 — who fronts the BD→India freight bill.
/// How the forwarder priced a freight line. Air freight is quoted by
/// weight; courier and consolidator lines are often per piece. Both
/// appear on the same invoice, so this is per LINE, not per bill.
enum InboundFreightBasis {
  PER_KG    @map("per_kg")
  PER_PIECE @map("per_piece")

  @@map("inbound_freight_basis")
}

enum InboundFreightMode {
  /// Settled against the wallet the moment ops records the bill.
  PAY_NOW   @map("pay_now")
  /// Carried as a receivable the seller settles later, optionally with a
  /// service charge.
  PAY_LATER @map("pay_later")

  @@map("inbound_freight_mode")
}

enum InboundFreightStatus {
  PENDING           @map("pending")
  /// R3 amortisation — some units' shares have been charged, the rest of
  /// the consignment is still sitting in stock and still owes.
  PARTIALLY_SETTLED @map("partially_settled")
  SETTLED           @map("settled")
  /// Ops forgave the bill (goodwill, our own error, a consignment we
  /// mis-handled). Distinct from SETTLED so waivers stay countable.
  WAIVED            @map("waived")

  @@map("inbound_freight_status")
}

enum WalletEntryDirection {
  // M22 — COD collected from customer credits the seller wallet on
  // DELIVERED. Always CREDIT.
  COD_COLLECTION       @map("cod_collection")
  // M22 — sum of order's BASE_SHIPPING + surcharges + GST debits the
  // seller wallet on DELIVERED. Always DEBIT.
  ORDER_CHARGES        @map("order_charges")
  // M23 — admin records a withdrawal to the seller. DEBIT on the wallet
  // matching the bank-account currency.
  REMITTANCE_OUT       @map("remittance_out")
  // M23 — paired with REMITTANCE_OUT for cross-currency: the BD seller
  // receives BDT, but COD was collected in INR. CREDIT on the
  // destination currency wallet (BDT) at the FX-snapshotted rate.
  REMITTANCE_FX        @map("remittance_fx")
  // Operator correction: a NEW entry that compensates an earlier
  // mistaken entry. linkedEntryId points at the original. reasonCode +
  // note required.
  ADJUSTMENT_CREDIT    @map("adjustment_credit")
  ADJUSTMENT_DEBIT     @map("adjustment_debit")
  // Initial balance on wallet creation (zero unless backfilled).
  OPENING_BALANCE      @map("opening_balance")
  // R7 — a damage/loss ticket resolved in the seller's favour credits
  // them the agreed amount. Deliberately NOT ADJUSTMENT_CREDIT: that one
  // is reserved for operator error-correction (and requires
  // reasonCode + linkedEntryId), so overloading it would make genuine
  // ledger corrections indistinguishable from damage settlements in
  // every report. Registered in WalletService's CREDIT_DIRECTIONS.
  SCRAP_REFUND         @map("scrap_refund")
  // R3 — the BD→India inbound freight bill for a goods receipt. Always a
  // DEBIT, so it is deliberately ABSENT from WalletService's
  // CREDIT_DIRECTIONS set (adding it there would pay sellers for their
  // own freight). Distinct from ORDER_CHARGES: that is the outbound
  // courier leg per order; this is the inbound leg per consignment, and
  // conflating them would make the two cost bases unseparable in every
  // report.
  INBOUND_FREIGHT      @map("inbound_freight")
  // The flat return fee, charged when a parcel physically comes back —
  // not when the courier says it is coming. Always a DEBIT, so it is
  // deliberately ABSENT from WalletService's CREDIT_DIRECTIONS (adding
  // it there would PAY sellers for their own returns). Distinct from
  // ORDER_CHARGES so "what did returns cost us this month" stays a
  // question the ledger can answer on its own.
  RTO_FEE              @map("rto_fee")
  // A seller wiring money INTO the wallet, verified by an operator
  // against the bank. Always a CREDIT — REGISTERED in WalletService's
  // CREDIT_DIRECTIONS and in apps/seller's mirrored set (WAL-1);
  // omitting it there would take the top-up back OUT of the wallet it
  // was meant to fill.
  TOPUP                @map("topup")
  // What Instant Pay costs the seller: the fee for being credited at
  // delivery instead of waiting for the courier to settle. Always a
  // DEBIT, so deliberately ABSENT from CREDIT_DIRECTIONS. Its own value
  // rather than folded into ORDER_CHARGES so the revenue from the
  // service is countable on its own.
  INSTANT_PAY_FEE      @map("instant_pay_fee")
  // What collecting COD costs a seller on SETTLEMENT. An INSTANT_PAY
  // seller does NOT also pay this: that rate is all-in and already
  // contains it, so an order carries one fee line reading exactly the
  // percentage the seller was quoted. Seeded at 0%, so it changes
  // nothing until someone decides it should. Always a DEBIT,
  // therefore ABSENT from CREDIT_DIRECTIONS. Its own value rather than
  // folded into ORDER_CHARGES so COD-handling revenue stays countable
  // separately from the delivery fee.
  COD_COLLECTION_FEE   @map("cod_collection_fee")
  // Giving back the delivery fee on an order that was cancelled before
  // it shipped. A CREDIT — REGISTERED in WalletService's
  // CREDIT_DIRECTIONS and in apps/seller's mirrored set (WAL-1);
  // omitting it there would take the fee a SECOND time on a parcel that
  // never moved. Deliberately NOT ADJUSTMENT_CREDIT: that one means "we
  // made a ledger mistake" and requires a reasonCode, whereas nothing
  // went wrong here — the charge was correct when taken and the
  // cancellation is what changed. Keeping them apart is what lets
  // "money returned because an order was called off" be counted without
  // reading it as a tally of our own errors. `linkedEntryId` points at
  // the ORDER_CHARGES row being returned.
  ORDER_CHARGES_REFUND @map("order_charges_refund")

  @@map("wallet_entry_direction")
}

/// How a seller gets paid their COD money. One at a time, by
/// construction — an enum rather than two booleans, so "only one
/// enabled" is unrepresentable rather than validated.
enum CodCreditMode {
  /// Credited when the courier actually settles with us. The seller
  /// waits, and we carry no float.
  SETTLEMENT  @map("settlement")
  /// Credited the moment the parcel is delivered, for a fee. We front
  /// the money until the courier pays.
  INSTANT_PAY @map("instant_pay")

  @@map("cod_credit_mode")
}

/// GST withheld from a seller's COD proceeds, which WE file.
///
/// This is not margin and must never read as revenue. The customer paid
/// a tax-inclusive price; we hold the tax portion between collecting it
/// and filing it, and this table is the record of what is owed to the
/// department. Without it the money lands in the same pot as everything
/// else and gets spent before the return is due.
///
/// One row per order — UNIQUE on orderId, which is also the gate that
/// stops a re-credit withholding twice.
model GstWithholding {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId       String    @map("seller_id") @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  /// The gross COD the customer paid — tax-INCLUSIVE.
  codAmountInr   Decimal   @map("cod_amount_inr") @db.Decimal(12, 2)
  /// The rate applied, snapshotted. A later rate change must not
  /// silently restate what we withheld last quarter.
  gstPercent     Decimal   @map("gst_percent") @db.Decimal(5, 2)
  /// codAmount × rate / (100 + rate) — extracted from the inclusive
  /// price, NOT added on top of it.
  gstAmountInr   Decimal   @map("gst_amount_inr") @db.Decimal(12, 2)
  /// What the seller was actually credited: gross − gst.
  netToSellerInr Decimal   @map("net_to_seller_inr") @db.Decimal(12, 2)
  withheldAt     DateTime  @default(now()) @map("withheld_at") @db.Timestamptz
  /// Set when this quarter's return is filed. Null ⇒ still owed.
  filedAt        DateTime? @map("filed_at") @db.Timestamptz
  filingRef      String?   @map("filing_ref")

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([sellerId, withheldAt])
  @@index([filedAt])
  @@map("gst_withholdings")
}

enum TopupRequestStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")

  @@map("topup_request_status")
}

/// One of OUR bank accounts, shown to sellers so they know where to send
/// money. Admin-managed reference data.
///
/// The account number is NOT encrypted, unlike a seller's: this is a
/// destination we publish on purpose, and encrypting a number we display
/// on a screen would be theatre. `isActive` retires an account without
/// deleting it — a past top-up must still name the account it went to.
model PlatformBankAccount {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  label            String
  bankName         String          @map("bank_name")
  accountName      String          @map("account_name")
  accountNumber    String          @map("account_number")
  /// IFSC (India) or SWIFT — free-form because the formats differ by
  /// country. NOT the Bangladeshi routing number; that has its own
  /// column, because a BEFTN transfer needs both and putting them in one
  /// field means whoever fills it in has to choose which one to lose.
  branchCode       String?         @map("branch_code")
  /// The branch the account is held at. A Bangladeshi routing number is
  /// branch-specific, so the two are read together — and a seller
  /// standing at a counter is asked for the branch by name.
  branchName       String?         @map("branch_name")
  /// The district the branch is in. Bank forms in Bangladesh ask for it,
  /// and several banks have a branch of the same name in more than one.
  district         String?
  /// The 9-digit BEFTN routing number. Kept as text, not an integer:
  /// leading zeros are significant and an integer silently eats them.
  routingNumber    String?         @map("routing_number")
  currency         Currency
  instructions     String?         @db.Text
  /// What this account is FOR, in one line, so a transfer is not made
  /// into the wrong pocket. Free text on purpose: the shape of an
  /// account estate changes faster than an enum can be migrated.
  purpose          String?
  /// Which courier account settles into here. Multiple Delhivery
  /// accounts settle to different banks, and "whose money is in which
  /// account" starts with knowing which pipe fills it.
  courierAccountId String?         @map("courier_account_id") @db.Uuid
  courierAccount   CourierAccount? @relation(fields: [courierAccountId], references: [id])
  isActive         Boolean         @default(true) @map("is_active")
  displayOrder     Int             @default(100) @map("display_order")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz

  topupRequests WalletTopupRequest[]
  entries       BankEntry[]
  transfersFrom BankTransfer[]       @relation("BankTransferFrom")
  transfersTo   BankTransfer[]       @relation("BankTransferTo")
  remittances   Remittance[]

  @@index([isActive, displayOrder])
  @@index([courierAccountId])
  @@map("platform_bank_accounts")
}

/// A seller says "I sent you money"; an operator checks the bank and
/// agrees or does not.
///
/// The wallet is NOT credited on submission. A claim is not a payment —
/// crediting first and clawing back on rejection would let anyone move
/// their balance up by filling in a form, and the claw-back would land
/// after they had already withdrawn against it.
///
/// A reference is mandatory: either `transactionRef` or a proof image,
/// enforced in the service. Without one there is nothing for the
/// operator to check against the statement, and "trust me" is not a
/// reconciliation.
model WalletTopupRequest {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId          String             @map("seller_id") @db.Uuid
  bankAccountId     String             @map("bank_account_id") @db.Uuid
  currency          Currency
  amount            Decimal            @db.Decimal(14, 2)
  /// The seller's bank reference / UTR. One of this or proofSpacesKey.
  transactionRef    String?            @map("transaction_ref")
  /// Spaces key of the uploaded proof. NEVER a URL — reads are
  /// presigned on demand (the storage rule from the 2026-07-28 pass).
  proofSpacesKey    String?            @map("proof_spaces_key")
  proofMimeType     String?            @map("proof_mime_type")
  status            TopupRequestStatus @default(PENDING)
  /// Set once accepted — the credit that resulted. UNIQUE, so a second
  /// accept cannot mint a second credit.
  walletEntryId     String?            @unique @map("wallet_entry_id") @db.Uuid
  submittedByUserId String?            @map("submitted_by_user_id") @db.Uuid
  reviewedByStaffId String?            @map("reviewed_by_staff_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz
  reviewNote        String?            @map("review_note") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  seller          Seller              @relation(fields: [sellerId], references: [id])
  bankAccount     PlatformBankAccount @relation(fields: [bankAccountId], references: [id])
  submittedByUser SellerUser?         @relation("TopupSubmittedBy", fields: [submittedByUserId], references: [id])
  reviewedByStaff StaffUser?          @relation("TopupReviewedBy", fields: [reviewedByStaffId], references: [id])
  walletEntry     SellerWalletEntry?  @relation("TopupWalletEntry", fields: [walletEntryId], references: [id])

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("wallet_topup_requests")
}

model SellerWalletEntry {
  id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId            String               @map("seller_id") @db.Uuid
  currency            Currency
  direction           WalletEntryDirection
  // Always positive — `direction` encodes sign. 2dp precision (matches
  // money convention).
  amount              Decimal              @db.Decimal(14, 2)
  // Snapshot of the wallet balance after this entry was applied.
  // Denormalised; useful for the ledger display + audit reconstruction
  // without re-summing the full history.
  runningBalanceAfter Decimal              @map("running_balance_after") @db.Decimal(14, 2)
  // Optional linkage targets.
  linkedOrderId       String?              @map("linked_order_id") @db.Uuid
  linkedRemittanceId  String?              @map("linked_remittance_id") @db.Uuid
  // ADJUSTMENT_* compensates an earlier entry — null otherwise.
  linkedEntryId       String?              @map("linked_entry_id") @db.Uuid
  // Required on ADJUSTMENT_* and REMITTANCE_FX; otherwise null.
  reasonCode          String?              @map("reason_code")
  note                String?              @db.Text
  // Actor for audit.
  actorType           ActorType            @map("actor_type")
  actorId             String?              @map("actor_id") @db.Uuid
  // FX snapshot for cross-currency entries (REMITTANCE_FX). Decimal(18,6)
  // matches the FxRate precision in M16.
  fxRateSnapshot      Decimal?             @map("fx_rate_snapshot") @db.Decimal(18, 6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz

  seller         Seller                @relation(fields: [sellerId], references: [id])
  linkedOrder    Order?                @relation("WalletEntryOrder", fields: [linkedOrderId], references: [id])
  linkedEntry    SellerWalletEntry?    @relation("WalletEntryAdjustment", fields: [linkedEntryId], references: [id])
  adjustments    SellerWalletEntry[]   @relation("WalletEntryAdjustment")
  remittance     Remittance?           @relation(fields: [linkedRemittanceId], references: [id])
  // R3 — set when this entry is the settlement debit for an inbound
  // freight bill (the FK lives on inbound_freight_charges).
  inboundFreight InboundFreightCharge?

  topupRequest WalletTopupRequest? @relation("TopupWalletEntry")

  @@index([sellerId, currency, createdAt])
  // Lets applyEntry find the wallet's LAST entry — and therefore its
  // current balance — with a single index seek instead of sorting the
  // seller's whole history. Ordered on `id` because ids are uuidv7
  // (monotonic) and, unlike createdAt, distinct within one transaction.
  @@index([sellerId, currency, id])
  @@index([linkedOrderId])
  @@index([linkedRemittanceId])
  @@index([linkedEntryId])
  @@map("seller_wallet_entries")
}

model SellerWalletBalance {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  currency    Currency
  // Cached SUM of ledger; recomputed post-commit on every applyEntry.
  balance     Decimal  @default(0) @db.Decimal(14, 2)
  // Snapshot of the most-recently-applied entry to detect lag (rare).
  lastEntryId String?  @map("last_entry_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, currency])
  @@index([sellerId])
  @@map("seller_wallet_balances")
}

// ============================================================================
// Phase 1B — Admin remittance (M23)
// ============================================================================
//
// W-6 (admin-driven, manual reference): Phase 1B remittance is the admin
// entering a bank transfer reference + amount + FX rate snapshot. The row
// links to N ledger entries (typically 2: one REMITTANCE_OUT, one
// REMITTANCE_FX for cross-currency). No bank API integration; that's
// Phase 2.

model Remittance {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId            String   @map("seller_id") @db.Uuid
  // Destination currency (matches seller's bank account currency).
  currency            Currency
  // Amount paid (in destination currency).
  amount              Decimal  @db.Decimal(14, 2)
  // Source currency, source amount — for cross-currency this is the
  // INR side; for same-currency these mirror currency + amount.
  sourceCurrency      Currency @map("source_currency")
  sourceAmount        Decimal  @map("source_amount") @db.Decimal(14, 2)
  // FX rate snapshot used at remittance time. 1 for same-currency.
  fxRateSnapshot      Decimal  @map("fx_rate_snapshot") @db.Decimal(18, 6)
  // Bank account that received the withdrawal. Snapshotted on the seller
  // row in Phase 1A schema; future-proofing for the multi-bank-account
  // refactor.
  bankAccountSnapshot Json     @map("bank_account_snapshot")
  // Bank reference for ops reconciliation. The seller sees this — it is
  // how they match our withdrawal against their own statement.
  bankReference       String   @map("bank_reference")
  /// Which of OUR accounts the money left. Without it a payout is a
  /// wallet debit with no cash behind it, and the bank book cannot be
  /// reconciled against the statement it came from.
  paidFromAccountId   String?  @map("paid_from_account_id") @db.Uuid
  /// Spaces KEY of the transfer screenshot, never a URL (reads are
  /// presigned on demand). Evidence for the seller that the transfer
  /// left our account, and for us when they say it never arrived.
  proofSpacesKey      String?  @map("proof_spaces_key")
  proofMimeType       String?  @map("proof_mime_type")
  // When the bank confirmed the withdrawal (operator enters this).
  paidAt              DateTime @map("paid_at") @db.Timestamptz
  // Audit + ops.
  staffId             String   @map("staff_id") @db.Uuid
  note                String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  seller            Seller               @relation(fields: [sellerId], references: [id])
  paidFromAccount   PlatformBankAccount? @relation(fields: [paidFromAccountId], references: [id])
  staff             StaffUser            @relation("RemittanceStaff", fields: [staffId], references: [id])
  ledgerEntries     SellerWalletEntry[]
  withdrawalRequest WithdrawalRequest?

  @@index([sellerId, paidAt])
  @@index([paidAt])
  @@index([staffId])
  @@map("remittances")
}

enum WithdrawalRequestStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  PAID     @map("paid")
  REJECTED @map("rejected")

  @@map("withdrawal_request_status")
}

enum WithdrawalRequestedBy {
  SELLER @map("seller")
  SYSTEM @map("system")

  @@map("withdrawal_requested_by")
}

/// R2 (revised-plan roadmap) — a seller's (or, later, an auto-withdraw
/// cycle's) REQUEST to withdraw wallet balance. Never itself moves
/// money — `RemittanceService.create()` (the existing admin-manual-
/// withdrawal flow, W-6) remains the sole executor; an admin resolving a
/// request creates the actual Remittance separately and links it here
/// via `linkedRemittanceId`. This preserves "no seller-initiated
/// direct debit" — the wallet ledger is only ever touched by
/// `WalletService.applyEntry`, never by this model.
model WithdrawalRequest {
  id                 String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId           String                  @map("seller_id") @db.Uuid
  currency           Currency
  amountRequested    Decimal                 @map("amount_requested") @db.Decimal(14, 2)
  status             WithdrawalRequestStatus @default(PENDING)
  requestedBy        WithdrawalRequestedBy   @map("requested_by")
  requestedByUserId  String?                 @map("requested_by_user_id") @db.Uuid
  linkedRemittanceId String?                 @unique @map("linked_remittance_id") @db.Uuid
  resolvedByStaffId  String?                 @map("resolved_by_staff_id") @db.Uuid
  resolvedAt         DateTime?               @map("resolved_at") @db.Timestamptz
  rejectionReason    String?                 @map("rejection_reason") @db.Text
  note               String?                 @db.Text
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  seller           Seller      @relation(fields: [sellerId], references: [id])
  requestedByUser  SellerUser? @relation(fields: [requestedByUserId], references: [id])
  linkedRemittance Remittance? @relation(fields: [linkedRemittanceId], references: [id])
  resolvedByStaff  StaffUser?  @relation("WithdrawalRequestResolvedBy", fields: [resolvedByStaffId], references: [id])

  @@index([sellerId, status])
  @@index([status])
  @@index([requestedByUserId])
  @@index([resolvedByStaffId])
  @@map("withdrawal_requests")
}

/// R2b (revised-plan roadmap) — the T_PLUS_N wallet-timing tier's
/// scheduling record. One row per order (at most): created when
/// `OrderDeliveredAccrualListener` sees a seller on the T_PLUS_N tier
/// instead of crediting/debiting immediately. `PendingAccrualSweepService`
/// sweeps `eligibleAt <= now AND processedAt IS NULL` rows and calls the
/// EXACT same `AccrualExecutionService.executeAccrual()` the INSTANT
/// (default) tier calls immediately — only the trigger timing differs;
/// `WalletService.applyEntry` stays the sole ledger writer either way.
model PendingAccrual {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  eligibleAt  DateTime  @map("eligible_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order  Order  @relation(fields: [orderId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([eligibleAt, processedAt])
  @@index([sellerId])
  @@map("pending_accruals")
}

enum TicketType {
  /// Auto-raised by RtoInspectionService when a returned line is
  /// inspected DAMAGED or MISSING. Carries the shipment item + courier
  /// so liability can be argued with the courier or settled with the
  /// seller.
  SCRAP_DAMAGE           @map("scrap_damage")
  /// Raised by a seller about a specific parcel/order ("where is this",
  /// "arrived broken", "wrong item"). Same lifecycle + resolution
  /// mechanics, so ops works ONE queue instead of two.
  SELLER_RAISED_ISSUE    @map("seller_raised_issue")
  /// Auto-raised when an NDR re-attempt could not be confirmed with the
  /// courier. Lives in the SAME queue as the other two deliberately: ops
  /// works one list, and this is the seam the courier-escalation work
  /// hangs its Delhivery conversation off (see the escalation brief).
  COURIER_NDR_ESCALATION @map("courier_ndr_escalation")

  @@map("ticket_type")
}

enum TicketStatus {
  OPEN                        @map("open")
  /// Under discussion with the seller and/or courier.
  NEGOTIATING                 @map("negotiating")
  /// Settled by crediting the seller (writes a SCRAP_REFUND wallet entry).
  RESOLVED_REFUND             @map("resolved_refund")
  /// Settled by physically returning the goods to the seller.
  RESOLVED_RETURNED           @map("resolved_returned")
  /// Seller accepted the loss; no money moves.
  RESOLVED_WRITE_OFF_ACCEPTED @map("resolved_write_off_accepted")
  /// Not a valid claim (e.g. seller-raised issue found unfounded).
  REJECTED                    @map("rejected")

  @@map("ticket_status")
}

/// R7 (revised-plan roadmap) — ONE ticket system for both
/// auto-raised scrap/damage claims and seller-raised parcel issues
/// (`ticketType` discriminates). Before this, a DAMAGED/MISSING RTO line
/// was a silent per-item flag with no counterparty, no money trail and
/// no workflow, and sellers had no way to raise a parcel problem at all.
///
/// `TicketService` is the sole writer; every status change also appends
/// a `TicketEvent`, so the negotiation history is reconstructable rather
/// than collapsed into a current-status column.
model Ticket {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketType     TicketType        @map("ticket_type")
  status         TicketStatus      @default(OPEN)
  sellerId       String            @map("seller_id") @db.Uuid
  // Context. Nullable because a seller-raised issue may reference only
  // an order, while a scrap ticket always has the full chain.
  orderId        String?           @map("order_id") @db.Uuid
  shipmentId     String?           @map("shipment_id") @db.Uuid
  shipmentItemId String?           @map("shipment_item_id") @db.Uuid
  /// Denormalised courier ref for liability attribution/reporting.
  courierCode    String?           @map("courier_code")
  /// For SCRAP_DAMAGE: the inspected condition that triggered the ticket.
  rtoCondition   RtoItemCondition? @map("rto_condition")

  subject     String
  description String? @db.Text

  // Resolution.
  resolutionAmountInr     Decimal? @map("resolution_amount_inr") @db.Decimal(14, 2)
  resolutionWalletEntryId String?  @map("resolution_wallet_entry_id") @db.Uuid
  resolutionNotes         String?  @map("resolution_notes") @db.Text

  // Who raised it (exactly one of these is set in practice).
  openedByStaffId      String?   @map("opened_by_staff_id") @db.Uuid
  openedBySellerUserId String?   @map("opened_by_seller_user_id") @db.Uuid
  resolvedByStaffId    String?   @map("resolved_by_staff_id") @db.Uuid
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seller             Seller             @relation(fields: [sellerId], references: [id])
  order              Order?             @relation(fields: [orderId], references: [id])
  shipment           Shipment?          @relation(fields: [shipmentId], references: [id])
  shipmentItem       ShipmentItem?      @relation(fields: [shipmentItemId], references: [id])
  openedByStaff      StaffUser?         @relation("TicketOpenedByStaff", fields: [openedByStaffId], references: [id])
  openedBySellerUser SellerUser?        @relation("TicketOpenedBySellerUser", fields: [openedBySellerUserId], references: [id])
  resolvedByStaff    StaffUser?         @relation("TicketResolvedByStaff", fields: [resolvedByStaffId], references: [id])
  events             TicketEvent[]
  courierEscalation  CourierEscalation?

  /// Auto-raise idempotency: at most ONE ticket of a given type per
  /// shipment item, so re-inspecting a line (the operator may correct
  /// their judgement) never spawns duplicates. Seller-raised tickets
  /// leave shipmentItemId NULL, and Postgres permits many NULLs in a
  /// unique index, so they are unconstrained.
  @@unique([shipmentItemId, ticketType])
  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([ticketType])
  @@index([orderId])
  @@index([shipmentId])
  @@map("tickets")
}

/// Append-only status history for a Ticket (mirrors `order_events`).
/// Never updated, never deleted.
model TicketEvent {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  note       String?       @db.Text
  actorType  ActorType     @map("actor_type")
  actorId    String?       @map("actor_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

/// R5 — the seller-facing decision surface for "call attempts are
/// exhausted, but we are still holding your stock". Created only when the
/// seller's `inventory.early_reservation_ndr_action` setting is
/// MANUAL_REVIEW; the AUTO_RELEASE path releases immediately and creates
/// nothing.
///
/// Exists as its own row rather than a new OrderStatus because
/// REJECTED_NDR's existing meaning ("terminal, nothing was ever
/// reserved") stays true for every seller who has NOT opted into
/// at-placement booking — overloading the order status would change
/// semantics for them too.
/// Where a seller's plea to ring a declined customer again has got to.
enum ReattemptRequestStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("reattempt_request_status")
}

/// A seller ASKING for one more call on an order the customer refused.
///
/// A request, deliberately not a right. `REJECTED_BY_CUSTOMER` is
/// terminal because the customer said no, and a seller who could put
/// that order back in the queue unaided is a seller who can have someone
/// rung repeatedly after they refused — which in a COD market costs the
/// customer, not just the parcel. So a human stands between "the seller
/// wants another go" and "we ring somebody who declined".
///
/// Contrast the R5b `AWAITING_SELLER_DECISION` pause, where the seller
/// DOES decide unaided: nobody there ever answered the phone, so there
/// is no refusal to override.
model OrderReattemptRequest {
  id                   String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId              String                 @map("order_id") @db.Uuid
  sellerId             String                 @map("seller_id") @db.Uuid
  /// Which team member asked. Null for a request raised by an API key.
  requestedById        String?                @map("requested_by_id") @db.Uuid
  /// The seller's case for calling again — required, because "why" is
  /// the whole basis on which someone approves it.
  reason               String                 @db.Text
  status               ReattemptRequestStatus @default(PENDING)
  /// How many EXTRA calls the approval grants, on top of the seller's
  /// normal cap. Zero on a pending or rejected request.
  ///
  /// Unlocking the queue is not enough on its own: an order that reached
  /// the cap comes back already at 3 of 3, so the very next unanswered
  /// ring re-rejects it and the whole approval is spent on a customer
  /// who was not in. Headroom is granted explicitly and BOUNDED rather
  /// than resetting the count, because the count is the record that this
  /// customer has already refused three times — an order that could be
  /// called indefinitely through repeated requests is the thing this
  /// whole flow exists to prevent.
  extraAttempts        Int                    @default(0) @map("extra_attempts")
  decidedById          String?                @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?              @map("decided_at") @db.Timestamptz
  decisionNote         String?                @map("decision_note") @db.Text
  /// What the order was in when the request was raised. Snapshotted so a
  /// later god-mode move cannot make an old decision unreadable.
  orderStatusAtRequest String                 @map("order_status_at_request")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  order       Order       @relation(fields: [orderId], references: [id])
  seller      Seller      @relation(fields: [sellerId], references: [id])
  requestedBy SellerUser? @relation("ReattemptRequestedBy", fields: [requestedById], references: [id])
  decidedBy   StaffUser?  @relation("ReattemptDecidedBy", fields: [decidedById], references: [id])

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([orderId])
  /// At most one UNDECIDED request per order — migration-managed, Prisma
  /// cannot declare a filtered unique. Partial on purpose: a REJECTED
  /// request must not stop a seller asking again on new grounds.
  @@map("order_reattempt_requests")
}

model EarlyReservationReview {
  id               String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId          String                       @unique @map("order_id") @db.Uuid
  sellerId         String                       @map("seller_id") @db.Uuid
  status           EarlyReservationReviewStatus @default(OPEN)
  /// How many attempt-counting outcomes had been logged when the cap hit.
  attemptCount     Int                          @map("attempt_count")
  /// Units still held across the order's ACTIVE at-placement holds, at
  /// the moment the review was raised (display context for the seller).
  heldQty          Int                          @map("held_qty")
  resolvedAt       DateTime?                    @map("resolved_at") @db.Timestamptz
  resolvedByUserId String?                      @map("resolved_by_user_id") @db.Uuid
  note             String?                      @db.Text
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  order          Order       @relation(fields: [orderId], references: [id])
  seller         Seller      @relation(fields: [sellerId], references: [id])
  resolvedByUser SellerUser? @relation("EarlyReservationReviewResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("early_reservation_reviews")
}

// ============================================================================
// Phase 1B — GST-compliant tax invoices
// ============================================================================
//
// One invoice per delivered order. Auto-generated post-commit when an
// order lands on DELIVERED. The PDF is rendered with pdfkit + uploaded
// to Spaces; the row stores the storage key + a snapshot of the
// invoice payload so a future regeneration produces the SAME content
// regardless of catalog / order-charge edits.
//
// Invoice numbering: SD/INV/<fy>/<6-digit-seq>; per-financial-year
// (April-March) sequence drawn under a Postgres advisory lock so two
// concurrent generations never collide.

model Invoice {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId         String   @unique @map("order_id") @db.Uuid
  sellerId        String   @map("seller_id") @db.Uuid
  invoiceNumber   String   @unique @map("invoice_number")
  invoiceDate     DateTime @default(now()) @map("invoice_date") @db.Timestamptz
  fiscalYear      String   @map("fiscal_year")
  // Money. INR canonical.
  subtotalInr     Decimal  @map("subtotal_inr") @db.Decimal(14, 2)
  gstInr          Decimal  @map("gst_inr") @db.Decimal(14, 2)
  totalInr        Decimal  @map("total_inr") @db.Decimal(14, 2)
  // Immutable snapshot of every payload field used in the PDF so a
  // regeneration produces the exact same content. Includes:
  //   - seller block (GSTIN, name, address)
  //   - buyer block (name, address, GSTIN if any)
  //   - items array (HSN, description, qty, unit price, taxable value)
  //   - tax breakdown (taxable value, GST rate, IGST amount)
  payloadSnapshot Json     @map("payload_snapshot")
  // Spaces.
  pdfStorageKey   String   @map("pdf_storage_key")
  pdfUrl          String?  @map("pdf_url")
  pdfMimeType     String   @default("application/pdf") @map("pdf_mime_type")
  pdfSizeBytes    Int?     @map("pdf_size_bytes")
  // Status — DRAFT (row but no PDF yet) → ISSUED (PDF uploaded).
  // Phase 2: CANCELLED for credit notes.
  status          String   @default("ISSUED")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  order  Order  @relation(fields: [orderId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, invoiceDate])
  @@index([fiscalYear, invoiceNumber])
  @@map("invoices")
}

// ============================================================================
// Phase 1B — Seller team members (RBAC)
// ============================================================================
//
// A `Seller` is the COMPANY (legal entity, bank account, brand, etc.).
// A `SellerUser` is a person at that company who can sign in. The
// existing seller-auth flow looks up credentials on `seller_users.email`
// instead of `sellers.email`; for backward compatibility the original
// password/email columns on `sellers` are retained but unused — to be
// dropped in a Phase-2 migration after the legacy fields are stripped
// from every code path.
//
// One Seller has many SellerUsers. Exactly one is OWNER per Seller
// (enforced at the service layer — the SQL has no partial-unique
// because ownership transfer is a deliberate 2-step in the service).
//
// Roles:
//   OWNER     — everything; only role that can transfer ownership;
//               cannot be removed by other team members
//   ADMIN     — everything except team-management mutations on the
//               OWNER row; can invite/promote/demote other roles
//   OPS       — orders, call-centre view, tracking; no catalog/wallet
//   INVENTORY — catalog, products, variants, images, goods receipts;
//               no orders or wallet
//   FINANCE   — wallet, invoices, remittances view, reports
//   VIEWER    — read-only access to everything visible to the company

enum SellerUserRole {
  OWNER     @map("owner")
  ADMIN     @map("admin")
  OPS       @map("ops")
  INVENTORY @map("inventory")
  FINANCE   @map("finance")
  VIEWER    @map("viewer")

  @@map("seller_user_role")
}

/// A seller asking to move where their money is sent.
///
/// The FIRST set of bank details a seller adds writes straight through —
/// there is nothing to redirect yet, and making a new seller wait would
/// be friction for no gain. Every EDIT after that lands here instead:
/// anyone who got into a seller's account could otherwise point withdrawals
/// at their own bank, and the seller would find out when the money did
/// not arrive.
///
/// While a request is PENDING the live columns on `sellers` are
/// untouched and withdrawals continue to the existing account — a proposed
/// change is not yet a fact, and freezing withdrawals would punish the
/// seller for asking.
///
/// The account number is encrypted with the same cipher as the live
/// column and carries its own masked copy; a request row must never be
/// the place plaintext leaks.
model SellerBankChangeRequest {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId String @map("seller_id") @db.Uuid

  bankName                    String @map("bank_name")
  bankBranchName              String @map("bank_branch_name")
  bankAccountName             String @map("bank_account_name")
  bankAccountNumber           String @map("bank_account_number")
  bankAccountNumberMasked     String @map("bank_account_number_masked")
  bankAccountNumberKeyVersion Int?   @map("bank_account_number_key_version") @db.SmallInt
  bankRoutingNumber           String @map("bank_routing_number")
  bankSwiftCode               String @map("bank_swift_code")

  status BankChangeStatus @default(PENDING)

  requestedBySellerUserId String?  @map("requested_by_seller_user_id") @db.Uuid
  submittedAt             DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  decidedByStaffId String?   @map("decided_by_staff_id") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz
  /// Why it was rejected. The seller reads this verbatim, so it is not
  /// an internal note — without it they resubmit the same thing.
  decisionReason   String?   @map("decision_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seller         Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  requestedBy    SellerUser? @relation("BankChangeRequestedBy", fields: [requestedBySellerUserId], references: [id])
  decidedByStaff StaffUser?  @relation("BankChangeDecidedBy", fields: [decidedByStaffId], references: [id])

  // ONE pending request per seller, as a PARTIAL UNIQUE INDEX rather than
  // a read-then-write check — two concurrent submissions would both read
  // "none pending" under READ COMMITTED and both insert. Declared in the
  // migration: seller_bank_change_requests_one_pending_uq.
  @@index([sellerId, status])
  @@index([status, submittedAt])
  @@map("seller_bank_change_requests")
}

model SellerUser {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId        String         @map("seller_id") @db.Uuid
  email           String         @unique
  emailDisplay    String         @map("email_display")
  passwordHash    String         @map("password_hash")
  fullName        String         @map("full_name")
  role            SellerUserRole
  /// The dynamic role, scoped to this seller. `role` above is the
  /// LEGACY enum, no longer consulted for authorisation.
  roleId          String         @map("role_id") @db.Uuid
  invitedById     String?        @map("invited_by_id") @db.Uuid
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz

  sellerRole                      SellerRoleDefinition           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  seller                          Seller                         @relation(fields: [sellerId], references: [id])
  invitedBy                       SellerUser?                    @relation("SellerUserInvitedBy", fields: [invitedById], references: [id])
  invitedUsers                    SellerUser[]                   @relation("SellerUserInvitedBy")
  invitationsAuthored             SellerUserInvitation[]         @relation("SellerUserInvitedByUser")
  invitationsAccepted             SellerUserInvitation[]         @relation("SellerUserInvitationAccepted")
  refreshTokens                   SellerRefreshToken[]
  topupsSubmitted                 WalletTopupRequest[]           @relation("TopupSubmittedBy")
  passwordResetTokens             SellerPasswordResetToken[]
  emailVerificationTokens         SellerEmailVerificationToken[]
  withdrawalRequestsMade          WithdrawalRequest[]
  ticketsOpened                   Ticket[]                       @relation("TicketOpenedBySellerUser")
  earlyReservationReviewsResolved EarlyReservationReview[]       @relation("EarlyReservationReviewResolvedBy")
  reattemptRequestsRaised         OrderReattemptRequest[]        @relation("ReattemptRequestedBy")
  bankChangesRequested            SellerBankChangeRequest[]      @relation("BankChangeRequestedBy")

  @@index([sellerId])
  @@index([sellerId, role])
  // Declared because it EXISTS: the RBAC migration created it and the
  // schema never carried it, so every `migrate diff` proposed dropping
  // an index the database is actually using. Postgres does not index a
  // foreign key column for you, and `sellerRole` is onDelete: Restrict —
  // so without this, checking whether a role is still in use scans
  // seller_users, and three services filter on roleId besides.
  @@index([roleId])
  @@map("seller_users")
}

/// A role inside ONE seller's account.
///
/// Scoped by `sellerId` — Dhaka Threads' "Manager" has nothing to do
/// with anybody else's, and one company editing a role must never touch
/// another's. Every lookup carries the seller id; the unique key is
/// `(sellerId, key)` rather than `key` alone for exactly that reason.
///
/// The permission KEYS it grants are defined in code
/// (apps/api/src/common/auth/seller-permissions.ts).
model SellerRoleDefinition {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId    String  @map("seller_id") @db.Uuid
  key         String
  name        String
  description String?

  /// One of the six created with every company. Undeletable — deleting
  /// the role a company's whole team holds is not an edit anyone means
  /// to make. Its permissions stay editable (except the owner's).
  isSystem Boolean @default(false) @map("is_system")
  /// Holds every permission implicitly, including ones added later.
  /// Exactly one per seller, uneditable, and its last holder cannot be
  /// moved off it — otherwise a company locks itself out of its own
  /// account with no way back that does not involve us.
  isOwner  Boolean @default(false) @map("is_owner")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  seller      Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  permissions SellerRolePermission[]
  users       SellerUser[]

  @@unique([sellerId, key], map: "seller_roles_seller_id_key_key")
  @@index([sellerId], map: "seller_roles_seller_id_idx")
  @@map("seller_roles")
}

/// One granted permission key. Absence IS the denial — there is no
/// deny-list, because a permission both granted and denied needs a
/// precedence rule nobody remembers.
model SellerRolePermission {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId     String  @map("role_id") @db.Uuid
  permission String
  /// Reserved for future narrowing (a warehouse, a channel). NULL today.
  scope      String?

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz

  role SellerRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission, scope], map: "seller_role_permissions_role_permission_scope_key")
  @@index([roleId], map: "seller_role_permissions_role_id_idx")
  @@map("seller_role_permissions")
}

model SellerUserInvitation {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId     String         @map("seller_id") @db.Uuid
  email        String
  token        String         @unique
  role         SellerUserRole
  invitedById  String         @map("invited_by_id") @db.Uuid
  acceptedById String?        @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz
  usedAt       DateTime?      @map("used_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz

  seller     Seller      @relation(fields: [sellerId], references: [id])
  invitedBy  SellerUser  @relation("SellerUserInvitedByUser", fields: [invitedById], references: [id])
  acceptedBy SellerUser? @relation("SellerUserInvitationAccepted", fields: [acceptedById], references: [id])

  @@index([sellerId])
  @@index([email])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("seller_user_invitations")
}

/// One box being packed at the bench.
///
/// The packer scans the shipping label to OPEN it, scans each product
/// into it, and scans the label again to CLOSE — at which point the
/// parcel is packed. Opening is what makes the claim exclusive; before
/// this existed two packers could pull the same parcel and only collide
/// at the very end.
///
/// `expiresAt` mirrors the pick claim (WMS-5): a box abandoned at the
/// end of a shift must not wedge the order forever.
model PackBox {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId     String        @map("shipment_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  packerStaffId  String        @map("packer_staff_id") @db.Uuid
  status         PackBoxStatus @default(OPEN)
  /// What was scanned to open it — the AWB. Recorded so a mis-scan is
  /// visible afterwards rather than inferred.
  openedWithCode String        @map("opened_with_code")
  openedAt       DateTime      @default(now()) @map("opened_at") @db.Timestamptz
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz
  closedAt       DateTime?     @map("closed_at") @db.Timestamptz
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz
  /// Why the packer abandoned the box. Free text; the reason is
  /// operational evidence, not a state.
  cancelReason   String?       @map("cancel_reason") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  shipment Shipment      @relation(fields: [shipmentId], references: [id])
  order    Order         @relation(fields: [orderId], references: [id])
  packer   StaffUser     @relation("PackBoxPacker", fields: [packerStaffId], references: [id])
  scans    PackBoxScan[]

  @@index([shipmentId])
  @@index([packerStaffId, status])
  @@index([status, expiresAt])
  @@map("pack_boxes")
}

/// One scan into an open box. APPEND-ONLY while the box is open; a
/// cancel discards the whole box rather than editing rows out of it.
///
/// `stockUnitId` is set only for a serialized (STRICT-mode) product,
/// which is what links a specific physical unit to this order. A
/// NORMAL-mode SKU has no per-unit barcode, so the scan records the
/// variant and the code that was read.
model PackBoxScan {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  packBoxId   String   @map("pack_box_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  stockUnitId String?  @map("stock_unit_id") @db.Uuid
  /// Exactly what the scanner read, kept verbatim for dispute review.
  scannedCode String   @map("scanned_code")
  scannedAt   DateTime @default(now()) @map("scanned_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  packBox   PackBox        @relation(fields: [packBoxId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  stockUnit StockUnit?     @relation(fields: [stockUnitId], references: [id])

  @@index([packBoxId])
  @@index([stockUnitId])
  @@map("pack_box_scans")
}

/// Which way a lead wants parcels to travel.
///
/// Skydrop runs BD → India today, so IN_TO_BD and BOTH are demand we
/// cannot serve yet. They are on the form anyway, because a lead asking
/// for the reverse corridor is the most valuable thing we could learn
/// about what to build next — and a form that only offers the direction
/// we already run can never tell us.
enum ShippingDirection {
  /// Seller in Bangladesh, customers in India. What we run.
  BD_TO_IN @map("bd_to_in")
  /// Seller in India, customers in Bangladesh. Not served yet.
  IN_TO_BD @map("in_to_bd")
  BOTH     @map("both")

  @@map("shipping_direction")
}

/// Where a lead sits in the conversation. Deliberately short: a longer
/// pipeline invites guessing at which stage something is in, and the
/// only decision this list has to support is "who do I call next".
enum InviteLeadStatus {
  /// Nobody has looked at it yet.
  NEW       @map("new")
  /// Someone reached out and is waiting to hear back.
  CONTACTED @map("contacted")
  /// Talked to them; they are a real prospect worth onboarding.
  QUALIFIED @map("qualified")
  /// Became a seller. `convertedSellerId` says which one.
  CONVERTED @map("converted")
  /// Not a fit, or never replied. `notes` says why.
  DECLINED  @map("declined")
  /// Obvious junk. Kept rather than deleted so the same address can be
  /// recognised on its next attempt.
  SPAM      @map("spam")

  @@map("invite_lead_status")
}

/// Somebody asking to be let into the beta.
///
/// The landing page used to open a `mailto:` link, which asks the
/// browser to hand off to a mail client — a chooser dialog on desktop,
/// nothing at all on a phone without mail configured. Every lead that
/// did not complete that handoff was simply lost, and we never knew a
/// single one had tried.
///
/// Not a `Seller`, and deliberately unrelated to one: a lead is a
/// stranger who typed their details into a public form. Sellers are
/// invited by staff, and that boundary is what keeps an open endpoint
/// from being able to create anything that can log in.
model InviteLead {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fullName          String             @map("full_name")
  companyName       String             @map("company_name")
  email             String
  /// E.164 where the form could coerce it; kept as typed otherwise, so
  /// a lead is never rejected over a phone format.
  phone             String
  /// A second number in the other country. Sellers working this corridor
  /// routinely carry both a Bangladeshi and an Indian line, and the one
  /// that reaches them depends on which side they are standing on.
  altPhone          String?            @map("alt_phone")
  /// Which way they want parcels to go. Null on leads captured before
  /// the question existed — absence is not the same as BD_TO_IN, and
  /// defaulting it would invent an answer nobody gave.
  shippingDirection ShippingDirection? @map("shipping_direction")
  /// What they sell, in their words.
  productTypes      String?            @map("product_types")
  /// Their own estimate of monthly volume — a free-text bucket, since a
  /// number nobody can hold us to is worth less than the phrase they
  /// chose.
  monthlyOrders     String?            @map("monthly_orders")
  message           String?            @db.Text

  status            InviteLeadStatus @default(NEW)
  /// Internal, never shown to the lead.
  notes             String?          @db.Text
  contactedAt       DateTime?        @map("contacted_at") @db.Timestamptz
  /// Set when the lead becomes a seller, so "where did this account come
  /// from" has an answer a year later.
  convertedSellerId String?          @map("converted_seller_id") @db.Uuid

  /// How many times this address has submitted. A second attempt updates
  /// the row instead of adding a duplicate — someone impatient should
  /// not become two entries in the queue.
  submissionCount Int @default(1) @map("submission_count")

  /// For triaging a flood. Never shown in the list.
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  convertedSeller Seller? @relation("InviteLeadConvertedSeller", fields: [convertedSellerId], references: [id])

  /// One row per address. The upsert key.
  @@unique([email])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("invite_leads")
}

// ─────────────────────────────────────────────────────────────────────
// Treasury — our own money, and whose it is
//
// The seller wallet answers "what do we OWE this seller". It says
// nothing about whether the cash exists, or where. These models answer
// the other half: which account holds what, and how much of it is spoken
// for.
//
// Every balance here is DERIVED by summing entries. No cached running
// balance, deliberately: the wallet cache taught us that a number
// refreshed by whoever remembers is a number that is eventually wrong,
// and money read wrong is worse than money read slowly. Add a cache when
// a report is actually slow, with the entry id as its staleness gate.
// ─────────────────────────────────────────────────────────────────────

/// Whose money a bank entry moves. A seller's cash is held ON BEHALF OF
/// them; capital is ours. The split is what makes "is Bank X solvent for
/// what it holds" answerable at all.
enum BankOwnerKind {
  SELLER  @map("seller")
  CAPITAL @map("capital")

  @@map("bank_owner_kind")
}

/// What a movement WAS. Kept coarse on purpose — a category that names
/// the business event survives a reorganisation of the code that caused
/// it, where a name copied from a service does not.
enum BankEntryType {
  OPENING_BALANCE           @map("opening_balance")
  /// Courier paying us COD they collected.
  COURIER_SETTLEMENT        @map("courier_settlement")
  /// A seller funding their wallet.
  SELLER_TOPUP              @map("seller_topup")
  /// Money leaving to a seller.
  SELLER_WITHDRAWAL         @map("seller_withdrawal")
  TRANSFER_IN               @map("transfer_in")
  TRANSFER_OUT              @map("transfer_out")
  EXPENSE                   @map("expense")
  INVESTMENT_OUT            @map("investment_out")
  INVESTMENT_RETURN         @map("investment_return")
  /// What we keep (or pay) on a cross-currency transfer — the gap
  /// between the rate quoted to the seller and the rate we achieved.
  FX_SPREAD                 @map("fx_spread")
  /// A human correcting the book against a real statement. Posted as an
  /// ENTRY, never as an overwrite, so the correction is visible.
  RECONCILIATION_ADJUSTMENT @map("reconciliation_adjustment")
  /// The cash did not move; whose it is changed. A charge makes some of
  /// a seller's held balance ours; a refund gives it back. Always a
  /// PAIR summing to zero, so the account total still matches the
  /// statement while the ownership split follows the wallet.
  RECLASSIFICATION          @map("reclassification")

  @@map("bank_entry_type")
}

model ExpenseCategory {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String    @unique
  name      String
  /// What belongs here, so two people file the same cost the same way.
  hint      String?   @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  entries BankEntry[]

  @@index([isActive])
  @@map("expense_categories")
}

/// A short-term placement of our own money. Principal out, return in —
/// nothing more, per the founder's scope.
model Investment {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  label        String
  counterparty String
  currency     Currency
  /// Sum of INVESTMENT_OUT entries; the return is whatever comes back.
  placedInr    Decimal   @default(0) @map("placed_inr") @db.Decimal(14, 2)
  returnedInr  Decimal   @default(0) @map("returned_inr") @db.Decimal(14, 2)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  note         String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  entries BankEntry[]

  @@map("investments")
}

/// Two entries and the rate between them.
///
/// Both amounts are recorded because on a cross-currency move they are
/// two independent facts, not one amount and a rate: the rate moves
/// hour to hour, and storing it instead of the received figure means the
/// book disagrees with the statement.
model BankTransfer {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fromAccountId    String   @map("from_account_id") @db.Uuid
  toAccountId      String   @map("to_account_id") @db.Uuid
  amountOut        Decimal  @map("amount_out") @db.Decimal(14, 2)
  currencyOut      Currency @map("currency_out")
  amountIn         Decimal  @map("amount_in") @db.Decimal(14, 2)
  currencyIn       Currency @map("currency_in")
  /// The rate the SELLER was shown. Their sub-balance is credited at
  /// this rate, so they receive what they were promised.
  quotedRate       Decimal? @map("quoted_rate") @db.Decimal(18, 6)
  /// amountIn / amountOut — what the bank actually gave us. The gap
  /// against the quote is ours to keep or to cover.
  achievedRate     Decimal? @map("achieved_rate") @db.Decimal(18, 6)
  /// Whose money moved. Null for a pure capital / liquidity move.
  sellerId         String?  @map("seller_id") @db.Uuid
  reference        String?
  note             String?  @db.Text
  movedAt          DateTime @map("moved_at") @db.Timestamptz
  createdByStaffId String?  @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  fromAccount PlatformBankAccount @relation("BankTransferFrom", fields: [fromAccountId], references: [id])
  toAccount   PlatformBankAccount @relation("BankTransferTo", fields: [toAccountId], references: [id])
  seller      Seller?             @relation(fields: [sellerId], references: [id])
  createdBy   StaffUser?          @relation("BankTransferCreatedBy", fields: [createdByStaffId], references: [id])
  entries     BankEntry[]

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([sellerId])
  @@index([movedAt])
  @@map("bank_transfers")
}

/// One movement of money in one account. APPEND-ONLY.
///
/// `signedAmount` carries its own direction rather than a separate
/// column: a balance is then a SUM, and a sum cannot disagree with
/// itself the way a debit/credit pair plus a direction flag can.
model BankEntry {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId    String        @map("account_id") @db.Uuid
  type         BankEntryType
  /// Negative for money leaving. Always in the ACCOUNT's currency —
  /// never converted, so the column always matches the statement.
  signedAmount Decimal       @map("signed_amount") @db.Decimal(14, 2)
  currency     Currency

  ownerKind BankOwnerKind @map("owner_kind")
  /// Set when ownerKind is SELLER. The pair is what lets one account
  /// report how much of itself is spoken for, and by whom.
  sellerId  String?       @map("seller_id") @db.Uuid

  transferId          String? @map("transfer_id") @db.Uuid
  expenseCategoryId   String? @map("expense_category_id") @db.Uuid
  investmentId        String? @map("investment_id") @db.Uuid
  /// The settlement / topup / withdrawal this entry settles, so a bank
  /// line can be walked back to the business event that caused it.
  settlementId        String? @map("settlement_id") @db.Uuid
  topupRequestId      String? @map("topup_request_id") @db.Uuid
  withdrawalRequestId String? @map("withdrawal_request_id") @db.Uuid

  /// The bank's own reference, so a line can be matched to a statement.
  reference  String?
  note       String?  @db.Text
  occurredAt DateTime @map("occurred_at") @db.Timestamptz

  createdByStaffId String?  @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  account         PlatformBankAccount @relation(fields: [accountId], references: [id])
  // RESTRICT, not the default SET NULL for an optional relation: a
  // seller whose money we are holding must not be deletable, and
  // nulling the link would leave the cash in the account with no owner.
  seller          Seller?             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  transfer        BankTransfer?       @relation(fields: [transferId], references: [id])
  expenseCategory ExpenseCategory?    @relation(fields: [expenseCategoryId], references: [id])
  investment      Investment?         @relation(fields: [investmentId], references: [id])
  createdBy       StaffUser?          @relation("BankEntryCreatedBy", fields: [createdByStaffId], references: [id])

  @@index([accountId, occurredAt])
  @@index([accountId, ownerKind, sellerId])
  @@index([sellerId])
  @@index([type])
  @@index([transferId])
  @@map("bank_entries")
}
