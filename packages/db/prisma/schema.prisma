  @@index([shipmentId, isCurrent])
  @@index([generatedAt])
  @@index([generatedByStaffId])
  @@map("awb_labels")
}

// HYPERTABLE — composite @@id([id, createdAt]); immutable (no updatedAt,
// no deletedAt). webhookId is a real relation to courier_webhooks (single PK);
// inbound FKs to tracking_events are intentionally not modeled because the
// composite PK can't be the target of a single-column FK.
model TrackingEvent {
  id                  String              @default(dbgenerated("uuidv7()")) @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  // Module 10 (TRK-3): the SCAN timestamp the courier (or the manual
  // operator for source=MANUAL_ENTRY) reports. ALL reads + the
  // monotonic-forward transition guard ORDER BY this column, never
  // createdAt — receive-time ≠ scan-time. The hypertable partition
  // stays on createdAt (insertion-time partitioning is the canonical
  // Timescale pattern); ordering ≠ partitioning.
  eventAt             DateTime            @map("event_at") @db.Timestamptz
  shipmentId          String              @map("shipment_id") @db.Uuid
  eventType           TrackingEventType   @map("event_type")
  status              ShipmentStatus
  description         String?             @db.Text
  locationName        String?             @map("location_name")
  locationCity        String?             @map("location_city")
  locationPincode     String?             @map("location_pincode")
  latitude            Decimal?            @db.Decimal(10, 7)
  longitude           Decimal?            @db.Decimal(10, 7)
  source              TrackingEventSource
  courierCode         String?             @map("courier_code")
  rawCourierStatus    String?             @map("raw_courier_status")
  /// Delhivery's NSL (Net Service Level) code for this scan, e.g. EOD-74
  /// ("customer unavailable"). The fine-grained reason UNDER the status:
  /// "Pending" tells you nothing, the NSL tells you why. Delhivery decides
  /// NDR re-attempt eligibility from it, so acting on a failed delivery is
  /// impossible without having kept it.
  nslCode             String?             @map("nsl_code")
  webhookId           String?             @map("webhook_id") @db.Uuid
  actorType           ActorType?          @map("actor_type")
  actorId             String?             @map("actor_id") @db.Uuid
  metadata            Json?
  isVisibleToCustomer Boolean             @default(true) @map("is_visible_to_customer")

  shipment Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  webhook  CourierWebhook? @relation(fields: [webhookId], references: [id])

  @@id([id, createdAt])
  @@index([shipmentId, createdAt(sort: Desc)])
  // Module 10 (TRK-3): scan-time ordering for the public read + the
  // monotonic-forward guard. The (shipmentId, createdAt) index above is
  // kept for insertion-order audit queries.
  @@index([shipmentId, eventAt(sort: Desc)])
  @@index([eventType])
  @@index([source])
  @@index([webhookId])
  // Declared so Prisma owns the partition-column index that TimescaleDB
  // auto-creates via create_hypertable(). Without this, prisma migrate diff
  // sees the DB index as drift and tries to drop it.
  @@index([createdAt])
  @@map("tracking_events")
}

// trackingEventId is intentionally a soft scalar — tracking_events has a
// composite PK and can't be FK'd by a single column.
/// A document a courier PUSHED to us — proof of delivery, a sorter
/// weight image, a reverse-pickup QC photo.
///
/// Distinct from `awb_labels`, which is paperwork WE generate and print.
/// This is evidence THEY produce, and it is the thing that settles a
/// dispute: when a customer says "I never received it" and the courier
/// says delivered, the EPOD decides who absorbs the loss.
///
/// Pushed rather than pulled on purpose. The document service can fetch
/// these on demand, but an EPOD chased six months later may simply be
/// gone from their side — receiving it at the moment it exists is the
/// only way to be sure we still have it when the argument happens.
model CourierDocument {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierCode   String              @map("courier_code")
  docType       CourierDocumentType @map("doc_type")
  awbNumber     String              @map("awb_number")
  /// Null when the AWB reaches us before the shipment does, or for a
  /// consignment that is not ours. The row is kept either way — an
  /// orphan document is evidence we were sent something, and throwing
  /// it away because we could not match it is how evidence disappears.
  shipmentId    String?             @map("shipment_id") @db.Uuid
  /// Their reference for the order or return, as sent.
  externalRef   String?             @map("external_ref")
  /// Where WE put it. Their URLs expire; ours does not.
  spacesKey     String?             @map("spaces_key")
  spacesBucket  String?             @map("spaces_bucket")
  mimeType      String?             @map("mime_type")
  fileSizeBytes Int?                @map("file_size_bytes")
  /// Set when the payload arrived but could not be stored — kept so a
  /// failure is visible rather than looking like nothing was sent.
  storeError    String?             @map("store_error") @db.Text
  webhookId     String?             @map("webhook_id") @db.Uuid
  receivedAt    DateTime            @default(now()) @map("received_at") @db.Timestamptz
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  shipment Shipment?       @relation(fields: [shipmentId], references: [id])
  webhook  CourierWebhook? @relation(fields: [webhookId], references: [id])

  /// One document of each kind per AWB. A courier that re-sends the same
  /// EPOD must not leave two rows and two files in Spaces; the second
  /// arrival updates the first.
  @@unique([courierCode, awbNumber, docType])
  @@index([shipmentId])
  @@index([receivedAt])
  @@map("courier_documents")
}

enum CourierDocumentType {
  /// Electronic proof of delivery.
  EPOD         @map("epod")
  /// Weight/dimension capture from their sorter.
  SORTER_IMAGE @map("sorter_image")
  /// Photos taken during a reverse-pickup quality check.
  QC_IMAGE     @map("qc_image")

  @@map("courier_document_type")
}

model CourierWebhook {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierCode     String        @map("courier_code")
  shipmentId      String?       @map("shipment_id") @db.Uuid
  awbNumber       String?       @map("awb_number")
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz
  remoteIp        String?       @map("remote_ip") @db.Inet
  userAgent       String?       @map("user_agent")
  signature       String?
  signatureValid  Boolean?      @map("signature_valid")
  httpMethod      String        @map("http_method")
  endpoint        String
  headers         Json
  rawBody         String        @map("raw_body") @db.Text
  parsedBody      Json?         @map("parsed_body")
  status          WebhookStatus @default(RECEIVED)
  processedAt     DateTime?     @map("processed_at") @db.Timestamptz
  trackingEventId String?       @map("tracking_event_id") @db.Uuid
  errorMessage    String?       @map("error_message") @db.Text
  errorStack      String?       @map("error_stack") @db.Text
  retryCount      Int           @default(0) @map("retry_count")
  nextRetryAt     DateTime?     @map("next_retry_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  courier          Courier           @relation(fields: [courierCode], references: [code])
  shipment         Shipment?         @relation(fields: [shipmentId], references: [id])
  trackingEvents   TrackingEvent[]
  courierDocuments CourierDocument[]
  deliveryAttempts DeliveryAttempt[]

  @@index([courierCode])
  @@index([shipmentId])
  @@index([awbNumber])
  @@index([receivedAt])
  @@index([status])
  @@index([nextRetryAt, status])
  @@map("courier_webhooks")
}

model DeliveryAttempt {
  id                     String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentId             String                 @map("shipment_id") @db.Uuid
  attemptNumber          Int                    @map("attempt_number")
  attemptedAt            DateTime               @map("attempted_at") @db.Timestamptz
  outcome                DeliveryAttemptOutcome
  failureReason          DeliveryFailureReason? @map("failure_reason")
  failureNotes           String?                @map("failure_notes") @db.Text
  /// The courier's own reason code for THIS attempt (Delhivery NSL, e.g.
  /// EOD-74). `failureReason` is our normalized enum; this is the raw code
  /// the courier will accept back when we ask for a re-attempt. Keeping
  /// both means our normalization can change without losing what they said.
  /// Queried by the NDR flow via a migration-only PARTIAL index
  /// (delivery_attempts_courier_nsl_code_idx, WHERE courier_nsl_code IS NOT
  /// NULL) — most attempts have no code and are never the answer.
  courierNslCode         String?                @map("courier_nsl_code")
  contactedCustomer      Boolean                @default(false) @map("contacted_customer")
  customerResponse       String?                @map("customer_response") @db.Text
  nextAttemptScheduledAt DateTime?              @map("next_attempt_scheduled_at") @db.Timestamptz
  attemptLatitude        Decimal?               @map("attempt_latitude") @db.Decimal(10, 7)
  attemptLongitude       Decimal?               @map("attempt_longitude") @db.Decimal(10, 7)
  agentName              String?                @map("agent_name")
  agentPhone             String?                @map("agent_phone")
  source                 TrackingEventSource
  webhookId              String?                @map("webhook_id") @db.Uuid
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  shipment Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  webhook  CourierWebhook? @relation(fields: [webhookId], references: [id])

  @@unique([shipmentId, attemptNumber])
  @@index([shipmentId])
  @@index([outcome])
  @@index([failureReason])
  @@index([attemptedAt])
  @@index([webhookId])
  @@map("delivery_attempts")
}

// ============================================================
// Layer 8 — Couriers & Pricing (9 tables)
// ============================================================

model Courier {
  id                    String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                  String                 @unique
  name                  String
  displayName           String                 @map("display_name")
  logoSpacesKey         String?                @map("logo_spaces_key")
  integrationType       CourierIntegrationType @map("integration_type")
  apiBaseUrl            String?                @map("api_base_url")
  webhookSecret         String?                @map("webhook_secret")
  supportsCod           Boolean                @default(false) @map("supports_cod")
  supportsPrepaid       Boolean                @default(true) @map("supports_prepaid")
  supportsRto           Boolean                @default(false) @map("supports_rto")
  supportsWeightDispute Boolean                @default(false) @map("supports_weight_dispute")
  maxWeightGrams        Int?                   @map("max_weight_grams")
  maxDeclaredValueInr   Decimal?               @map("max_declared_value_inr") @db.Decimal(12, 2)
  maxCodAmountInr       Decimal?               @map("max_cod_amount_inr") @db.Decimal(12, 2)
  defaultServiceTypes   String[]               @default([]) @map("default_service_types")
  volumetricDivisor     Int                    @default(5000) @map("volumetric_divisor")
  isActive              Boolean                @default(true) @map("is_active")
  priorityForRouting    Int                    @default(100) @map("priority_for_routing")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz

  credentials       CourierCredential[]
  accounts          CourierAccount[]
  rateCardItems     RateCardItem[]
  sellerPricing     SellerPricing[]
  zoneMatrixEntries ZoneMatrixEntry[]
  shipments         Shipment[]
  webhooks          CourierWebhook[]
  manifests         Manifest[]

  @@index([isActive])
  @@index([priorityForRouting])
  @@index([deletedAt])
  @@map("couriers")
}

model CourierCredential {
  id                   String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierId            String                @map("courier_id") @db.Uuid
  environment          CredentialEnvironment
  encryptedPayload     String                @map("encrypted_payload") @db.Text
  encryptionKeyVersion Int                   @map("encryption_key_version")
  fieldNames           String[]              @default([]) @map("field_names")
  isActive             Boolean               @default(true) @map("is_active")
  expiresAt            DateTime?             @map("expires_at") @db.Timestamptz
  lastUsedAt           DateTime?             @map("last_used_at") @db.Timestamptz
  lastTestedAt         DateTime?             @map("last_tested_at") @db.Timestamptz
  lastTestResult       String?               @map("last_test_result") @db.Text
  createdByStaffId     String?               @map("created_by_staff_id") @db.Uuid
  notes                String?               @db.Text
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz

  courier        Courier         @relation(fields: [courierId], references: [id])
  createdByStaff StaffUser?      @relation("CourierCredentialCreatedBy", fields: [createdByStaffId], references: [id])
  // R1 (revised-plan roadmap): a credential now belongs to at most one
  // CourierAccount (the account owns the 1:1 FK via credentialId).
  // The old @@unique([courierId, environment, isActive]) — "at most
  // one active credential per courier+environment, platform-wide" — is
  // DELIBERATELY REMOVED here: multiple simultaneously-active
  // credentials per (courier, environment) is now the intended state,
  // one per CourierAccount. "Exactly one DEFAULT account per
  // (courier, environment)" is enforced on CourierAccount instead
  // (partial unique index courier_accounts_default_uq, migration-only
  // — same pattern as call_queue_entries_open_order_uq).
  courierAccount CourierAccount?

  @@index([courierId])
  @@index([environment])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdByStaffId])
  @@map("courier_credentials")
}

/// R1 (revised-plan roadmap) — a labeled courier account: Skydrop can
/// hold multiple accounts with the same courier (e.g. three Delhivery
/// accounts), each with its own credential. `SellerCourierAccountLink`
/// assigns sellers to accounts with a distribution weight; sellers
/// with no explicit link route to the courier+environment's DEFAULT
/// account (today's single-account behavior, preserved unchanged).
model CourierAccount {
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierId          String                @map("courier_id") @db.Uuid
  environment        CredentialEnvironment
  label              String
  credentialId       String                @unique @map("credential_id") @db.Uuid
  isDefault          Boolean               @default(false) @map("is_default")
  /// The warehouse name this account sends as `pickup_location.name`.
  /// Registered per ACCOUNT at Delhivery and matched exactly, so two
  /// accounts shipping from the same physical building still each need
  /// their own registration and may hold different names. NULL falls
  /// back to the global `courier.delhivery_pickup_location` setting,
  /// which is what a single-account setup uses.
  pickupLocationName String?               @map("pickup_location_name")
  isActive           Boolean               @default(true) @map("is_active")
  createdByStaffId   String?               @map("created_by_staff_id") @db.Uuid
  notes              String?               @db.Text
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?             @map("deleted_at") @db.Timestamptz

  courier         Courier                    @relation(fields: [courierId], references: [id])
  credential      CourierCredential          @relation(fields: [credentialId], references: [id])
  createdByStaff  StaffUser?                 @relation("CourierAccountCreatedBy", fields: [createdByStaffId], references: [id])
  sellerLinks     SellerCourierAccountLink[]
  shipments       Shipment[]
  settlements     CourierSettlement[]
  courierWaybills CourierWaybill[]
  bankAccounts    PlatformBankAccount[]

  // Exactly one DEFAULT active account per (courier_id, environment) —
  // partial unique index courier_accounts_default_uq
  // (WHERE is_default AND deleted_at IS NULL), migration-managed.
  @@index([courierId, environment])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdByStaffId])
  @@map("courier_accounts")
}

/// R1 — assigns a seller to a CourierAccount with a distribution
/// weight (a seller linked to two accounts with weights 70/30 gets
/// ~70%/~30% of their parcels routed to each). A seller with NO
/// active link for a given courier+environment routes to that
/// courier+environment's DEFAULT CourierAccount.
model SellerCourierAccountLink {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId           String   @map("seller_id") @db.Uuid
  courierAccountId   String   @map("courier_account_id") @db.Uuid
  distributionWeight Int      @default(100) @map("distribution_weight")
  isActive           Boolean  @default(true) @map("is_active")
  createdByStaffId   String?  @map("created_by_staff_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seller         Seller         @relation(fields: [sellerId], references: [id])
  courierAccount CourierAccount @relation(fields: [courierAccountId], references: [id])
  createdByStaff StaffUser?     @relation("SellerCourierAccountLinkCreatedBy", fields: [createdByStaffId], references: [id])

  @@unique([sellerId, courierAccountId])
  @@index([sellerId])
  @@index([courierAccountId])
  @@map("seller_courier_account_links")
}

model RateCard {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code             String    @unique
  name             String
  description      String?   @db.Text
  isDefault        Boolean   @default(false) @map("is_default")
  isActive         Boolean   @default(true) @map("is_active")
  effectiveFrom    DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo      DateTime? @map("effective_to") @db.Timestamptz
  currency         Currency  @default(INR)
  createdByStaffId String?   @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  createdByStaff StaffUser?      @relation("RateCardCreatedBy", fields: [createdByStaffId], references: [id])
  items          RateCardItem[]
  sellerPricing  SellerPricing[]
  surcharges     SurchargeRule[]
  orderCharges   OrderCharge[]

  @@index([isDefault])
  @@index([isActive])
  @@index([effectiveFrom, effectiveTo])
  @@index([deletedAt])
  @@index([createdByStaffId])
  @@map("rate_cards")
}

model RateCardItem {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  rateCardId          String   @map("rate_card_id") @db.Uuid
  courierId           String   @map("courier_id") @db.Uuid
  serviceType         String   @map("service_type")
  zone                String
  weightSlabFromGrams Int      @map("weight_slab_from_grams")
  weightSlabToGrams   Int      @map("weight_slab_to_grams")
  baseChargeInr       Decimal  @map("base_charge_inr") @db.Decimal(12, 2)
  perKgChargeInr      Decimal? @map("per_kg_charge_inr") @db.Decimal(10, 2)
  costToSkydropInr    Decimal? @map("cost_to_skydrop_inr") @db.Decimal(12, 2)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  courier  Courier  @relation(fields: [courierId], references: [id])

  @@unique([rateCardId, courierId, serviceType, zone, weightSlabFromGrams])
  @@index([rateCardId, courierId])
  @@index([zone])
  @@index([weightSlabFromGrams, weightSlabToGrams])
  @@index([isActive])
  @@map("rate_card_items")
}

model SellerPricing {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId          String    @map("seller_id") @db.Uuid
  rateCardId        String    @map("rate_card_id") @db.Uuid
  courierId         String?   @map("courier_id") @db.Uuid
  discountPercent   Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  codFeePercent     Decimal?  @map("cod_fee_percent") @db.Decimal(5, 2)
  effectiveFrom     DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz
  isActive          Boolean   @default(true) @map("is_active")
  notes             String?   @db.Text
  approvedByStaffId String?   @map("approved_by_staff_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  seller          Seller     @relation(fields: [sellerId], references: [id])
  rateCard        RateCard   @relation(fields: [rateCardId], references: [id])
  courier         Courier?   @relation(fields: [courierId], references: [id])
  approvedByStaff StaffUser? @relation("SellerPricingApprovedBy", fields: [approvedByStaffId], references: [id])

  @@index([sellerId, isActive])
  @@index([rateCardId])
  @@index([effectiveFrom, effectiveTo])
  @@index([deletedAt])
  @@index([courierId])
  @@index([approvedByStaffId])
  @@map("seller_pricing")
}

model ZoneMatrixEntry {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courierId  String      @map("courier_id") @db.Uuid
  originArea ServiceArea @map("origin_area")
  destArea   ServiceArea @map("dest_area")
  zone       String
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  courier Courier @relation(fields: [courierId], references: [id])

  @@unique([courierId, originArea, destArea])
  @@index([courierId])
  @@index([zone])
  @@map("zone_matrix_entries")
}

model SurchargeRule {
  id                         String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  rateCardId                 String                     @map("rate_card_id") @db.Uuid
  type                       SurchargeType
  name                       String
  computationMethod          SurchargeComputationMethod @map("computation_method")
  flatAmountInr              Decimal?                   @map("flat_amount_inr") @db.Decimal(12, 2)
  percentage                 Decimal?                   @db.Decimal(5, 2)
  minAmountInr               Decimal?                   @map("min_amount_inr") @db.Decimal(12, 2)
  maxAmountInr               Decimal?                   @map("max_amount_inr") @db.Decimal(12, 2)
  baseField                  SurchargeBaseField?        @map("base_field")
  appliesOnlyIfPaymentMode   PaymentMode?               @map("applies_only_if_payment_mode")
  appliesOnlyForServiceAreas ServiceArea[]              @default([]) @map("applies_only_for_service_areas")
  isVisibleToSeller          Boolean                    @default(true) @map("is_visible_to_seller")
  displayOrder               Int                        @default(0) @map("display_order")
  isActive                   Boolean                    @default(true) @map("is_active")
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                  DateTime?                  @map("deleted_at") @db.Timestamptz

  rateCard     RateCard      @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  orderCharges OrderCharge[]

  @@index([rateCardId])
  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
  @@map("surcharge_rules")
}

model FxRate {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fromCurrency      Currency     @map("from_currency")
  toCurrency        Currency     @map("to_currency")
  rate              Decimal      @db.Decimal(12, 6)
  source            FxRateSource
  sourceUrl         String?      @map("source_url")
  fetchedAt         DateTime     @default(now()) @map("fetched_at") @db.Timestamptz
  isManualOverride  Boolean      @default(false) @map("is_manual_override")
  overrideByStaffId String?      @map("override_by_staff_id") @db.Uuid
  overrideReason    String?      @map("override_reason") @db.Text
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  overrideBy StaffUser? @relation("FxRateOverrideBy", fields: [overrideByStaffId], references: [id])

  @@unique([fromCurrency, toCurrency])
  @@index([overrideByStaffId])
  @@map("fx_rates")
}

// Phase 1B — append-only history of every rate change. One row per
// FxRate set/update. Lets the reports + audit views show the full
// timeline of how a (from, to) rate has moved over time.
model FxRateHistory {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fromCurrency     Currency     @map("from_currency")
  toCurrency       Currency     @map("to_currency")
  rate             Decimal      @db.Decimal(12, 6)
  previousRate     Decimal?     @map("previous_rate") @db.Decimal(12, 6)
  source           FxRateSource
  isManualOverride Boolean      @default(false) @map("is_manual_override")
  changedByStaffId String?      @map("changed_by_staff_id") @db.Uuid
  changeReason     String?      @map("change_reason") @db.Text
  recordedAt       DateTime     @default(now()) @map("recorded_at") @db.Timestamptz

  changedBy StaffUser? @relation("FxRateHistoryChangedBy", fields: [changedByStaffId], references: [id])

  @@index([fromCurrency, toCurrency, recordedAt])
  @@index([changedByStaffId])
  @@map("fx_rate_history")
}

model OrderCharge {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  shipmentId         String?           @map("shipment_id") @db.Uuid
  type               ChargeType
  amountInr          Decimal           @map("amount_inr") @db.Decimal(12, 2)
  isTaxable          Boolean           @default(false) @map("is_taxable")
  taxRate            Decimal?          @map("tax_rate") @db.Decimal(5, 2)
  taxAmountInr       Decimal?          @map("tax_amount_inr") @db.Decimal(12, 2)
  totalAmountInr     Decimal           @map("total_amount_inr") @db.Decimal(12, 2)
  description        String?           @db.Text
  displayOrder       Int               @default(0) @map("display_order")
  isVisibleToSeller  Boolean           @default(true) @map("is_visible_to_seller")
  rateCardId         String?           @map("rate_card_id") @db.Uuid
  surchargeRuleId    String?           @map("surcharge_rule_id") @db.Uuid
  computationContext Json?             @map("computation_context")
  status             OrderChargeStatus @default(ESTIMATED)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz

  order         Order          @relation(fields: [orderId], references: [id])
  shipment      Shipment?      @relation(fields: [shipmentId], references: [id])
  rateCard      RateCard?      @relation(fields: [rateCardId], references: [id])
  surchargeRule SurchargeRule? @relation(fields: [surchargeRuleId], references: [id])

  @@index([orderId])
  @@index([shipmentId])
  @@index([type])
  @@index([status])
  @@index([rateCardId])
  @@index([surchargeRuleId])
  @@index([deletedAt])
  @@map("order_charges")
}

