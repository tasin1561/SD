  STRICT @map("strict")

  @@map("inventory_mode")
}

/// R4 — a serialized unit's physical lifecycle. Note the absent states:
/// no RESERVED (reservations are quantity-grained, never unit-grained)
/// and no DELIVERED (delivery is stock-neutral per TRK-7 and nothing in
/// the codebase would drive that transition — a dispatched unit stays
/// DISPATCHED until it either stays gone or comes back as an RTO, and
/// the discrepancy report ages long-DISPATCHED units instead of
/// pretending a delivery scan exists).
/// The life of one physical box at the pack bench.
///
/// OPEN is the exclusive claim: a packer may hold at most one, and a
/// parcel may be in at most one, both enforced by partial unique
/// indexes rather than by application checks — ten packers working in
/// parallel is exactly the case a read-then-write guard gets wrong.
enum PackBoxStatus {
  OPEN      @map("open")
  CLOSED    @map("closed")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")

  @@map("pack_box_status")
}

