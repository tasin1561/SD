// ============================================================
// Layer 4 — Inventory & WMS (9 tables: spec lists 7 but counts paired
// header/lines tables as one — we materialize all 9)
// ============================================================

model StockBatch {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId        String      @map("seller_id") @db.Uuid
  variantId       String      @map("variant_id") @db.Uuid
  warehouseId     String      @map("warehouse_id") @db.Uuid
  batchCode       String      @map("batch_code")
  sellerBatchRef  String?     @map("seller_batch_ref")
  manufacturedAt  DateTime?   @map("manufactured_at") @db.Timestamptz
  expiresAt       DateTime?   @map("expires_at") @db.Timestamptz
  unitCostInr     Decimal?    @map("unit_cost_inr") @db.Decimal(12, 2)
  unitCostBdt     Decimal?    @map("unit_cost_bdt") @db.Decimal(12, 2)
  status          BatchStatus @default(ACTIVE)
  initialQty      Int         @map("initial_qty")
  receivedAt      DateTime    @map("received_at") @db.Timestamptz
  receivedById    String?     @map("received_by_id") @db.Uuid
  receivingNoteId String?     @map("receiving_note_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz

  seller            Seller             @relation(fields: [sellerId], references: [id])
  variant           ProductVariant     @relation(fields: [variantId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  receivedBy        StaffUser?         @relation("StockBatchReceivedBy", fields: [receivedById], references: [id])
  receivingNote     GoodsReceipt?      @relation(fields: [receivingNoteId], references: [id])
  stockLevels       StockLevel[]
  stockMovements    StockMovement[]
  reservations      StockReservation[]
  cycleCountItems   CycleCountItem[]
  goodsReceiptLines GoodsReceiptLine[]

  @@unique([sellerId, batchCode])
  @@index([sellerId, variantId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([expiresAt])
  @@index([status])
  @@index([deletedAt])
  @@index([receivedById])
  @@index([receivingNoteId])
  @@map("stock_batches")
}

// Hard delete: zero out and prune. No deletedAt.
model StockLevel {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
