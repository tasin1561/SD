// ============================================================
// Layer 6 — Call Center (3 tables)
// ============================================================

model CallQueueEntry {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Module 7: NOT a hard unique — locked decision #2 requires a NEW
  // queue entry per re-attempt while the prior is COMPLETED. The
  // "at most one OPEN entry per order" invariant is a PARTIAL unique
  // index (call_queue_entries_open_order_uq, WHERE status IN
  // ('pending','assigned')) — migration-managed, Prisma can't declare a
  // filtered unique. See migration 20260518_… + phase-1a-debt.
  orderId           String              @map("order_id") @db.Uuid
  assignedAgentId   String?             @map("assigned_agent_id") @db.Uuid
  assignedAt        DateTime?           @map("assigned_at") @db.Timestamptz
  assignmentMethod  AssignmentMethod    @default(AUTO_ROUND_ROBIN) @map("assignment_method")
  previousAgentIds  String[]            @default([]) @map("previous_agent_ids") @db.Uuid
  priority          Int                 @default(100)
  status            CallQueueStatus     @default(PENDING)
  availableAt       DateTime            @default(now()) @map("available_at") @db.Timestamptz
  scheduledAttempts Int                 @default(0) @map("scheduled_attempts")
  maxAttempts       Int                 @default(3) @map("max_attempts")
  closedAt          DateTime?           @map("closed_at") @db.Timestamptz
  closureReason     QueueClosureReason? @map("closure_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  order         Order                @relation(fields: [orderId], references: [id])
  assignedAgent StaffUser?           @relation("CallQueueAssignedAgent", fields: [assignedAgentId], references: [id])
  attempts      CallAttempt[]
  holds         CallAssignmentHold[]

  @@index([assignedAgentId, status])
  @@index([status, availableAt, priority])
  @@index([orderId])
  @@index([closureReason])
  @@map("call_queue_entries")
}

// Immutable — only createdAt (no updatedAt, no deletedAt).
model CallAttempt {
  id                    String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  queueEntryId          String      @map("queue_entry_id") @db.Uuid
  orderId               String      @map("order_id") @db.Uuid
  agentId               String      @map("agent_id") @db.Uuid
  startedAt             DateTime    @map("started_at") @db.Timestamptz
  endedAt               DateTime?   @map("ended_at") @db.Timestamptz
  durationSeconds       Int?        @map("duration_seconds")
  phoneE164             String      @map("phone_e164")
  outcome               CallOutcome
  outcomeNotes          String?     @map("outcome_notes") @db.Text
  customerSaidName      String?     @map("customer_said_name")
  customerSaidAddress   String?     @map("customer_said_address") @db.Text
  customerVerifiedItems Boolean?    @map("customer_verified_items")
  rescheduledFor        DateTime?   @map("rescheduled_for") @db.Timestamptz
  rescheduledReason     String?     @map("rescheduled_reason")
  flaggedAsSuspicious   Boolean     @default(false) @map("flagged_as_suspicious")
  suspicionReason       String?     @map("suspicion_reason") @db.Text
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz

  queueEntry       CallQueueEntry    @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  order            Order             @relation(fields: [orderId], references: [id])
  agent            StaffUser         @relation(fields: [agentId], references: [id])
  notificationLogs NotificationLog[]

  @@index([queueEntryId])
  @@index([orderId])
  @@index([agentId, startedAt])
  @@index([outcome])
  @@index([startedAt])
  @@index([flaggedAsSuspicious])
  @@map("call_attempts")
}

/// How an agent's hold on a queue entry ended. Evaluation data: a
/// COMPLETED hold is work done, an EXPIRED or ABANDONED one is a
/// customer who waited for nothing.
enum CallHoldOutcome {
  /// The agent logged a call outcome — the hold did its job.
  COMPLETED    @map("completed")
  /// The agent handed it back deliberately, without calling.
  RELEASED     @map("released")
  /// CC-7: held past the assignment timeout without acting.
  EXPIRED      @map("expired")
  /// The presence sweep found the agent was not at the desk at all.
  AGENT_ABSENT @map("agent_absent")
  /// A supervisor moved it to somebody else.
  REASSIGNED   @map("reassigned")

  @@map("call_hold_outcome")
}

/// One agent's hold on one queue entry, from pull to resolution.
///
/// APPEND-ONLY, and deliberately its own table rather than columns on
/// `call_queue_entries`: an entry is pulled many times over its life, so
/// a single row could only ever remember the last agent to touch it —
/// which is exactly the history worth keeping. Written once at pull with
/// no end, closed once when the hold resolves.
///
/// This is the evaluation record: who was holding, for how long, and
/// whether a customer got a call out of it.
model CallAssignmentHold {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  queueEntryId String           @map("queue_entry_id") @db.Uuid
  orderId      String           @map("order_id") @db.Uuid
  agentId      String           @map("agent_id") @db.Uuid
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime?        @map("ended_at") @db.Timestamptz
  /// Null while the hold is open.
  outcome      CallHoldOutcome?
  /// Stored rather than derived: the arithmetic is trivial but every
  /// report would otherwise repeat it, and a report that computes its
  /// own duration is a report that can disagree with the next one.
  heldSeconds  Int?             @map("held_seconds")
  /// The attempt logged against this hold, when there was one.
  attemptId    String?          @map("attempt_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  queueEntry CallQueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  agent      StaffUser      @relation("CallHoldAgent", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, startedAt])
  @@index([queueEntryId])
  /// The open-hold lookup: closing a hold finds it by (entry, still open).
  @@index([queueEntryId, endedAt])
  @@index([outcome, startedAt])
  @@map("call_assignment_holds")
}

model AgentCallSettings {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  agentId             String    @unique @map("agent_id") @db.Uuid
  // Module 7 (locked decision 10a): reused as the concurrent-assignment
  // cap; default migrated 20 → 1.
  maxActiveCalls      Int       @default(1) @map("max_active_calls")
  // Default FALSE: an agent who is logged in is not necessarily at
  // their desk, and a queue that hands work to an empty chair holds the
  // customer's order hostage. Presence is claimed, never assumed.
  isAvailable         Boolean   @default(false) @map("is_available")
  /// Last time this agent proved they were AT the desk — a foreground
  /// station tab or an action taken. `isAvailable` alone is a boolean
  /// that cannot go stale on its own: an agent who marks available and
  /// walks away keeps claiming orders forever, because the station's
  /// auto-advance needs no human present. The presence sweep reads this
  /// and stands them down.
  lastSeenAt          DateTime? @map("last_seen_at") @db.Timestamptz
  workingHoursStart   String    @default("09:00") @map("working_hours_start")
  workingHoursEnd     String    @default("18:00") @map("working_hours_end")
  workingDays         Int[]     @default([1, 2, 3, 4, 5, 6]) @map("working_days")
  timezone            String    @default("Asia/Kolkata")
  languages           String[]  @default(["en", "hi"])
  canHandleHighRisk   Boolean   @default(false) @map("can_handle_high_risk")
  canHandleHighValue  Boolean   @default(false) @map("can_handle_high_value")
  totalCallsToday     Int       @default(0) @map("total_calls_today")
  confirmedTodayCount Int       @default(0) @map("confirmed_today_count")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  agent StaffUser @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
  /// The presence sweep's predicate: available agents ordered by how
  /// long ago they were last seen.
  @@index([isAvailable, lastSeenAt], map: "agent_call_settings_available_last_seen_idx")
  @@index([agentId])
  @@map("agent_call_settings")
}

// ============================================================
// Layer 7 — Shipments & Tracking (7 tables)
// ============================================================

// courierCode is a string ref to couriers.code (Layer 8); promoted to
// @relation in the Layer 8 commit.
model Shipment {
  id                     String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  shipmentNumber         String           @unique @map("shipment_number")
  courierCode            String           @map("courier_code")
  awbNumber              String?          @unique @map("awb_number")
  courierShipmentId      String?          @map("courier_shipment_id")
  serviceType            String?          @map("service_type")
  originWarehouseId      String           @map("origin_warehouse_id") @db.Uuid
  destRecipientName      String           @map("dest_recipient_name")
  destRecipientPhoneE164 String           @map("dest_recipient_phone_e164")
  destAddressLine1       String           @map("dest_address_line1")
  destAddressLine2       String?          @map("dest_address_line2")
  destLandmark           String?          @map("dest_landmark")
  destCity               String           @map("dest_city")
  destStateProvince      String           @map("dest_state_province")
  destPostalCode         String           @map("dest_postal_code")
  destCountryCode        String           @default("IN") @map("dest_country_code") @db.Char(2)
  totalWeightGrams       Int              @map("total_weight_grams")
  declaredWeightGrams    Int?             @map("declared_weight_grams")
  actualWeightGrams      Int?             @map("actual_weight_grams")
  lengthCm               Decimal?         @map("length_cm") @db.Decimal(6, 2)
  widthCm                Decimal?         @map("width_cm") @db.Decimal(6, 2)
  heightCm               Decimal?         @map("height_cm") @db.Decimal(6, 2)
  volumetricWeightGrams  Int?             @map("volumetric_weight_grams")
  chargeableWeightGrams  Int?             @map("chargeable_weight_grams")
  packageType            PackageType?     @map("package_type")
  declaredValueInr       Decimal          @map("declared_value_inr") @db.Decimal(12, 2)
  codAmountInr           Decimal?         @map("cod_amount_inr") @db.Decimal(12, 2)
  status                 ShipmentStatus   @default(CREATED)
  awbGeneratedAt         DateTime?        @map("awb_generated_at") @db.Timestamptz
  pickedUpByCourierAt    DateTime?        @map("picked_up_by_courier_at") @db.Timestamptz
  firstScanAt            DateTime?        @map("first_scan_at") @db.Timestamptz
  outForDeliveryAt       DateTime?        @map("out_for_delivery_at") @db.Timestamptz
  deliveredAt            DateTime?        @map("delivered_at") @db.Timestamptz
  rtoInitiatedAt         DateTime?        @map("rto_initiated_at") @db.Timestamptz
  rtoReceivedAt          DateTime?        @map("rto_received_at") @db.Timestamptz
  // R6 (revised-plan roadmap): WHERE the RTO parcel was physically
  // received. Distinct from `originWarehouseId` (where it dispatched
  // from) — a return can legitimately arrive at any warehouse. NULL =
  // not received yet, or received at the origin (pre-R6 shipments), in
  // which case every consumer falls back to `originWarehouseId` and
  // behavior is identical to before R6.
  rtoReceivedWarehouseId String?          @map("rto_received_warehouse_id") @db.Uuid
  expectedDeliveryAt     DateTime?        @map("expected_delivery_at") @db.Timestamptz
  isManualCourier        Boolean          @default(false) @map("is_manual_courier")
  // Module 9 — supersede chain (CUR-7). `supersedesShipmentId` points
  // NEW → OLD (the replacement carries the FK); the OLD shipment reads
  // its replacement via the inverse virtual `supersededBy[0]`.
  // `supersededAt` / `supersedeReason` are set ON the OLD shipment when
  // it is retired (auto-supersede on AWB rejection / non-serviceability
  // / courier failure, or a manual replacement).
  supersedesShipmentId   String?          @map("supersedes_shipment_id") @db.Uuid
  supersededAt           DateTime?        @map("superseded_at") @db.Timestamptz
  supersedeReason        SupersedeReason? @map("supersede_reason")
  podPhotoSpacesKeys     String[]         @default([]) @map("pod_photo_spaces_keys")
  podSignatureSpacesKey  String?          @map("pod_signature_spaces_key")
  podRecipientName       String?          @map("pod_recipient_name")
  hasIssue               Boolean          @default(false) @map("has_issue")
  estimatedCostInr       Decimal?         @map("estimated_cost_inr") @db.Decimal(12, 2)
  /// What the courier ACTUALLY charged for this parcel, once we know.
  /// `estimatedCostInr` is what we assumed at dispatch; margin measured
  /// against an assumption is a hope, so the P&L prefers this and says
  /// how many parcels it could not price rather than filling the gap in.
  actualCourierCostInr   Decimal?         @map("actual_courier_cost_inr") @db.Decimal(12, 2)
  actualCourierCostAt    DateTime?        @map("actual_courier_cost_at") @db.Timestamptz
  /// What the courier charged for carrying it BACK.
  ///
  /// Separate from the forward cost because a return is a separate
  /// commercial event: Delhivery refunds the delivery deduction and
  /// charges an RTO fee instead, so a returned parcel's cost is this
  /// number and NOT this plus the forward one. Folding them together
  /// would count a return twice and make every returns margin look
  /// worse than it is.
  actualRtoCostInr       Decimal?         @map("actual_rto_cost_inr") @db.Decimal(12, 2)
  // Module 8 — warehouse pick/pack operational state. The order status
  // (PENDING_PICK/PICKED/PACKED) is the authoritative lifecycle gate
  // (WMS-9); these track who/when + the pick-timeout CAS token (WMS-5,
  // M7-assignedAt analogue). `manifestId` is the (movable pre-close)
  // DRAFT manifest assignment (WMS-7).
  pickStartedAt          DateTime?        @map("pick_started_at") @db.Timestamptz
  pickStartedByStaffId   String?          @map("pick_started_by_staff_id") @db.Uuid
  pickExpiresAt          DateTime?        @map("pick_expires_at") @db.Timestamptz
  pickCompletedAt        DateTime?        @map("pick_completed_at") @db.Timestamptz
  packCompletedAt        DateTime?        @map("pack_completed_at") @db.Timestamptz
  packedByStaffId        String?          @map("packed_by_staff_id") @db.Uuid
  manifestId             String?          @map("manifest_id") @db.Uuid
  // R1 (revised-plan roadmap): WHICH courier account this shipment was
  // routed through — nullable (pre-R1 shipments and stub-mode/no-
  // account-configured flows have none). Populated by
  // CourierAccountRoutingService at AWB-generation time (not yet wired
  // in this commit — see courier-shared's CourierAccountRoutingService
  // doc comment).
  courierAccountId       String?          @map("courier_account_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?        @map("deleted_at") @db.Timestamptz

  courier              Courier           @relation(fields: [courierCode], references: [code])
  courierAccount       CourierAccount?   @relation(fields: [courierAccountId], references: [id])
  originWarehouse      Warehouse         @relation(fields: [originWarehouseId], references: [id])
  rtoReceivedWarehouse Warehouse?        @relation("ShipmentRtoReceivedWarehouse", fields: [rtoReceivedWarehouseId], references: [id])
  supersedes           Shipment?         @relation("ShipmentSupersedes", fields: [supersedesShipmentId], references: [id])
  supersededBy         Shipment[]        @relation("ShipmentSupersedes")
  pickStartedBy        StaffUser?        @relation("ShipmentPickStartedBy", fields: [pickStartedByStaffId], references: [id])
  packedBy             StaffUser?        @relation("ShipmentPackedBy", fields: [packedByStaffId], references: [id])
  manifest             Manifest?         @relation(fields: [manifestId], references: [id])
  orderShipments       OrderShipment[]
  items                ShipmentItem[]
  packBoxes            PackBox[]
  awbLabels            AwbLabel[]
  trackingEvents       TrackingEvent[]
  courierDocuments     CourierDocument[]
  webhooks             CourierWebhook[]
  deliveryAttempts     DeliveryAttempt[]
  stockMovements       StockMovement[]
  charges              OrderCharge[]
  notificationLogs     NotificationLog[]
  tickets              Ticket[]

  ndrActionRequests NdrActionRequest[]

  @@index([courierCode, status])
  @@index([status, createdAt])
  @@index([destPostalCode])
  @@index([destRecipientPhoneE164])
  @@index([deliveredAt])
  @@index([rtoInitiatedAt])
  @@index([supersedesShipmentId])
  @@index([originWarehouseId])
  @@index([deletedAt])
  // Module 8: pick-queue pull (status + pickStartedAt + FIFO created_at)
  // and the pick-timeout sweep.
  @@index([status, pickStartedAt, createdAt])
  @@index([pickExpiresAt])
  @@index([manifestId])
  @@index([pickStartedByStaffId])
  @@index([packedByStaffId])
  @@index([courierAccountId])
  @@index([rtoReceivedWarehouseId])
  @@map("shipments")
}

model OrderShipment {
