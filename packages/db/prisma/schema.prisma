model NotificationTemplate {
  id                     String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                   String
  name                   String
  description            String?                   @db.Text
  channel                NotificationChannel
  recipientType          NotificationRecipientType @map("recipient_type")
  language               String                    @default("en")
  subject                String?
  bodyTemplate           String                    @map("body_template") @db.Text
  htmlBodyTemplate       String?                   @map("html_body_template") @db.Text
  variables              Json?
  preferredProvider      String?                   @map("preferred_provider")
  isActive               Boolean                   @default(true) @map("is_active")
  version                Int                       @default(1)
  maxPerRecipientPerHour Int?                      @map("max_per_recipient_per_hour")
  maxPerRecipientPerDay  Int?                      @map("max_per_recipient_per_day")
  lastEditedByStaffId    String?                   @map("last_edited_by_staff_id") @db.Uuid
  lastEditedAt           DateTime?                 @map("last_edited_at") @db.Timestamptz
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?                 @map("deleted_at") @db.Timestamptz

  lastEditedByStaff StaffUser?        @relation("NotificationTemplateEditedBy", fields: [lastEditedByStaffId], references: [id])
  logs              NotificationLog[]

  @@unique([code, language])
  @@index([code])
  @@index([channel])
  @@index([recipientType])
  @@index([isActive])
  @@index([deletedAt])
  @@index([lastEditedByStaffId])
  @@map("notification_templates")
}

// recipientId is polymorphic (customer / seller / staff) — no @relation.
model NotificationLog {
  id                   String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  templateId           String?                   @map("template_id") @db.Uuid
  templateCode         String                    @map("template_code")
  templateVersion      Int                       @map("template_version")
  channel              NotificationChannel
  recipientType        NotificationRecipientType @map("recipient_type")
  recipientId          String?                   @map("recipient_id") @db.Uuid
  toEmail              String?                   @map("to_email")
  toPhoneE164          String?                   @map("to_phone_e164")
  toInAppUserId        String?                   @map("to_in_app_user_id") @db.Uuid
  subject              String?
  body                 String                    @db.Text
  htmlBody             String?                   @map("html_body") @db.Text
  variables            Json?
  orderId              String?                   @map("order_id") @db.Uuid
  shipmentId           String?                   @map("shipment_id") @db.Uuid
  callAttemptId        String?                   @map("call_attempt_id") @db.Uuid
  triggerEvent         String?                   @map("trigger_event")
  // Module 11 (NOTIF-2): deterministic per-lifecycle-event idempotency
  // key (e.g., "order_status:<orderId>:<from>:<to>"). Gated by a
  // PARTIAL unique index — see the migration
  // 20260526000000_notifications_eventid_skipped_partial_unique
  // (Prisma cannot express WHERE clauses on unique indexes — same
  // migration-managed pattern as call_queue_entries_open_order_uq).
  // Legacy fire-once call sites (auth/seller-mgmt/inventory/category-
  // proposal) leave this NULL and continue to dedup by hand-coded
  // findFirst; only the M11 fan-out path populates it.
  eventId              String?                   @map("event_id")
  provider             String?
  providerMessageId    String?                   @map("provider_message_id")
  status               NotificationStatus        @default(QUEUED)
  sentAt               DateTime?                 @map("sent_at") @db.Timestamptz
  deliveredAt          DateTime?                 @map("delivered_at") @db.Timestamptz
  failedAt             DateTime?                 @map("failed_at") @db.Timestamptz
  failureCode          String?                   @map("failure_code")
  failureMessage       String?                   @map("failure_message") @db.Text
  costMicros           Int?                      @map("cost_micros")
  attemptNumber        Int                       @default(1) @map("attempt_number")
  parentNotificationId String?                   @map("parent_notification_id") @db.Uuid
  readAt               DateTime?                 @map("read_at") @db.Timestamptz
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz

  template    NotificationTemplate? @relation(fields: [templateId], references: [id])
  order       Order?                @relation(fields: [orderId], references: [id])
  shipment    Shipment?             @relation(fields: [shipmentId], references: [id])
  callAttempt CallAttempt?          @relation(fields: [callAttemptId], references: [id])
  parent      NotificationLog?      @relation("NotificationLogParent", fields: [parentNotificationId], references: [id])
  retries     NotificationLog[]     @relation("NotificationLogParent")

  @@index([recipientType, recipientId])
  @@index([orderId])
  @@index([shipmentId])
  @@index([status])
  @@index([providerMessageId])
  @@index([templateCode, createdAt])
  @@index([createdAt])
  @@index([templateId])
  @@index([callAttemptId])
  @@index([parentNotificationId])
  @@map("notification_logs")
}

model SellerWebhookEndpoint {
  id                          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId                    String    @map("seller_id") @db.Uuid
  url                         String
  secretKey                   String    @map("secret_key")
  previousSecretKey           String?   @map("previous_secret_key")
  previousSecretKeyValidUntil DateTime? @map("previous_secret_key_valid_until") @db.Timestamptz
  subscribedEvents            String[]  @default([]) @map("subscribed_events")
  name                        String?
  description                 String?   @db.Text
  isActive                    Boolean   @default(true) @map("is_active")
  lastSuccessAt               DateTime? @map("last_success_at") @db.Timestamptz
  lastFailureAt               DateTime? @map("last_failure_at") @db.Timestamptz
  consecutiveFailureCount     Int       @default(0) @map("consecutive_failure_count")
  autoDisabledAt              DateTime? @map("auto_disabled_at") @db.Timestamptz
  autoDisabledReason          String?   @map("auto_disabled_reason") @db.Text
  lastTestedAt                DateTime? @map("last_tested_at") @db.Timestamptz
  lastTestStatus              String?   @map("last_test_status")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz

  seller     Seller                    @relation(fields: [sellerId], references: [id])
  deliveries OutboundWebhookDelivery[]

  @@index([sellerId, isActive])
  @@index([isActive])
  @@index([deletedAt])
  @@map("seller_webhook_endpoints")
}

model OutboundWebhookDelivery {
  id               String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  endpointId       String                @map("endpoint_id") @db.Uuid
  eventType        String                @map("event_type")
  eventId          String                @map("event_id") @db.Uuid
  payload          Json
  payloadVersion   String                @default("v1") @map("payload_version")
  attemptNumber    Int                   @default(1) @map("attempt_number")
  maxAttempts      Int                   @default(5) @map("max_attempts")
  httpMethod       String                @default("POST") @map("http_method")
  requestUrl       String                @map("request_url")
  requestHeaders   Json                  @map("request_headers")
  signature        String
  responseStatus   Int?                  @map("response_status")
  responseHeaders  Json?                 @map("response_headers")
  responseBody     String?               @map("response_body") @db.Text
  responseTimeMs   Int?                  @map("response_time_ms")
  status           WebhookDeliveryStatus @default(SCHEDULED)
  errorCode        String?               @map("error_code")
  errorMessage     String?               @map("error_message") @db.Text
  scheduledAt      DateTime              @default(now()) @map("scheduled_at") @db.Timestamptz
  sentAt           DateTime?             @map("sent_at") @db.Timestamptz
  nextRetryAt      DateTime?             @map("next_retry_at") @db.Timestamptz
  parentDeliveryId String?               @map("parent_delivery_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  endpoint SellerWebhookEndpoint     @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  parent   OutboundWebhookDelivery?  @relation("OutboundWebhookDeliveryParent", fields: [parentDeliveryId], references: [id])
  retries  OutboundWebhookDelivery[] @relation("OutboundWebhookDeliveryParent")

  @@unique([endpointId, eventType, eventId, attemptNumber])
  @@index([endpointId, status])
  @@index([status, nextRetryAt])
  @@index([eventType, eventId])
  @@index([scheduledAt])
  @@index([sentAt])
  @@index([parentDeliveryId])
  @@map("outbound_webhook_deliveries")
}

model SystemSetting {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key                 String           @unique
  category            String
  valueType           SettingValueType @map("value_type")
  valueString         String?          @map("value_string") @db.Text
  valueInt            Int?             @map("value_int")
  valueDecimal        Decimal?         @map("value_decimal") @db.Decimal(20, 6)
  valueBoolean        Boolean?         @map("value_boolean")
  valueJson           Json?            @map("value_json")
  valueDate           DateTime?        @map("value_date") @db.Timestamptz
  displayName         String           @map("display_name")
  description         String?          @db.Text
  helpText            String?          @map("help_text") @db.Text
  validationSchema    Json?            @map("validation_schema")
  isEditableByAdmin   Boolean          @default(true) @map("is_editable_by_admin")
  isSensitive         Boolean          @default(false) @map("is_sensitive")
  requiresRestart     Boolean          @default(false) @map("requires_restart")
  // Seller-override caps (Phase-1B settings-resolver mechanism): a key
  // can only receive a SellerSettingOverride row if sellerOverridable
  // is true; the override*Min/Max bounds (only the pair matching the
  // key's valueType is ever populated) are enforced by
  // SettingsResolverService.setOverride at write time, not just in
  // the UI — a seller can never set an override the system didn't
  // explicitly permit and bound.
  sellerOverridable   Boolean          @default(false) @map("seller_overridable")
  overrideMinInt      Int?             @map("override_min_int")
  overrideMaxInt      Int?             @map("override_max_int")
  overrideMinDecimal  Decimal?         @map("override_min_decimal") @db.Decimal(20, 6)
  overrideMaxDecimal  Decimal?         @map("override_max_decimal") @db.Decimal(20, 6)
  lastEditedByStaffId String?          @map("last_edited_by_staff_id") @db.Uuid
  lastEditedAt        DateTime?        @map("last_edited_at") @db.Timestamptz
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  lastEditedByStaff StaffUser? @relation("SystemSettingEditedBy", fields: [lastEditedByStaffId], references: [id])

  @@index([category])
  @@index([lastEditedByStaffId])
  @@map("system_settings")
}

/// Per-seller override of an overridable SystemSetting key (Phase-1B
/// generalized settings mechanism — replaces the pattern of adding a
/// bespoke nullable column to `Seller` for every new per-seller
/// setting). Mirrors SystemSetting's value-column shape exactly so
/// SettingsResolverService can share the same parse/format logic.
/// `SettingsResolverService.setOverride` is the sole writer; reads
/// resolve as `sellerOverride ?? systemDefault` via `.resolve()`.
model SellerSettingOverride {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId     String           @map("seller_id") @db.Uuid
  key          String
  valueType    SettingValueType @map("value_type")
  valueString  String?          @map("value_string") @db.Text
  valueInt     Int?             @map("value_int")
  valueDecimal Decimal?         @map("value_decimal") @db.Decimal(20, 6)
  valueBoolean Boolean?         @map("value_boolean")
  valueJson    Json?            @map("value_json")
  valueDate    DateTime?        @map("value_date") @db.Timestamptz
  setByStaffId String?          @map("set_by_staff_id") @db.Uuid
  note         String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  seller     Seller     @relation(fields: [sellerId], references: [id])
  setByStaff StaffUser? @relation("SellerSettingOverrideSetBy", fields: [setByStaffId], references: [id])

  @@unique([sellerId, key])
  @@index([key])
  @@map("seller_setting_overrides")
}

model SellerNotificationPreference {
  id              String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId        String                     @map("seller_id") @db.Uuid
  category        SellerNotificationCategory
  emailEnabled    Boolean                    @default(true) @map("email_enabled")
  smsEnabled      Boolean                    @default(false) @map("sms_enabled")
  inAppEnabled    Boolean                    @default(true) @map("in_app_enabled")
  webhookEnabled  Boolean                    @default(false) @map("webhook_enabled")
  frequency       NotificationFrequency      @default(IMMEDIATE)
  quietHoursStart String?                    @map("quiet_hours_start")
  quietHoursEnd   String?                    @map("quiet_hours_end")
  timezone        String                     @default("Asia/Dhaka")
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, category])
  @@index([sellerId])
  @@map("seller_notification_preferences")
}

model SellerOnboardingProgress {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sellerId    String               @map("seller_id") @db.Uuid
  stepCode    SellerOnboardingStep @map("step_code")
  isRequired  Boolean              @default(true) @map("is_required")
  completedAt DateTime?            @map("completed_at") @db.Timestamptz
  completedBy OnboardingStepActor? @map("completed_by")
  metadata    Json?
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, stepCode])
  @@index([sellerId])
  @@index([stepCode])
  @@index([completedAt])
  @@map("seller_onboarding_progress")
}

