  email           String    @unique
  emailDisplay    String    @map("email_display")
  passwordHash    String    @map("password_hash")
  role            StaffRole
  /// The dynamic role. `role` above is the LEGACY enum, authoritative
  /// only until the permission guard lands; see staff_roles.
  roleId          String    @map("role_id") @db.Uuid
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  staffRole                  StaffRoleDefinition           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sellersApproved            Seller[]                      @relation("SellerApprovedBy")
  invitesAuthored            SellerInvitation[]            @relation("SellerInvitedBy")
  staffInvitesAuthored       StaffInvitation[]             @relation("StaffInvitedBy")
  staffInvitationsAccepted   StaffInvitation[]             @relation("StaffInvitationAccepted")
  refreshTokens              StaffRefreshToken[]
  passwordResetTokens        StaffPasswordResetToken[]
  emailVerificationTokens    StaffEmailVerificationToken[]
  sellerNotesAuthored        SellerNote[]                  @relation("SellerNoteAuthor")
  auditLogsAsStaff           AuditLog[]                    @relation("AuditLogStaff")
  productImagesUploaded      ProductImage[]                @relation("ProductImageUploadedByStaff")
  stockBatchesReceived       StockBatch[]                  @relation("StockBatchReceivedBy")
  stockAdjustmentsInit       StockAdjustment[]             @relation("StockAdjustmentInitiatedBy")
  stockAdjustmentsApprove    StockAdjustment[]             @relation("StockAdjustmentApprovedBy")
  cycleCountsInitiated       CycleCount[]                  @relation("CycleCountInitiatedBy")
  cycleCountItemsCounted     CycleCountItem[]              @relation("CycleCountItemCountedBy")
  goodsReceiptsReceived      GoodsReceipt[]                @relation("GoodsReceiptReceivedBy")
  goodsReceiptsDispatched    GoodsReceipt[]                @relation("GoodsReceiptDispatchedBy")
  ordersConfirmed            Order[]                       @relation("OrderConfirmedBy")
  ordersCancelled            Order[]                       @relation("OrderCancelledBy")
  bulkUploadsByStaff         BulkOrderUpload[]             @relation("BulkUploadUploadedByStaff")
  callQueueAssigned          CallQueueEntry[]              @relation("CallQueueAssignedAgent")
  callHolds                  CallAssignmentHold[]          @relation("CallHoldAgent")
  reattemptRequestsDecided   OrderReattemptRequest[]       @relation("ReattemptDecidedBy")
  callAttempts               CallAttempt[]
  callSettings               AgentCallSettings?
  awbLabelsGenerated         AwbLabel[]                    @relation("AwbLabelGeneratedBy")
  courierCredentialsCreated  CourierCredential[]           @relation("CourierCredentialCreatedBy")
  rateCardsCreated           RateCard[]                    @relation("RateCardCreatedBy")
  sellerPricingApproved      SellerPricing[]               @relation("SellerPricingApprovedBy")
  fxRatesOverridden          FxRate[]                      @relation("FxRateOverrideBy")
  fxRateHistoryChanges       FxRateHistory[]               @relation("FxRateHistoryChangedBy")
  notificationTemplatesEdit  NotificationTemplate[]        @relation("NotificationTemplateEditedBy")
  courierPickupRequests      CourierPickupRequest[]
  systemSettingsEdited       SystemSetting[]               @relation("SystemSettingEditedBy")
  sellerSettingOverridesSet  SellerSettingOverride[]       @relation("SellerSettingOverrideSetBy")
  courierAccountsCreated     CourierAccount[]              @relation("CourierAccountCreatedBy")
  sellerCourierLinksCreated  SellerCourierAccountLink[]    @relation("SellerCourierAccountLinkCreatedBy")
  shipmentsPickStarted       Shipment[]                    @relation("ShipmentPickStartedBy")
  shipmentsPacked            Shipment[]                    @relation("ShipmentPackedBy")
  packBoxes                  PackBox[]                     @relation("PackBoxPacker")
  shipmentItemsRtoDisposed   ShipmentItem[]                @relation("ShipmentItemRtoDisposedBy")
  manifestsClosed            Manifest[]                    @relation("ManifestClosedBy")
  manifestsHandoffConfirmed  Manifest[]                    @relation("ManifestHandoffConfirmedBy")
  remittancesCreated         Remittance[]                  @relation("RemittanceStaff")
  withdrawalRequestsResolved WithdrawalRequest[]           @relation("WithdrawalRequestResolvedBy")
  ticketsOpened              Ticket[]                      @relation("TicketOpenedByStaff")
  ticketsResolved            Ticket[]                      @relation("TicketResolvedByStaff")
  courierSettlementsRecorded CourierSettlement[]           @relation("CourierSettlementRecordedBy")
  stockUnitsScanned          StockUnit[]                   @relation("StockUnitLastScanBy")
  inboundFreightSettled      InboundFreightCharge[]        @relation("InboundFreightSettledBy")
  binLayoutSnapshotsTaken    BinLayoutSnapshot[]           @relation("BinSnapshotTakenBy")
  topupsReviewed             WalletTopupRequest[]          @relation("TopupReviewedBy")
  binCollapseChallenges      BinCollapseChallenge[]        @relation("BinCollapseChallengeStaff")
  courierModeChallenges      CourierModeChallenge[]        @relation("CourierModeChallengeStaff")
  bankChangesDecided         SellerBankChangeRequest[]     @relation("BankChangeDecidedBy")

  sellerRestrictionsCreated SellerRestriction[] @relation("SellerRestrictionCreatedBy")
  sellerRestrictionsLifted  SellerRestriction[] @relation("SellerRestrictionLiftedBy")
  bankEntriesCreated        BankEntry[]         @relation("BankEntryCreatedBy")
  bankTransfersCreated      BankTransfer[]      @relation("BankTransferCreatedBy")

  @@index([role])
  @@index([deletedAt])
  @@index([roleId], map: "staff_users_role_id_idx")
  @@map("staff_users")
}

/// A named bundle of permissions. DATA, not a type: created, renamed and
/// deleted by an admin holding `rbac.manage`, with no deploy.
///
/// The permission KEYS it grants are defined in code
/// (apps/api/src/common/auth/permissions.ts) because a line of code
/// checks each one; the bundling is what is editable. See that file for
/// why the split falls there.
model StaffRoleDefinition {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable machine key. Seeded roles keep the legacy enum's spelling so
  /// the backfill is a straight join.
  key         String  @unique
  name        String
  description String?

  /// Seeded, and therefore undeletable — deleting the role every
  /// existing staff member holds is not an edit anyone means to make.
  /// Its PERMISSIONS stay editable (except the super-admin's).
  isSystem     Boolean @default(false) @map("is_system")
  /// Holds every permission implicitly, including ones added later by a
  /// future migration. Exactly one role has this, it cannot be edited,
  /// and its last holder cannot be demoted — otherwise an admin can
  /// tick themselves out of the building.
  isSuperAdmin Boolean @default(false) @map("is_super_admin")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  permissions StaffRolePermission[]
  staff       StaffUser[]

  @@map("staff_roles")
}

/// One granted permission key. A row's absence IS the denial — there is
/// no deny-list, because a permission that is both granted and denied
/// has to be resolved by a precedence rule nobody remembers.
model StaffRolePermission {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  /// A `PermissionKey` from the catalogue. Stored as text rather than an
  /// enum so adding a permission is a code change, not a migration; the
  /// guard rejects a key the catalogue does not define.
  permission String

  /// Reserved for per-warehouse / per-seller narrowing ("supervisor of
  /// Delhi, not Mumbai"). NULL means unscoped, which is every row today.
  /// Present now so adding scope later is not a migration of everything.
  scope String?

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz

  role StaffRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission, scope], map: "staff_role_permissions_role_permission_scope_key")
  @@index([roleId], map: "staff_role_permissions_role_id_idx")
  @@map("staff_role_permissions")
}

model Seller {
  id                               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                            String       @unique
  emailDisplay                     String       @map("email_display")
  passwordHash                     String       @map("password_hash")
  companyName                      String       @map("company_name")
  /// Short operations handle derived from companyName — "Menev Store" →
  /// "MSt". Generated once at signup, then owned by STAFF: it appears on
  /// the admin seller page and nowhere in any seller-facing projection,
  /// because a seller renaming their own code would break whatever is
  /// already written on a tote or a manifest. UNIQUE on purpose — a
  /// three-character code collides, and one that identifies two
  /// companies fails exactly when it is being trusted.
  initials                         String?      @unique @db.VarChar(4)
  contactPersonName                String       @map("contact_person_name")
  phone                            String
  whatsapp                         String?
  status                           SellerStatus @default(PENDING)
  approvedAt                       DateTime?    @map("approved_at") @db.Timestamptz
  approvedById                     String?      @map("approved_by_id") @db.Uuid
  /// The six bank columns are ALL-OR-NOTHING, enforced in
  /// `SellerProfileService.updateBankDetails` rather than by the schema:
  /// a new seller legitimately has none of them (adding them is a later
  /// onboarding step), so NOT NULL is wrong, and a CHECK constraint would
  /// refuse the write with a Postgres error nobody can act on instead of
  /// naming the fields that are missing.
  bankName                         String?      @map("bank_name")
  /// The branch the account is held at. Bangladeshi routing is
  /// branch-scoped — the same bank name and account number resolve
  /// differently per branch — so a withdrawal instruction without it is
  /// incomplete.
  bankBranchName                   String?      @map("bank_branch_name")
  bankAccountName                  String?      @map("bank_account_name")
  bankAccountNumber                String?      @map("bank_account_number")
  bankAccountNumberMasked          String?      @map("bank_account_number_masked")
  bankAccountNumberKeyVersion      Int?         @map("bank_account_number_key_version") @db.SmallInt
  bankRoutingNumber                String?      @map("bank_routing_number")
  bankSwiftCode                    String?      @map("bank_swift_code")
  logoStorageKey                   String?      @map("logo_storage_key")
  logoUrl                          String?      @map("logo_url")
  logoMimeType                     String?      @map("logo_mime_type")
  displayCurrency                  Currency     @default(INR) @map("display_currency")
  displayLanguage                  String       @default("en") @map("display_language")
  countryCode                      String       @default("BD") @map("country_code") @db.Char(2)
  /// IANA zone the seller lives in. Auto-withdrawal fires at an hour of
  /// THEIR day; without this "10am" would silently mean 10am in whatever
  /// timezone the server happens to run in.
  timezone                         String       @default("Asia/Dhaka")
  emailVerifiedAt                  DateTime?    @map("email_verified_at") @db.Timestamptz
  lastLoginAt                      DateTime?    @map("last_login_at") @db.Timestamptz
  // Module 5 — inventory: per-seller low-stock threshold default (variant
  // override wins) and a per-seller reservation-TTL override (falls back to
  // ops.stock_reservation_ttl_hours).
  defaultLowStockThreshold         Int?         @map("default_low_stock_threshold")
  reservationTtlHoursOverride      Int?         @map("reservation_ttl_hours_override")
  // Module 7: per-seller override of ops.call_max_attempts_before_ndr.
  // null = fall back to the system default. Effective max =
  // override ?? system_settings.ops.call_max_attempts_before_ndr.
  callMaxAttemptsBeforeNdrOverride Int?         @map("call_max_attempts_before_ndr_override")
  createdAt                        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                        DateTime?    @map("deleted_at") @db.Timestamptz

  approvedBy               StaffUser?                     @relation("SellerApprovedBy", fields: [approvedById], references: [id])
  invitations              SellerInvitation[]
  apiKeys                  SellerApiKey[]
  notes                    SellerNote[]
  auditLogsAsSeller        AuditLog[]                     @relation("AuditLogSeller")
  products                 Product[]
  productVariants          ProductVariant[]
  productImagesUploaded    ProductImage[]                 @relation("ProductImageUploadedBySeller")
  stockBatches             StockBatch[]
  stockLevels              StockLevel[]
  stockMovements           StockMovement[]
  stockReservations        StockReservation[]
  stockAdjustments         StockAdjustment[]
  goodsReceipts            GoodsReceipt[]
  customers                Customer[]
  orders                   Order[]
  bulkOrderUploads         BulkOrderUpload[]              @relation("BulkUploadSeller")
  bulkUploadsTriggered     BulkOrderUpload[]              @relation("BulkUploadUploadedBySeller")
  pricing                  SellerPricing[]
  webhookEndpoints         SellerWebhookEndpoint[]
  notificationPreferences  SellerNotificationPreference[]
  onboardingProgress       SellerOnboardingProgress[]
  sellerCsvMappings        SellerCsvMapping[]
  bulkProductUploads       BulkProductUpload[]
  stockAlertStates         StockAlertState[]
  walletEntries            SellerWalletEntry[]
  walletBalances           SellerWalletBalance[]
  bankEntries              BankEntry[]
  bankTransfers            BankTransfer[]
  remittances              Remittance[]
  withdrawalRequests       WithdrawalRequest[]
  topupRequests            WalletTopupRequest[]
  stagedOrderRows          StagedOrderRow[]
  gstWithholdings          GstWithholding[]
  pendingAccruals          PendingAccrual[]
  tickets                  Ticket[]
  earlyReservationReviews  EarlyReservationReview[]
  reattemptRequests        OrderReattemptRequest[]
  stockUnits               StockUnit[]
  inboundFreightCharges    InboundFreightCharge[]
  invoices                 Invoice[]
  users                    SellerUser[]
  userInvitations          SellerUserInvitation[]
  settingOverrides         SellerSettingOverride[]
  courierAccountLinks      SellerCourierAccountLink[]
  inviteLeads              InviteLead[]                   @relation("InviteLeadConvertedSeller")
  roles                    SellerRoleDefinition[]
  restrictions             SellerRestriction[]
  sellerBankChangeRequests SellerBankChangeRequest[]
  consignments             Consignment[]
  sellerFavouriteVariants  SellerFavouriteVariant[]

  @@index([status])
  @@index([deletedAt])
  @@index([approvedById])
  @@map("sellers")
}

model SellerInvitation {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email       String
  token       String    @unique
  invitedById String    @map("invited_by_id") @db.Uuid
  sellerId    String?   @map("seller_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  invitedBy StaffUser @relation("SellerInvitedBy", fields: [invitedById], references: [id])
  seller    Seller?   @relation(fields: [sellerId], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@index([invitedById])
  @@index([sellerId])
  @@map("seller_invitations")
}

// Phase 1B — admin staff invitation. Mirrors SellerInvitation; carries
// a StaffRole assigned at invite-time (immutable through registration;
// admin can change the role later with audit MEDIUM). Only SUPER_ADMIN
// can invite.
model StaffInvitation {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String
  token        String    @unique
  role         StaffRole
  invitedById  String    @map("invited_by_id") @db.Uuid
  acceptedById String?   @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  usedAt       DateTime? @map("used_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  invitedBy  StaffUser  @relation("StaffInvitedBy", fields: [invitedById], references: [id])
  acceptedBy StaffUser? @relation("StaffInvitationAccepted", fields: [acceptedById], references: [id])

  @@index([email])
  @@index([expiresAt])
  @@index([invitedById])
  @@map("staff_invitations")
}

model StaffRefreshToken {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  staffUserId String    @map("staff_user_id") @db.Uuid
  tokenHash   String    @map("token_hash")
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address") @db.Inet
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("staff_refresh_tokens")
}

