  orderItemId          String            @map("order_item_id") @db.Uuid
  quantity             Int
  skuCode              String            @map("sku_code")
  productName          String            @map("product_name")
  variantLabel         String?           @map("variant_label")
  unitWeightGrams      Int?              @map("unit_weight_grams")
  unitDeclaredValueInr Decimal?          @map("unit_declared_value_inr") @db.Decimal(12, 2)
  unitPriceInr         Decimal?          @map("unit_price_inr") @db.Decimal(12, 2)
  pickedBatchId        String?           @map("picked_batch_id") @db.Uuid
  pickedBinId          String?           @map("picked_bin_id") @db.Uuid
  // Module 8 — RTO per-item inspection (WMS-8). On the line snapshot,
  // matching the pickedBatchId/pickedBinId "operational context on
  // shipment_items" precedent (no separate rto_receipts table).
  rtoCondition         RtoItemCondition? @map("rto_condition")
  rtoDisposition       RtoDisposition?   @map("rto_disposition")
  rtoDisposedByStaffId String?           @map("rto_disposed_by_staff_id") @db.Uuid
  rtoInspectionNotes   String?           @map("rto_inspection_notes") @db.Text
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
